 5300 2BB0 ~                CALL __x80_udiv16
 5301 2BB0 ~                POP  AF
 5302 2BB0 ~                OR   A
 5303 2BB0 ~                RET  Z
 5304 2BB0 ~                JP   __x80_neg_hl
