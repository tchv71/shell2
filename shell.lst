 6798 2C66              __x80_mcpy_db = 0                   ; of them above 16
 6799 2C66              __x80_mcpy_m = 0                    ; the largest up to 16
 6800 2C66              __x80_mcpy_lo = 0                   ; the smallest
 6801 2C66              __x80_mcpy_lb = 0                   ; the smallest above 16
