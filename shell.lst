 5752 2BEB
 5753 2BEB                  IFUSED __x80_mul16
 5754 2BEB              ; ---------------------------------------------------------------------------
 5755 2BEB              ; HL = HL * DE, sixteen bits, wrapping.
 5756 2BEB              ;
 5757 2BEB              ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2BEB              ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2BEB              ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2BEB              ; and ten more for a set one.
 5761 2BEB              ;
 5762 2BEB              ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2BEB              ; an index times the size of an element, a value times a small factor. When it is the
 5764 2BEB              ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2BEB              ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2BEB              ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2BEB              ;
 5768 2BEB              ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2BEB              ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2BEB              ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2BEB              ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2BEB              ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2BEB              ; keep the eight steps from zero.
 5774 2BEB              ;
 5775 2BEB              ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2BEB              ; additions.
 5777 2BEB              ; ---------------------------------------------------------------------------
 5778 2BEB              __x80_mul16:
 5779 2BEB AF               XOR  A
 5780 2BEC B2               OR   D
 5781 2BED CA F6 2B         JP   Z,.small       ; the multiplier fits in a byte
 5782 2BF0 AF               XOR  A
 5783 2BF1 B4               OR   H
 5784 2BF2 C2 FF 2B         JP   NZ,.full
 5785 2BF5 EB               EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2BF6              .small:
 5787 2BF6 44               LD   B,H
 5788 2BF7 4D               LD   C,L            ; BC = multiplicand
 5789 2BF8                  IFNDEF X80_OPT_SPEED
 5790 2BF8 21 00 00         LD   HL,0
 5791 2BFB 7B               LD   A,E
 5792 2BFC C3 09 2C         JP   __x80_mul16_byte
 5793 2BFF              .full:
 5794 2BFF 44               LD   B,H
 5795 2C00 4D               LD   C,L
 5796 2C01 21 00 00         LD   HL,0
 5797 2C04 7A               LD   A,D
 5798 2C05 CD 09 2C         CALL __x80_mul16_byte
 5799 2C08 7B               LD   A,E
 5800 2C09                  ELSE
 5801 2C09 ~                LD   A,E
 5802 2C09 ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2C09 ~            .full:
 5804 2C09 ~                LD   B,H
 5805 2C09 ~                LD   C,L
 5806 2C09 ~                LD   A,D
 5807 2C09 ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2C09 ~                LD   A,E
 5809 2C09 ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2C09                  ENDIF
 5811 2C09                  ENDIF
 5812 2C09
 5813 2C09                  IFUSED __x80_mul16_byte
 5814 2C09              ; HL = HL * 256 + BC * A: eight steps of the above, for the byte in A. What __x80_mul16 falls into,
 5815 2C09              ; and what the compiler calls itself for a word by a byte widened (isel.c, select_muldiv).
 5816 2C09              __x80_mul16_byte:
 5817 2C09                  IFDEF X80_OPT_SIZE
 5818 2C09                  ; -Os: the steps as a loop, 18 bytes for 49. The multiplier's bits go out of A with a 1 in
 5819 2C09                  ; behind them at the bottom; when that 1 comes out, A is zero and the eight are done.
 5820 2C09 37               SCF
 5821 2C0A 8F               ADC  A,A
 5822 2C0B              .s_bit:
 5823 2C0B D2 15 2C         JP   NC,.s_zero
 5824 2C0E 29               ADD  HL,HL
 5825 2C0F 09               ADD  HL,BC
 5826 2C10 87               ADD  A,A
 5827 2C11 C2 0B 2C         JP   NZ,.s_bit
 5828 2C14 C9               RET
 5829 2C15              .s_zero:
 5830 2C15 29               ADD  HL,HL
 5831 2C16 87               ADD  A,A
 5832 2C17 C2 0B 2C         JP   NZ,.s_bit
 5833 2C1A C9               RET
 5834 2C1B                  ELSE
 5835 2C1B ~                ADD  HL,HL
 5836 2C1B ~                ADD  A,A
 5837 2C1B ~                JP   NC,$+4
 5838 2C1B ~                ADD  HL,BC
 5839 2C1B ~            __x80_mul16_b7:             ; the steps for the last seven bits, where __x80_mul16_lead comes in
 5840 2C1B ~                ADD  HL,HL
 5841 2C1B ~                ADD  A,A
 5842 2C1B ~                JP   NC,$+4
 5843 2C1B ~                ADD  HL,BC
 5844 2C1B ~            __x80_mul16_b6:
 5845 2C1B ~                ADD  HL,HL
 5846 2C1B ~                ADD  A,A
 5847 2C1B ~                JP   NC,$+4
 5848 2C1B ~                ADD  HL,BC
 5849 2C1B ~            __x80_mul16_b5:
 5850 2C1B ~                ADD  HL,HL
 5851 2C1B ~                ADD  A,A
 5852 2C1B ~                JP   NC,$+4
 5853 2C1B ~                ADD  HL,BC
 5854 2C1B ~            __x80_mul16_b4:
 5855 2C1B ~                ADD  HL,HL
 5856 2C1B ~                ADD  A,A
 5857 2C1B ~                JP   NC,$+4
 5858 2C1B ~                ADD  HL,BC
 5859 2C1B ~            __x80_mul16_b3:
 5860 2C1B ~                ADD  HL,HL
 5861 2C1B ~                ADD  A,A
 5862 2C1B ~                JP   NC,$+4
 5863 2C1B ~                ADD  HL,BC
 5864 2C1B ~            __x80_mul16_b2:
 5865 2C1B ~                ADD  HL,HL
 5866 2C1B ~                ADD  A,A
 5867 2C1B ~                JP   NC,$+4
 5868 2C1B ~                ADD  HL,BC
 5869 2C1B ~            __x80_mul16_b1:
 5870 2C1B ~                ADD  HL,HL
 5871 2C1B ~                ADD  A,A
 5872 2C1B ~                RET  NC
 5873 2C1B ~                ADD  HL,BC
 5874 2C1B ~                RET
 5875 2C1B                  ENDIF
 5876 2C1B                  ENDIF
