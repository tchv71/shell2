 5742 2BEB ~                LD   C,A
 5743 2BEB ~                SBC  A,A
 5744 2BEB ~                SUB  B
 5745 2BEB ~                LD   B,A                ; BC = -BC
 5746 2BEB ~                LD   A,L
 5747 2BEB ~            .positive:
 5748 2BEB ~                LD   H,B
 5749 2BEB ~                LD   L,C
 5750 2BEB ~                JP   __x80_mul16_lead
