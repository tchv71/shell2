 1957 2ABC ~                LD   (__x80_fpb+2),HL   ; as __x80_fp_load2 leaves them
 1958 2ABC ~                EX   DE,HL
 1959 2ABC ~                LD   (__x80_fpa+2),HL
 1960 2ABC ~                ENDIF
