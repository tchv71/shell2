 1527 2ABC ~                LD   A,D
 1528 2ABC ~                AND  80H
 1529 2ABC ~                LD   (__x80_fps),A
 1530 2ABC ~                LD   A,E
 1531 2ABC ~                OR   80H
 1532 2ABC ~                LD   (__x80_fpa+2),A
 1533 2ABC ~                LD   A,L
 1534 2ABC ~                OR   80H
 1535 2ABC ~                LD   D,A
 1536 2ABC ~                LD   HL,(__x80_fpb)
 1537 2ABC ~                LD   E,H
 1538 2ABC ~                LD   H,L
 1539 2ABC ~                LD   L,0
 1540 2ABC ~                LD   A,C
