 4259 2AC4 ~                CALL __x80_signed_divide
 4260 2AC4 ~                LD   HL,__x80_rt_r
 4261 2AC4 ~                CALL Z,__x80_negate32
 4262 2AC4 ~                JP   __x80_remainder
 4263 2AC4                  ENDIF
