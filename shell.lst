 5286 2BAF                  IFUSED __x80_sdiv16
 5287 2BAF ~
 5288 2BAF ~            ; ---------------------------------------------------------------------------
 5289 2BAF ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 2BAF ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 2BAF ~            ; the sign put back afterwards.
 5292 2BAF ~            ; ---------------------------------------------------------------------------
 5293 2BAF ~            __x80_sdiv16:
 5294 2BAF ~                LD   A,H            ; the quotient is negative when the signs differ
 5295 2BAF ~                XOR  D
 5296 2BAF ~                AND  80H
 5297 2BAF ~                PUSH AF
 5298 2BAF ~                CALL __x80_abs_hl
 5299 2BAF ~                CALL __x80_abs_de
 5300 2BAF ~                CALL __x80_udiv16
 5301 2BAF ~                POP  AF
 5302 2BAF ~                OR   A
 5303 2BAF ~                RET  Z
 5304 2BAF ~                JP   __x80_neg_hl
 5305 2BAF                  ENDIF
 5306 2BAF
 5307 2BAF                  IFUSED __x80_urem16
 5308 2BAF
 5309 2BAF              ; ---------------------------------------------------------------------------
 5310 2BAF              ; HL = HL % DE, unsigned.
 5311 2BAF              ; ---------------------------------------------------------------------------
 5312 2BAF              __x80_urem16:
 5313 2BAF CD B5 2B         CALL __x80_udiv16
 5314 2BB2 62               LD   H,D
 5315 2BB3 6B               LD   L,E
 5316 2BB4 C9               RET
 5317 2BB5                  ENDIF
 5318 2BB5
 5319 2BB5                  IFUSED __x80_udiv16
 5320 2BB5
 5321 2BB5              ; ---------------------------------------------------------------------------
 5322 2BB5              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 2BB5              ;
 5324 2BB5              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 2BB5              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 2BB5              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 2BB5              ; one of 32768 or more, a quotient of 0 or 1.
 5328 2BB5              ;
 5329 2BB5              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 2BB5              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 2BB5              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 2BB5              ; ---------------------------------------------------------------------------
 5333 2BB5              __x80_udiv16:
 5334 2BB5                  IFDEF X80_OPT_SIZE
 5335 2BB5                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 2BB5                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 2BB5                  ; bits go in, the divisor in BC, the count on the stack.
 5338 2BB5 7A               LD   A,D
 5339 2BB6 B3               OR   E
 5340 2BB7 CA E4 2B         JP   Z,.s_zero
 5341 2BBA 42               LD   B,D
 5342 2BBB 4B               LD   C,E
 5343 2BBC EB               EX   DE,HL
 5344 2BBD 21 00 00         LD   HL,0
 5345 2BC0 3E 10            LD   A,16
 5346 2BC2              .s_loop:
 5347 2BC2 F5               PUSH AF
 5348 2BC3 EB               EX   DE,HL
 5349 2BC4 29               ADD  HL,HL              ; the dividend's top bit out, a 0 in for the quotient's bit
 5350 2BC5 EB               EX   DE,HL
 5351 2BC6 7D               LD   A,L                ; and into the remainder, the carry its seventeenth bit
 5352 2BC7 17               RLA
 5353 2BC8 6F               LD   L,A
 5354 2BC9 7C               LD   A,H
 5355 2BCA 17               RLA
 5356 2BCB 67               LD   H,A
 5357 2BCC DA D6 2B         JP   C,.s_take
 5358 2BCF 7D               LD   A,L
 5359 2BD0 91               SUB  C
 5360 2BD1 7C               LD   A,H
 5361 2BD2 98               SBC  A,B
 5362 2BD3 DA DD 2B         JP   C,.s_next          ; below the divisor: a 0
 5363 2BD6              .s_take:
 5364 2BD6 7D               LD   A,L
 5365 2BD7 91               SUB  C
 5366 2BD8 6F               LD   L,A
 5367 2BD9 7C               LD   A,H
 5368 2BDA 98               SBC  A,B
 5369 2BDB 67               LD   H,A
 5370 2BDC 1C               INC  E
 5371 2BDD              .s_next:
 5372 2BDD F1               POP  AF
 5373 2BDE 3D               DEC  A
 5374 2BDF C2 C2 2B         JP   NZ,.s_loop
 5375 2BE2 EB               EX   DE,HL
 5376 2BE3 C9               RET
 5377 2BE4              .s_zero:
 5378 2BE4 21 FF FF         LD   HL,0FFFFH
 5379 2BE7 11 00 00         LD   DE,0
 5380 2BEA C9               RET
 5381 2BEB                  ELSE
 5382 2BEB ~                LD   A,D
 5383 2BEB ~                OR   A
 5384 2BEB ~                JP   NZ,.wide
 5385 2BEB ~                OR   E
 5386 2BEB ~                JP   Z,.by_zero
 5387 2BEB ~                LD   A,H
 5388 2BEB ~                CP   E
 5389 2BEB ~                JP   NC,.two
 5390 2BEB ~                OR   A
 5391 2BEB ~                JP   NZ,.one
 5392 2BEB ~                LD   A,L            ; below the divisor: the dividend is the remainder
 5393 2BEB ~                CP   E
 5394 2BEB ~                JP   C,.below
 5395 2BEB ~            .one:
 5396 2BEB ~                CALL __x80_dsetup8  ; the high byte below the divisor: one pass
 5397 2BEB ~                CALL __x80_dpass8
 5398 2BEB ~                LD   E,H            ; the remainder
 5399 2BEB ~                LD   D,0
 5400 2BEB ~                LD   L,A
 5401 2BEB ~                LD   H,D
 5402 2BEB ~                RET
 5403 2BEB ~            .two:
 5404 2BEB ~                PUSH HL             ; the low byte, for the second pass
 5405 2BEB ~                CALL __x80_dsetup8
 5406 2BEB ~                LD   L,H            ; the high byte alone first
 5407 2BEB ~                LD   H,0
 5408 2BEB ~                CALL __x80_dpass8   ; its quotient in A, the remainder in H
 5409 2BEB ~                LD   L,A
 5410 2BEB ~                EX   (SP),HL        ; that kept; the dividend back
 5411 2BEB ~                LD   A,L
 5412 2BEB ~                POP  HL
 5413 2BEB ~                PUSH HL
 5414 2BEB ~                LD   L,A            ; the remainder and the low byte
 5415 2BEB ~                CALL __x80_dpass8
 5416 2BEB ~                LD   E,H
 5417 2BEB ~                LD   D,0
 5418 2BEB ~                POP  HL
 5419 2BEB ~                LD   H,L            ; the high byte of the quotient
 5420 2BEB ~                LD   L,A
 5421 2BEB ~                RET
 5422 2BEB ~            .below:
 5423 2BEB ~                LD   E,L
 5424 2BEB ~                LD   HL,0
 5425 2BEB ~                RET
 5426 2BEB ~            .wide:
 5427 2BEB ~                JP   M,.big
 5428 2BEB ~                LD   B,D            ; 256..32767: a quotient below 256
 5429 2BEB ~                LD   C,E
 5430 2BEB ~                XOR  A
 5431 2BEB ~                SUB  E
 5432 2BEB ~                LD   E,A
 5433 2BEB ~                LD   A,0
 5434 2BEB ~                SBC  A,D
 5435 2BEB ~                LD   D,A
 5436 2BEB ~                PUSH HL             ; the low byte, for after the pass
 5437 2BEB ~                LD   L,H            ; the high byte, below the divisor
 5438 2BEB ~                LD   H,0
 5439 2BEB ~                ADD  HL,DE          ; as __x80_dpass16 takes a remainder
 5440 2BEB ~                CALL __x80_dpass16
 5441 2BEB ~                POP  DE
 5442 2BEB ~                LD   D,A            ; the quotient
 5443 2BEB ~                LD   A,E            ; the low byte added to the remainder
 5444 2BEB ~                ADD  A,L
 5445 2BEB ~                LD   L,A
 5446 2BEB ~                LD   A,H
 5447 2BEB ~                ADC  A,0
 5448 2BEB ~                LD   H,A
 5449 2BEB ~                JP   C,.up          ; it reached the divisor: one more
 5450 2BEB ~                ADD  HL,BC          ; the remainder as it is
 5451 2BEB ~                EX   DE,HL
 5452 2BEB ~                LD   L,H
 5453 2BEB ~                LD   H,0
 5454 2BEB ~                RET
