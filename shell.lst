 2760 2ABB                  IFUSED __x80_fp_load2
 2761 2ABB ~            ; ---------------------------------------------------------------------------
 2762 2ABB ~            ; fpa = DE:HL, fpb = BC and the word above the operation's return address: for an operation
 2763 2ABB ~            ; that has called this first.
 2764 2ABB ~            ; ---------------------------------------------------------------------------
 2765 2ABB ~            __x80_fp_load2:
