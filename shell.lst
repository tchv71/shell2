 3974 2ABB ~            ; ---------------------------------------------------------------------------
 3975 2ABB ~            ; DE:HL = DE:HL * [SP+2]:BC, the low thirty-two bits.
 3976 2ABB ~            ;
 3977 2ABB ~            ; By halves, since only the low thirty-two bits of the product are wanted:
 3978 2ABB ~            ;
 3979 2ABB ~            ;     a * b = aL*bL + ((aH*bL + aL*bH) << 16)      modulo 2^32
 3980 2ABB ~            ;
 3981 2ABB ~            ; which is one sixteen-by-sixteen multiplication with a thirty-two-bit result, the smaller low
 3982 2ABB ~            ; half the multiplier, and two with a sixteen-bit one -- a high half that is zero, as it is
 3983 2ABB ~            ; whenever a `long` holds an unsigned int's worth, dropping its term altogether, and one that is
 3984 2ABB ~            ; FFFFh, a negative int's, making it a subtraction. z88dk's runtime does the same (l_long_mult).
 3985 2ABB ~            ; The halves wait in rt_a and rt_b, as division's do.
 3986 2ABB ~            ; ---------------------------------------------------------------------------
 3987 2ABB ~            __x80_lmul:
