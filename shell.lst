 5319 2BB6                  IFUSED __x80_udiv16
 5320 2BB6
 5321 2BB6              ; ---------------------------------------------------------------------------
 5322 2BB6              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 2BB6              ;
 5324 2BB6              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 2BB6              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 2BB6              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 2BB6              ; one of 32768 or more, a quotient of 0 or 1.
 5328 2BB6              ;
 5329 2BB6              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 2BB6              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 2BB6              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 2BB6              ; ---------------------------------------------------------------------------
 5333 2BB6              __x80_udiv16:
 5334 2BB6                  IFDEF X80_OPT_SIZE
 5335 2BB6                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 2BB6                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 2BB6                  ; bits go in, the divisor in BC, the count on the stack.
 5338 2BB6 7A               LD   A,D
 5339 2BB7 B3               OR   E
 5340 2BB8 CA E5 2B         JP   Z,.s_zero
 5341 2BBB 42               LD   B,D
 5342 2BBC 4B               LD   C,E
 5343 2BBD EB               EX   DE,HL
 5344 2BBE 21 00 00         LD   HL,0
 5345 2BC1 3E 10            LD   A,16
 5346 2BC3              .s_loop:
 5347 2BC3 F5               PUSH AF
 5348 2BC4 EB               EX   DE,HL
 5349 2BC5 29               ADD  HL,HL              ; the dividend's top bit out, a 0 in for the quotient's bit
 5350 2BC6 EB               EX   DE,HL
 5351 2BC7 7D               LD   A,L                ; and into the remainder, the carry its seventeenth bit
 5352 2BC8 17               RLA
 5353 2BC9 6F               LD   L,A
 5354 2BCA 7C               LD   A,H
 5355 2BCB 17               RLA
 5356 2BCC 67               LD   H,A
 5357 2BCD DA D7 2B         JP   C,.s_take
 5358 2BD0 7D               LD   A,L
 5359 2BD1 91               SUB  C
 5360 2BD2 7C               LD   A,H
 5361 2BD3 98               SBC  A,B
 5362 2BD4 DA DE 2B         JP   C,.s_next          ; below the divisor: a 0
 5363 2BD7              .s_take:
 5364 2BD7 7D               LD   A,L
 5365 2BD8 91               SUB  C
 5366 2BD9 6F               LD   L,A
 5367 2BDA 7C               LD   A,H
 5368 2BDB 98               SBC  A,B
 5369 2BDC 67               LD   H,A
 5370 2BDD 1C               INC  E
 5371 2BDE              .s_next:
 5372 2BDE F1               POP  AF
 5373 2BDF 3D               DEC  A
 5374 2BE0 C2 C3 2B         JP   NZ,.s_loop
 5375 2BE3 EB               EX   DE,HL
 5376 2BE4 C9               RET
 5377 2BE5              .s_zero:
 5378 2BE5 21 FF FF         LD   HL,0FFFFH
 5379 2BE8 11 00 00         LD   DE,0
 5380 2BEB C9               RET
