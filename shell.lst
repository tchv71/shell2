 1427 2ADE
 1428 2ADE              ; ---------------------------------------------------------------------------
 1429 2ADE              ; binary32: float arithmetic, comparison and conversions to and from long.
 1430 2ADE              ;
 1431 2ADE              ; The compiler calls these for every float operation: a float is its bits, an operand like a
 1432 2ADE              ; long -- a in HL (low word) and DE (high word), b in BC (low) and on the stack above the return
 1433 2ADE              ; address (high), left there for the caller to take off -- and the result in HL:DE, a comparison's
 1434 2ADE              ; in A. The algorithms are those of the compiler's C reference implementation of IEEE 754, and the
 1435 2ADE              ; results agree with it bit for bit: one rounding, to the nearest with ties to even; subnormals;
 1436 2ADE              ; infinities; and NaNs that come back quieted, the first operand's when both are, as on the
 1437 2ADE              ; x86.
 1438 2ADE              ;
 1439 2ADE              ; A finite number in the middle of an operation is a sign (in fps), an exponent in BC and a
 1440 2ADE              ; significand of thirty-two bits in DEHL, D the top byte, its leading one at bit 31: twenty-four
 1441 2ADE              ; bits of the result and eight below them, which decide the rounding -- the round bit is bit 7,
 1442 2ADE              ; and whatever was shifted out below bit 0 is kept as a one in bit 0, the sticky bit. Its value is
 1443 2ADE              ; DEHL / 2^31 * 2^(BC - 127), so BC is the biased exponent the result has before rounding.
 1444 2ADE              ; __x80_fp_rpack makes the float of that. The operands wait in fpa and fpb, the bytes as in
 1445 2ADE              ; memory, low first.
 1446 2ADE              ;
 1447 2ADE              ; Not reentrant: an interrupt handler doing float arithmetic while the main program is inside one
 1448 2ADE              ; of these would corrupt it, as with the division of longs.
 1449 2ADE              ; ---------------------------------------------------------------------------
 1450 2ADE
 1451 2ADE                  IFUSED __x80_fsub
 1452 2ADE ~            __x80_fsub:
 1453 2ADE ~                LD   A,80H              ; b's sign flipped: the addition, which follows its first byte
 1454 2ADE ~                JP   __x80_fadd+1
 1455 2ADE                  ENDIF
 1456 2ADE
 1457 2ADE                  IFUSED __x80_fadd
 1458 2ADE ~            ; ---------------------------------------------------------------------------
 1459 2ADE ~            ; DE:HL = a + b. With |a| >= |b| -- swapped if not -- the result has a's sign, and b's
 1460 2ADE ~            ; significand, shifted down to a's exponent, is added to a's or taken from it. A subnormal is
 1461 2ADE ~            ; taken as exponent 1 without the leading one, and comes the same way; a NaN, an infinity and a
 1462 2ADE ~            ; zero b are dealt with before.
 1463 2ADE ~            ; ---------------------------------------------------------------------------
 1464 2ADE ~            __x80_fadd:
 1465 2ADE ~                XOR  A                  ; one byte: __x80_fsub comes in after it
 1466 2ADE ~                LD   (__x80_fpx),A      ; what b's sign is flipped by
 1467 2ADE ~                IFDEF X80_OPT_SIZE
 1468 2ADE ~                CALL __x80_fp_load2
 1469 2ADE ~                ELSE
 1470 2ADE ~                ; Two normal numbers, the common case, without the general way's stores and swap: the low words
 1471 2ADE ~                ; to fpa and fpb, the high words kept in DE and HL, where the exponents and the signs are read;
 1472 2ADE ~                ; the larger's significand left in fpa -- b's put there when b is the larger -- and the
 1473 2ADE ~                ; smaller's in DEHL for the shift. Anything else goes the general way below, everything stored
 1474 2ADE ~                ; as __x80_fp_load2 would have. Some 750 T-states where that took 1290 (ivagor, zx-pk.ru).
 1475 2ADE ~                LD   (__x80_fpa),HL
 1476 2ADE ~                LD   H,B
 1477 2ADE ~                LD   L,C
 1478 2ADE ~                LD   (__x80_fpb),HL
 1479 2ADE ~                LD   HL,2
 1480 2ADE ~                ADD  HL,SP
 1481 2ADE ~                LD   A,(HL)
 1482 2ADE ~                INC  HL
 1483 2ADE ~                LD   H,(HL)
 1484 2ADE ~                LD   L,A                ; b's high word
 1485 2ADE ~                LD   A,E
 1486 2ADE ~                ADD  A,A
 1487 2ADE ~                LD   A,D
 1488 2ADE ~                ADC  A,A
 1489 2ADE ~                LD   C,A                ; a's exponent field
 1490 2ADE ~                INC  A
 1491 2ADE ~                CP   2
 1492 2ADE ~                JP   C,.slow            ; 0 or 255
 1493 2ADE ~                LD   A,L
 1494 2ADE ~                ADD  A,A
 1495 2ADE ~                LD   A,H
 1496 2ADE ~                ADC  A,A
 1497 2ADE ~                LD   B,A                ; b's
 1498 2ADE ~                INC  A
 1499 2ADE ~                CP   2
 1500 2ADE ~                JP   C,.slow
 1501 2ADE ~                LD   A,(__x80_fpx)
 1502 2ADE ~                XOR  H
 1503 2ADE ~                LD   H,A                ; b's sign as it is added
