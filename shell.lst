 5731 2BEB ~            ; __x80_mul16_lead, where the byte widened, FFh above it, took __x80_mul16's sixteen (ivagor,
 5732 2BEB ~            ; zx-pk.ru). -128 is 80h either way. Ahead of __x80_mul16, whose -O2 form falls into
 5733 2BEB ~            ; __x80_mul16_byte -- in between, it made every multiplication go through this.
 5734 2BEB ~            __x80_mul16_sbyte:
 5735 2BEB ~                OR   A
 5736 2BEB ~                JP   P,.positive
 5737 2BEB ~                CPL
 5738 2BEB ~                INC  A
 5739 2BEB ~                LD   L,A
 5740 2BEB ~                XOR  A
