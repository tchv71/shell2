  404 2ABB ~                JP   C,.sub             ; sixty-five bits: above the divisor
  405 2ABB ~                LD   HL,__x80_qa+7      ; the remainder against the divisor, from the top
  406 2ABB ~                LD   DE,__x80_qb+7
  407 2ABB ~                LD   A,(DE)
  408 2ABB ~                CP   (HL)
  409 2ABB ~                JP   NZ,.decided        ; the top bytes nearly always decide
  410 2ABB ~                PUSH BC
  411 2ABB ~                LD   B,7
  412 2ABB ~                DEC  HL
  413 2ABB ~                DEC  DE
  414 2ABB ~                CALL __x80_d_cmp        ; the rest: the carry if below
  415 2ABB ~                POP  BC
  416 2ABB ~                JP   NC,.sub
  417 2ABB ~                OR   A                  ; below the divisor: a 0
  418 2ABB ~                JP   .q
  419 2ABB ~            .decided:
  420 2ABB ~                JP   NC,.q              ; below the divisor: a 0, the carry clear
