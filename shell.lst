 5416 2BEC ~                LD   E,H
 5417 2BEC ~                LD   D,0
 5418 2BEC ~                POP  HL
 5419 2BEC ~                LD   H,L            ; the high byte of the quotient
 5420 2BEC ~                LD   L,A
 5421 2BEC ~                RET
 5422 2BEC ~            .below:
 5423 2BEC ~                LD   E,L
 5424 2BEC ~                LD   HL,0
