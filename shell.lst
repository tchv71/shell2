 5729 2C0E ~            ; HL = BC * A, A a signed byte (isel.c, select_muldiv): a negative one's magnitude by the word
 5730 2C0E ~            ; negated -- the same product, mod 65536 -- so that the steps are those for a byte, from
 5731 2C0E ~            ; __x80_mul16_lead, where the byte widened, FFh above it, took __x80_mul16's sixteen (ivagor,
 5732 2C0E ~            ; zx-pk.ru). -128 is 80h either way. Ahead of __x80_mul16, whose -O2 form falls into
 5733 2C0E ~            ; __x80_mul16_byte -- in between, it made every multiplication go through this.
 5734 2C0E ~            __x80_mul16_sbyte:
 5735 2C0E ~                OR   A
 5736 2C0E ~                JP   P,.positive
 5737 2C0E ~                CPL
 5738 2C0E ~                INC  A
 5739 2C0E ~                LD   L,A
 5740 2C0E ~                XOR  A
 5741 2C0E ~                SUB  C
 5742 2C0E ~                LD   C,A
 5743 2C0E ~                SBC  A,A
 5744 2C0E ~                SUB  B
 5745 2C0E ~                LD   B,A                ; BC = -BC
 5746 2C0E ~                LD   A,L
 5747 2C0E ~            .positive:
 5748 2C0E ~                LD   H,B
 5749 2C0E ~                LD   L,C
 5750 2C0E ~                JP   __x80_mul16_lead
 5751 2C0E                  ENDIF
 5752 2C0E
 5753 2C0E                  IFUSED __x80_mul16
 5754 2C0E              ; ---------------------------------------------------------------------------
 5755 2C0E              ; HL = HL * DE, sixteen bits, wrapping.
 5756 2C0E              ;
 5757 2C0E              ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2C0E              ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2C0E              ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2C0E              ; and ten more for a set one.
 5761 2C0E              ;
 5762 2C0E              ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2C0E              ; an index times the size of an element, a value times a small factor. When it is the
 5764 2C0E              ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2C0E              ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2C0E              ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2C0E              ;
 5768 2C0E              ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2C0E              ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2C0E              ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2C0E              ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2C0E              ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2C0E              ; keep the eight steps from zero.
 5774 2C0E              ;
 5775 2C0E              ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2C0E              ; additions.
 5777 2C0E              ; ---------------------------------------------------------------------------
 5778 2C0E              __x80_mul16:
 5779 2C0E AF               XOR  A
 5780 2C0F B2               OR   D
 5781 2C10 CA 19 2C         JP   Z,.small       ; the multiplier fits in a byte
 5782 2C13 AF               XOR  A
 5783 2C14 B4               OR   H
 5784 2C15 C2 22 2C         JP   NZ,.full
 5785 2C18 EB               EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2C19              .small:
 5787 2C19 44               LD   B,H
 5788 2C1A 4D               LD   C,L            ; BC = multiplicand
 5789 2C1B                  IFNDEF X80_OPT_SPEED
 5790 2C1B 21 00 00         LD   HL,0
 5791 2C1E 7B               LD   A,E
 5792 2C1F C3 2C 2C         JP   __x80_mul16_byte
 5793 2C22              .full:
 5794 2C22 44               LD   B,H
 5795 2C23 4D               LD   C,L
 5796 2C24 21 00 00         LD   HL,0
 5797 2C27 7A               LD   A,D
 5798 2C28 CD 2C 2C         CALL __x80_mul16_byte
 5799 2C2B 7B               LD   A,E
 5800 2C2C                  ELSE
 5801 2C2C ~                LD   A,E
 5802 2C2C ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2C2C ~            .full:
 5804 2C2C ~                LD   B,H
 5805 2C2C ~                LD   C,L
 5806 2C2C ~                LD   A,D
 5807 2C2C ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2C2C ~                LD   A,E
 5809 2C2C ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2C2C                  ENDIF
 5811 2C2C                  ENDIF
 5812 2C2C
 5813 2C2C                  IFUSED __x80_mul16_byte
 5814 2C2C              ; HL = HL * 256 + BC * A: eight steps of the above, for the byte in A. What __x80_mul16 falls into,
 5815 2C2C              ; and what the compiler calls itself for a word by a byte widened (isel.c, select_muldiv).
 5816 2C2C              __x80_mul16_byte:
 5817 2C2C                  IFDEF X80_OPT_SIZE
 5818 2C2C                  ; -Os: the steps as a loop, 18 bytes for 49. The multiplier's bits go out of A with a 1 in
 5819 2C2C                  ; behind them at the bottom; when that 1 comes out, A is zero and the eight are done.
 5820 2C2C 37               SCF
 5821 2C2D 8F               ADC  A,A
 5822 2C2E              .s_bit:
 5823 2C2E D2 38 2C         JP   NC,.s_zero
 5824 2C31 29               ADD  HL,HL
 5825 2C32 09               ADD  HL,BC
 5826 2C33 87               ADD  A,A
 5827 2C34 C2 2E 2C         JP   NZ,.s_bit
 5828 2C37 C9               RET
 5829 2C38              .s_zero:
 5830 2C38 29               ADD  HL,HL
 5831 2C39 87               ADD  A,A
 5832 2C3A C2 2E 2C         JP   NZ,.s_bit
 5833 2C3D C9               RET
 5834 2C3E                  ELSE
 5835 2C3E ~                ADD  HL,HL
 5836 2C3E ~                ADD  A,A
 5837 2C3E ~                JP   NC,$+4
 5838 2C3E ~                ADD  HL,BC
 5839 2C3E ~            __x80_mul16_b7:             ; the steps for the last seven bits, where __x80_mul16_lead comes in
 5840 2C3E ~                ADD  HL,HL
 5841 2C3E ~                ADD  A,A
 5842 2C3E ~                JP   NC,$+4
 5843 2C3E ~                ADD  HL,BC
 5844 2C3E ~            __x80_mul16_b6:
 5845 2C3E ~                ADD  HL,HL
 5846 2C3E ~                ADD  A,A
 5847 2C3E ~                JP   NC,$+4
 5848 2C3E ~                ADD  HL,BC
 5849 2C3E ~            __x80_mul16_b5:
 5850 2C3E ~                ADD  HL,HL
 5851 2C3E ~                ADD  A,A
 5852 2C3E ~                JP   NC,$+4
 5853 2C3E ~                ADD  HL,BC
 5854 2C3E ~            __x80_mul16_b4:
 5855 2C3E ~                ADD  HL,HL
 5856 2C3E ~                ADD  A,A
 5857 2C3E ~                JP   NC,$+4
 5858 2C3E ~                ADD  HL,BC
 5859 2C3E ~            __x80_mul16_b3:
 5860 2C3E ~                ADD  HL,HL
 5861 2C3E ~                ADD  A,A
 5862 2C3E ~                JP   NC,$+4
 5863 2C3E ~                ADD  HL,BC
 5864 2C3E ~            __x80_mul16_b2:
 5865 2C3E ~                ADD  HL,HL
 5866 2C3E ~                ADD  A,A
 5867 2C3E ~                JP   NC,$+4
 5868 2C3E ~                ADD  HL,BC
 5869 2C3E ~            __x80_mul16_b1:
 5870 2C3E ~                ADD  HL,HL
 5871 2C3E ~                ADD  A,A
 5872 2C3E ~                RET  NC
 5873 2C3E ~                ADD  HL,BC
 5874 2C3E ~                RET
 5875 2C3E                  ENDIF
 5876 2C3E                  ENDIF
 5877 2C3E
 5878 2C3E                  IFUSED __x80_mul16_lead
 5879 2C3E ~            ; HL = BC * A, with HL = BC on entry: what __x80_mul16 takes for a byte, and what the compiler calls
 5880 2C3E ~            ; for a word by a byte widened (isel.c, select_muldiv). The multiplier's zeros before its top one
 5881 2C3E ~            ; are passed over, the top one is HL as it came, and the steps for the bits after it are
 5882 2C3E ~            ; __x80_mul16_byte's from there; no one in it at all leaves A zero, and the product is zero.
 5883 2C3E ~            ; -O3 only (__x80_mul16); otherwise the eight steps from zero.
 5884 2C3E ~            __x80_mul16_lead:
 5885 2C3E ~                IFNDEF X80_OPT_SPEED
 5886 2C3E ~                LD   HL,0
 5887 2C3E ~                JP   __x80_mul16_byte
 5888 2C3E ~                ELSE
 5889 2C3E ~                ADD  A,A
 5890 2C3E ~                JP   C,__x80_mul16_b7
 5891 2C3E ~                ADD  A,A
 5892 2C3E ~                JP   C,__x80_mul16_b6
 5893 2C3E ~                ADD  A,A
 5894 2C3E ~                JP   C,__x80_mul16_b5
 5895 2C3E ~                ADD  A,A
 5896 2C3E ~                JP   C,__x80_mul16_b4
 5897 2C3E ~                ADD  A,A
 5898 2C3E ~                JP   C,__x80_mul16_b3
 5899 2C3E ~                ADD  A,A
 5900 2C3E ~                JP   C,__x80_mul16_b2
 5901 2C3E ~                ADD  A,A
 5902 2C3E ~                JP   C,__x80_mul16_b1
 5903 2C3E ~                RET  M                  ; the last bit the top one: HL = BC
 5904 2C3E ~                LD   HL,0               ; no one at all
 5905 2C3E ~                RET
 5906 2C3E ~                ENDIF
 5907 2C3E ~                ASSERT __x80_mul16_byte ; which has the steps
 5908 2C3E                  ENDIF
 5909 2C3E
 5910 2C3E              ; ---------------------------------------------------------------------------
 5911 2C3E              ; L = L shifted by E, the three shifts of a byte, for a count the compiler knows
 5912 2C3E              ; is below eight -- `128 >> (x & 7)` made a byte (ivagor, zx-pk.ru), which was
 5913 2C3E              ; the word shifted by __x80_ashr16. The byte is in L as the word's low byte was,
 5914 2C3E              ; so that A stays free around the call; A and E are spent, BC, D and H are not.
 5915 2C3E              ; A count of zero is tested first, `XOR A / OR E / RET Z`, and the loop's test is
 5916 2C3E              ; at its end: a byte and 17 T-states less than counting down from one more, and 19
 5917 2C3E              ; T-states for no shift at all (ivagor, zx-pk.ru).
 5918 2C3E              ; ---------------------------------------------------------------------------
 5919 2C3E                  IFUSED __x80_shl8
 5920 2C3E ~            __x80_shl8:
 5921 2C3E ~                XOR  A
 5922 2C3E ~                OR   E
 5923 2C3E ~                RET  Z
 5924 2C3E ~                LD   A,L
 5925 2C3E ~            .loop:
 5926 2C3E ~                ADD  A,A
 5927 2C3E ~                DEC  E
 5928 2C3E ~                JP   NZ,.loop
 5929 2C3E ~                LD   L,A
 5930 2C3E ~                RET
 5931 2C3E                  ENDIF
 5932 2C3E
 5933 2C3E                  IFUSED __x80_lshr8
 5934 2C3E ~            __x80_lshr8:
 5935 2C3E ~                XOR  A
 5936 2C3E ~                OR   E
 5937 2C3E ~                RET  Z
 5938 2C3E ~                LD   A,L
 5939 2C3E ~            .loop:
 5940 2C3E ~                OR   A
 5941 2C3E ~                RRA
 5942 2C3E ~                DEC  E
 5943 2C3E ~                JP   NZ,.loop
 5944 2C3E ~                LD   L,A
 5945 2C3E ~                RET
 5946 2C3E                  ENDIF
 5947 2C3E
 5948 2C3E                  IFUSED __x80_ashr8
 5949 2C3E ~            __x80_ashr8:
 5950 2C3E ~                XOR  A
 5951 2C3E ~                OR   E
 5952 2C3E ~                RET  Z
 5953 2C3E ~                LD   A,L
 5954 2C3E ~            .loop:
 5955 2C3E ~                RLCA
 5956 2C3E ~                RRCA
 5957 2C3E ~                RRA
 5958 2C3E ~                DEC  E
 5959 2C3E ~                JP   NZ,.loop
 5960 2C3E ~                LD   L,A
 5961 2C3E ~                RET
 5962 2C3E                  ENDIF
 5963 2C3E
 5964 2C3E                  IFUSED __x80_shl16
 5965 2C3E ~
 5966 2C3E ~            ; ---------------------------------------------------------------------------
 5967 2C3E ~            ; HL = HL shifted by E, the three shifts. A count of sixteen or more is undefined
 5968 2C3E ~            ; in C (6.5.7p3), and what happens here for one from 16 to 255 is that the value
 5969 2C3E ~            ; ends up zero (or all sign bits), which is the same answer the constant case
 5970 2C3E ~            ; gives. D, the count's high byte, is not read: a count that needs it is one of
 5971 2C3E ~            ; those, and testing it would cost every call (ivagor, zx-pk.ru). The count is tested with
 5972 2C3E ~            ; XOR A / OR E rather than LD A,E / OR A: a T-state less on the 8080, four on the
 5973 2C3E ~            ; Vector, which rounds every instruction up to four.
 5974 2C3E ~            ;
 5975 2C3E ~            ; Called only when the count is not known at translation time -- the optimising
 5976 2C3E ~            ; selector expands a constant shift inline, which for the one and two the
 5977 2C3E ~            ; language's own idioms produce is a single instruction. So the cost that matters
 5978 2C3E ~            ; here is the per-bit cost, not the call overhead.
 5979 2C3E ~            ; ---------------------------------------------------------------------------
 5980 2C3E ~            __x80_shl16:
 5981 2C3E ~                XOR  A
 5982 2C3E ~                OR   E
 5983 2C3E ~                RET  Z
 5984 2C3E ~                CP   8
 5985 2C3E ~                JP   NC,.bytes
 5986 2C3E ~            .loop:
 5987 2C3E ~                ADD  HL,HL
 5988 2C3E ~                DEC  A
 5989 2C3E ~                JP   NZ,.loop
 5990 2C3E ~                RET
 5991 2C3E ~            ; Eight or more: the low byte up a whole byte, then the rest of the count on it alone.
 5992 2C3E ~            .bytes:
 5993 2C3E ~                LD   H,L
 5994 2C3E ~                LD   L,0
 5995 2C3E ~                SUB  8
 5996 2C3E ~                RET  Z
 5997 2C3E ~                CP   8
 5998 2C3E ~                JP   NC,.zero
 5999 2C3E ~                LD   B,A
 6000 2C3E ~                LD   A,H
 6001 2C3E ~            .byte:
 6002 2C3E ~                ADD  A,A
 6003 2C3E ~                DEC  B
 6004 2C3E ~                JP   NZ,.byte
 6005 2C3E ~                LD   H,A
 6006 2C3E ~                RET
 6007 2C3E ~            .zero:
 6008 2C3E ~                LD   H,L
 6009 2C3E ~                RET
 6010 2C3E                  ENDIF
 6011 2C3E
 6012 2C3E                  IFUSED __x80_lshr16
 6013 2C3E ~
 6014 2C3E ~            ; The right shifts take the shortest of three ways: a byte at once for a
 6015 2C3E ~            ; count of eight or more, and then the one byte that is left; the low byte alone when the high one
 6016 2C3E ~            ; is zero; and for a count of four to seven, a shift left by eight less the count through A, whose
 6017 2C3E ~            ; top two bytes are the answer -- ADD HL,HL / RLA, 29 T-states a step against 46 to the right.
 6018 2C3E ~            ; The long counts are tested first: they are what a decoder's bit reader shifts by, and where
 6019 2C3E ~            ; the time goes.
 6020 2C3E ~            __x80_lshr16:
 6021 2C3E ~                XOR  A
 6022 2C3E ~                OR   E
 6023 2C3E ~                RET  Z
 6024 2C3E ~                CP   8
 6025 2C3E ~                JP   NC,.bytes
 6026 2C3E ~                LD   B,A
 6027 2C3E ~                INC  H                  ; the high byte zero: A kept (ivagor, zx-pk.ru)
 6028 2C3E ~                DEC  H
 6029 2C3E ~                JP   Z,.low
 6030 2C3E ~                CP   4
 6031 2C3E ~                JP   NC,.left
 6032 2C3E ~            .loop:
 6033 2C3E ~                XOR  A
 6034 2C3E ~                OR   H                  ; and the carry clear, so a zero comes in at the top
 6035 2C3E ~                RRA
 6036 2C3E ~                LD   H,A
 6037 2C3E ~                LD   A,L
 6038 2C3E ~                RRA
 6039 2C3E ~                LD   L,A
 6040 2C3E ~                DEC  B
 6041 2C3E ~                JP   NZ,.loop
 6042 2C3E ~                RET
 6043 2C3E ~            .left:
 6044 2C3E ~                LD   A,8
 6045 2C3E ~                SUB  B
 6046 2C3E ~                LD   B,A
 6047 2C3E ~                XOR  A
 6048 2C3E ~            .left_loop:
 6049 2C3E ~                ADD  HL,HL
 6050 2C3E ~                RLA
 6051 2C3E ~                DEC  B
 6052 2C3E ~                JP   NZ,.left_loop
 6053 2C3E ~                LD   L,H
 6054 2C3E ~                LD   H,A
 6055 2C3E ~                RET
 6056 2C3E ~            .bytes:
 6057 2C3E ~                LD   L,H
 6058 2C3E ~                LD   H,0
 6059 2C3E ~                SUB  8
 6060 2C3E ~                RET  Z
 6061 2C3E ~                CP   8
 6062 2C3E ~                JP   NC,.zero
 6063 2C3E ~                LD   B,A
 6064 2C3E ~            .low:
 6065 2C3E ~                LD   A,L
 6066 2C3E ~            .byte:
 6067 2C3E ~                OR   A
 6068 2C3E ~                RRA
 6069 2C3E ~                DEC  B
 6070 2C3E ~                JP   NZ,.byte
 6071 2C3E ~                LD   L,A
 6072 2C3E ~                RET
 6073 2C3E ~            .zero:
 6074 2C3E ~                LD   L,H
 6075 2C3E ~                RET
 6076 2C3E                  ENDIF
 6077 2C3E
 6078 2C3E                  IFUSED __x80_ashr16
 6079 2C3E ~
 6080 2C3E ~            ; As the logical shift, the sign coming in at the top: a whole byte of it for eight or more, and
 6081 2C3E ~            ; for four to seven the shift left starts with the sign's byte in A.
 6082 2C3E ~            __x80_ashr16:
 6083 2C3E ~                XOR  A
 6084 2C3E ~                OR   E
 6085 2C3E ~                RET  Z
 6086 2C3E ~                LD   B,A
 6087 2C3E ~                CP   8
 6088 2C3E ~                JP   NC,.bytes
 6089 2C3E ~                CP   4
 6090 2C3E ~                JP   NC,.left
 6091 2C3E ~            .loop:
 6092 2C3E ~                LD   A,H
 6093 2C3E ~                RLCA                    ; the sign into the carry
 6094 2C3E ~                RRCA                    ; H as it was, a T-state less than LD A,H again
 6095 2C3E ~                RRA                     ; and the sign back into the top bit, so it replaces itself
 6096 2C3E ~                LD   H,A
 6097 2C3E ~                LD   A,L
 6098 2C3E ~                RRA
 6099 2C3E ~                LD   L,A
 6100 2C3E ~                DEC  B
 6101 2C3E ~                JP   NZ,.loop
 6102 2C3E ~                RET
 6103 2C3E ~            .left:
 6104 2C3E ~                LD   A,8
 6105 2C3E ~                SUB  B
 6106 2C3E ~                LD   B,A
 6107 2C3E ~                LD   A,H
 6108 2C3E ~                RLA
 6109 2C3E ~                SBC  A,A                ; the sign's byte, 00h or FFh
 6110 2C3E ~            .left_loop:
 6111 2C3E ~                ADD  HL,HL
 6112 2C3E ~                RLA
 6113 2C3E ~                DEC  B
 6114 2C3E ~                JP   NZ,.left_loop
 6115 2C3E ~                LD   L,H
 6116 2C3E ~                LD   H,A
 6117 2C3E ~                RET
 6118 2C3E ~            .bytes:
 6119 2C3E ~                LD   L,H
 6120 2C3E ~                LD   A,H
 6121 2C3E ~                RLA
 6122 2C3E ~                SBC  A,A
 6123 2C3E ~                LD   H,A                ; the sign's byte above
 6124 2C3E ~                LD   A,B
 6125 2C3E ~                SUB  8
 6126 2C3E ~                RET  Z
 6127 2C3E ~                CP   8
 6128 2C3E ~                JP   NC,.all
 6129 2C3E ~                LD   B,A
 6130 2C3E ~                LD   A,L
 6131 2C3E ~            .byte:
 6132 2C3E ~                RLCA                    ; the byte's sign into the carry,
 6133 2C3E ~                RRCA                    ; the byte as it was,
 6134 2C3E ~                RRA                     ; and shifted with the sign: the byte stays in A, 27 T-states a step
 6135 2C3E ~                DEC  B
 6136 2C3E ~                JP   NZ,.byte
 6137 2C3E ~                LD   L,A
 6138 2C3E ~                RET
 6139 2C3E ~            .all:
 6140 2C3E ~                LD   L,H
 6141 2C3E ~                RET
 6142 2C3E                  ENDIF
 6143 2C3E
 6144 2C3E                  IFUSED __x80_memcpy
 6145 2C3E ~
 6146 2C3E ~            ; ---------------------------------------------------------------------------
 6147 2C3E ~            ; HL = destination, DE = source, BC = count. The same direction and the same
 6148 2C3E ~            ; register convention as the reference generator's inline expansion, so that the
 6149 2C3E ~            ; two back ends agree about what a struct assignment does.
 6150 2C3E ~            ;
 6151 2C3E ~            ; A count of zero copies nothing: the test is at the top, unlike the inline
 6152 2C3E ~            ; version, because here the count can come from anywhere.
 6153 2C3E ~            ; ---------------------------------------------------------------------------
 6154 2C3E ~            __x80_memcpy:
 6155 2C3E ~                LD   A,B
 6156 2C3E ~                OR   C
 6157 2C3E ~                RET  Z
 6158 2C3E ~            __x80_memcpy_loop:
 6159 2C3E ~                LD   A,(DE)
 6160 2C3E ~                LD   (HL),A
 6161 2C3E ~                INC  DE
 6162 2C3E ~                INC  HL
 6163 2C3E ~                DEC  BC
 6164 2C3E ~                LD   A,B
 6165 2C3E ~                OR   C
 6166 2C3E ~                JP   NZ,__x80_memcpy_loop
 6167 2C3E ~                RET
 6168 2C3E                  ENDIF
 6169 2C3E
 6170 2C3E              ; ---------------------------------------------------------------------------
 6171 2C3E              ; memcpy, memset and memmove of a length the program has only when it runs
 6172 2C3E              ; (lib/libc/string.c): HL = destination, DE = source (E the byte for memset),
 6173 2C3E              ; BC = the length; HL comes back as it went in, and A, BC, DE and the flags are
 6174 2C3E              ; written. Two bytes a trip, as __x80_mcpyp_even below (SIA, zx-pk.ru), the
 6175 2C3E              ; trips worked out here: one less than them is (n - 1) / 2 for an odd n and an
 6176 2C3E              ; even one alike, and the bit shifted out says which -- an odd n goes in at the
 6177 2C3E              ; second byte of the first pair. That halved, C its low byte and B its high one
 6178 2C3E              ; and each one more is what DEC C / JP NZ inside DEC B / JP NZ counts down. 0 is
 6179 2C3E              ; nothing at all, 65535 32768 trips. 31.5 T-states a byte for a copy and 19.5
 6180 2C3E              ; for a fill, against 39 and 27 for the loops in C they replace. -Os: a byte a
 6181 2C3E              ; trip, the length as the two counters straight away -- as fast as those loops
 6182 2C3E              ; were, and some ten bytes shorter each.
 6183 2C3E              ; ---------------------------------------------------------------------------
 6184 2C3E              ; memmove: forwards by __x80_mcpyn when the destination is below the source,
 6185 2C3E              ; else from the last byte down. Ahead of __x80_mcpyn, so that its IFUSED has seen
 6186 2C3E              ; the jump to it.
 6187 2C3E              ;
 6188 2C3E              ; -mstack-copy: a long one through SP too, when the two are far enough apart that
 6189 2C3E              ; what an interrupt pushes cannot reach a byte still wanted (SIA, zx-pk.ru). Above
 6190 2C3E              ; the source by X80_SP_RESERVE + 16 or more, from the end down as memcpy goes,
 6191 2C3E              ; __x80_mcpys: an interrupt writes into the destination below SP, not yet written
 6192 2C3E              ; and above every byte of the source still to be read; and the first bytes, which
 6193 2C3E              ; it copies upwards at the end, are below what the source gave for the rest. Below
 6194 2C3E              ; it by X80_SP_RESERVE or more, upwards by __x80_mmoves, below.
 6195 2C3E                  IFUSED __x80_mmoven
 6196 2C3E ~            __x80_mmoven:
 6197 2C3E ~                LD   A,L
 6198 2C3E ~                SUB  E
 6199 2C3E ~                LD   A,H
