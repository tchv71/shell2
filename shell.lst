 4163 2ADE ~                RLA
 4164 2ADE ~                LD   E,A
 4165 2ADE ~                LD   A,D
 4166 2ADE ~                RLA
 4167 2ADE ~                LD   D,A
 4168 2ADE ~                LD   A,B
 4169 2ADE ~                RLA
 4170 2ADE ~                LD   B,A
 4171 2ADE ~                DEC  C
 4172 2ADE ~                JP   NZ,.left_loop
