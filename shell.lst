 3575 2ABB ~                XOR  C
 3576 2ABB ~                CALL __x80_q_signed
 3577 2ABB ~                LD   HL,__x80_qa
 3578 2ABB ~                CALL Z,__x80_q_negate
 3579 2ABB ~                LD   HL,__x80_qa
 3580 2ABB ~                JP   __x80_q_give
 3581 2ABB                  ENDIF
 3582 2ABB
 3583 2ABB                  IFUSED __x80_qsrem
