 3292 2ABA ~                JP   Z,.tiny
 3293 2ABA ~                DEC  C
 3294 2ABA ~                JP   .round
 3295 2ABA ~            .tiny:
 3296 2ABA ~                ; below the normal range: 1 - BC places down, the exponent field 0
 3297 2ABA ~                LD   A,1
 3298 2ABA ~                SUB  C
 3299 2ABA ~                LD   C,A
 3300 2ABA ~                LD   A,0
 3301 2ABA ~                SBC  A,B
 3302 2ABA ~                JP   NZ,__x80_fp_zero
 3303 2ABA ~                LD   A,C
 3304 2ABA ~                CP   32
 3305 2ABA ~                JP   NC,__x80_fp_zero
 3306 2ABA ~                CALL __x80_fp_shr
 3307 2ABA ~                LD   C,0
