 5086 2BAE ~                ADD  A,A
 5087 2BAE ~                JP   C,.s6
 5088 2BAE ~                ADD  A,A
 5089 2BAE ~                JP   C,.s5
 5090 2BAE ~                ADD  A,A
 5091 2BAE ~                JP   C,.s4
