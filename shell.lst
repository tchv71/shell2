 5483 2BEA                  IFUSED __x80_dpass16
 5484 2BEA ~
 5485 2BEA ~            ; ---------------------------------------------------------------------------
 5486 2BEA ~            ; A byte of a quotient: blackmirror's division (zx-pk.ru, "Vychislenie chisla Pi na
 5487 2BEA ~            ; assemblere", 2016), as ivagor made it the 8080's.
 5488 2BEA ~            ;
 5489 2BEA ~            ; Non-restoring, and unrolled: the remainder doubled each step and the divisor added to it or
 5490 2BEA ~            ; taken from it -- added while the remainder is below zero, taken while it is not -- so that it
 5491 2BEA ~            ; stays within one divisor of zero, and the step's carry is the quotient's bit. The two cases are
 5492 2BEA ~            ; two chains of code, and a step goes from one to the other on its carry: no test of a sign, no
 5493 2BEA ~            ; restoring of a remainder that went below zero. Each step is ADC A,A / ADD HL,HL / ADD HL,rp / JP
 5494 2BEA ~            ; -- 34 T-states a bit, where a restoring step with the remainder in memory or on the stack was
 5495 2BEA ~            ; three or four times that. The carry, not the sign, tells which way the remainder went, which is
 5496 2BEA ~            ; what lets the divisor be anything below 32768: the doubled remainder may need seventeen bits,
 5497 2BEA ~            ; but the carry is the seventeenth.
 5498 2BEA ~            ;
 5499 2BEA ~            ; __x80_dpass16: a divisor B of 256..32767 in BC, -B in DE, and in HL a remainder R below B as
 5500 2BEA ~            ; the passes keep it, R - B. Returns the byte of R * 256 / B in A, and in HL (R * 256 % B) - B,
 5501 2BEA ~            ; to which the caller adds the next byte of the dividend: when that carries, the remainder has
 5502 2BEA ~            ; reached B again -- one more in the quotient, and B taken off once more.
 5503 2BEA ~            ; ---------------------------------------------------------------------------
 5504 2BEA ~            __x80_dpass16:
 5505 2BEA ~                ADD  HL,HL          ; bit 7, the remainder below zero
 5506 2BEA ~                ADD  HL,BC
 5507 2BEA ~                JP   C,.s6
 5508 2BEA ~            .a6:
 5509 2BEA ~                ADC  A,A
 5510 2BEA ~                ADD  HL,HL
 5511 2BEA ~                ADD  HL,BC
 5512 2BEA ~                JP   C,.s5
 5513 2BEA ~            .a5:
 5514 2BEA ~                ADC  A,A
 5515 2BEA ~                ADD  HL,HL
 5516 2BEA ~                ADD  HL,BC
 5517 2BEA ~                JP   C,.s4
 5518 2BEA ~            .a4:
 5519 2BEA ~                ADC  A,A
 5520 2BEA ~                ADD  HL,HL
 5521 2BEA ~                ADD  HL,BC
 5522 2BEA ~                JP   C,.s3
 5523 2BEA ~            .a3:
 5524 2BEA ~                ADC  A,A
 5525 2BEA ~                ADD  HL,HL
 5526 2BEA ~                ADD  HL,BC
 5527 2BEA ~                JP   C,.s2
 5528 2BEA ~            .a2:
 5529 2BEA ~                ADC  A,A
 5530 2BEA ~                ADD  HL,HL
 5531 2BEA ~                ADD  HL,BC
 5532 2BEA ~                JP   C,.s1
 5533 2BEA ~            .a1:
 5534 2BEA ~                ADC  A,A
 5535 2BEA ~                ADD  HL,HL
 5536 2BEA ~                ADD  HL,BC
 5537 2BEA ~                JP   C,.s0
 5538 2BEA ~            .a0:
 5539 2BEA ~                ADC  A,A
 5540 2BEA ~                ADD  HL,HL
 5541 2BEA ~                ADD  HL,BC
 5542 2BEA ~                JP   C,.se
 5543 2BEA ~            .ae:
 5544 2BEA ~                ADC  A,A            ; the last bit; the remainder already below zero
 5545 2BEA ~                RET
 5546 2BEA ~            .s6:
 5547 2BEA ~                ADC  A,A
 5548 2BEA ~                ADD  HL,HL
 5549 2BEA ~                ADD  HL,DE
 5550 2BEA ~                JP   NC,.a5
 5551 2BEA ~            .s5:
 5552 2BEA ~                ADC  A,A
 5553 2BEA ~                ADD  HL,HL
 5554 2BEA ~                ADD  HL,DE
 5555 2BEA ~                JP   NC,.a4
 5556 2BEA ~            .s4:
 5557 2BEA ~                ADC  A,A
 5558 2BEA ~                ADD  HL,HL
 5559 2BEA ~                ADD  HL,DE
 5560 2BEA ~                JP   NC,.a3
 5561 2BEA ~            .s3:
 5562 2BEA ~                ADC  A,A
 5563 2BEA ~                ADD  HL,HL
 5564 2BEA ~                ADD  HL,DE
 5565 2BEA ~                JP   NC,.a2
 5566 2BEA ~            .s2:
 5567 2BEA ~                ADC  A,A
 5568 2BEA ~                ADD  HL,HL
 5569 2BEA ~                ADD  HL,DE
 5570 2BEA ~                JP   NC,.a1
 5571 2BEA ~            .s1:
 5572 2BEA ~                ADC  A,A
 5573 2BEA ~                ADD  HL,HL
 5574 2BEA ~                ADD  HL,DE
 5575 2BEA ~                JP   NC,.a0
 5576 2BEA ~            .s0:
 5577 2BEA ~                ADC  A,A
 5578 2BEA ~                ADD  HL,HL
 5579 2BEA ~                ADD  HL,DE
 5580 2BEA ~                JP   NC,.ae
 5581 2BEA ~            .se:
 5582 2BEA ~                ADC  A,A            ; the last bit; the remainder made R - B, as the passes keep it
 5583 2BEA ~                ADD  HL,DE
 5584 2BEA ~                RET
 5585 2BEA                  ENDIF
