 4294 2ADC ~                LD   HL,__x80_rt_b
 4295 2ADC ~                CALL __x80_abs32
 4296 2ADC ~                CALL __x80_divide
 4297 2ADC ~                LD   A,(__x80_rt_sign)
 4298 2ADC ~                CP   80H
 4299 2ADC ~                RET
