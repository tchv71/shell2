 5752 2BEC
 5753 2BEC                  IFUSED __x80_mul16
 5754 2BEC              ; ---------------------------------------------------------------------------
 5755 2BEC              ; HL = HL * DE, sixteen bits, wrapping.
 5756 2BEC              ;
 5757 2BEC              ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2BEC              ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2BEC              ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2BEC              ; and ten more for a set one.
 5761 2BEC              ;
 5762 2BEC              ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2BEC              ; an index times the size of an element, a value times a small factor. When it is the
 5764 2BEC              ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2BEC              ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2BEC              ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2BEC              ;
 5768 2BEC              ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2BEC              ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2BEC              ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2BEC              ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2BEC              ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2BEC              ; keep the eight steps from zero.
 5774 2BEC              ;
 5775 2BEC              ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2BEC              ; additions.
 5777 2BEC              ; ---------------------------------------------------------------------------
 5778 2BEC              __x80_mul16:
 5779 2BEC AF               XOR  A
 5780 2BED B2               OR   D
 5781 2BEE CA F7 2B         JP   Z,.small       ; the multiplier fits in a byte
 5782 2BF1 AF               XOR  A
 5783 2BF2 B4               OR   H
 5784 2BF3 C2 00 2C         JP   NZ,.full
 5785 2BF6 EB               EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2BF7              .small:
 5787 2BF7 44               LD   B,H
 5788 2BF8 4D               LD   C,L            ; BC = multiplicand
 5789 2BF9                  IFNDEF X80_OPT_SPEED
 5790 2BF9 21 00 00         LD   HL,0
 5791 2BFC 7B               LD   A,E
 5792 2BFD C3 0A 2C         JP   __x80_mul16_byte
 5793 2C00              .full:
 5794 2C00 44               LD   B,H
 5795 2C01 4D               LD   C,L
 5796 2C02 21 00 00         LD   HL,0
 5797 2C05 7A               LD   A,D
 5798 2C06 CD 0A 2C         CALL __x80_mul16_byte
 5799 2C09 7B               LD   A,E
 5800 2C0A                  ELSE
 5801 2C0A ~                LD   A,E
 5802 2C0A ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2C0A ~            .full:
 5804 2C0A ~                LD   B,H
 5805 2C0A ~                LD   C,L
 5806 2C0A ~                LD   A,D
 5807 2C0A ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2C0A ~                LD   A,E
 5809 2C0A ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2C0A                  ENDIF
 5811 2C0A                  ENDIF
 5812 2C0A
 5813 2C0A                  IFUSED __x80_mul16_byte
 5814 2C0A              ; HL = HL * 256 + BC * A: eight steps of the above, for the byte in A. What __x80_mul16 falls into,
 5815 2C0A              ; and what the compiler calls itself for a word by a byte widened (isel.c, select_muldiv).
 5816 2C0A              __x80_mul16_byte:
 5817 2C0A                  IFDEF X80_OPT_SIZE
 5818 2C0A                  ; -Os: the steps as a loop, 18 bytes for 49. The multiplier's bits go out of A with a 1 in
 5819 2C0A                  ; behind them at the bottom; when that 1 comes out, A is zero and the eight are done.
 5820 2C0A 37               SCF
 5821 2C0B 8F               ADC  A,A
 5822 2C0C              .s_bit:
 5823 2C0C D2 16 2C         JP   NC,.s_zero
 5824 2C0F 29               ADD  HL,HL
 5825 2C10 09               ADD  HL,BC
 5826 2C11 87               ADD  A,A
 5827 2C12 C2 0C 2C         JP   NZ,.s_bit
 5828 2C15 C9               RET
 5829 2C16              .s_zero:
 5830 2C16 29               ADD  HL,HL
 5831 2C17 87               ADD  A,A
 5832 2C18 C2 0C 2C         JP   NZ,.s_bit
 5833 2C1B C9               RET
 5834 2C1C                  ELSE
 5835 2C1C ~                ADD  HL,HL
 5836 2C1C ~                ADD  A,A
 5837 2C1C ~                JP   NC,$+4
 5838 2C1C ~                ADD  HL,BC
 5839 2C1C ~            __x80_mul16_b7:             ; the steps for the last seven bits, where __x80_mul16_lead comes in
 5840 2C1C ~                ADD  HL,HL
 5841 2C1C ~                ADD  A,A
 5842 2C1C ~                JP   NC,$+4
 5843 2C1C ~                ADD  HL,BC
 5844 2C1C ~            __x80_mul16_b6:
 5845 2C1C ~                ADD  HL,HL
 5846 2C1C ~                ADD  A,A
 5847 2C1C ~                JP   NC,$+4
 5848 2C1C ~                ADD  HL,BC
 5849 2C1C ~            __x80_mul16_b5:
 5850 2C1C ~                ADD  HL,HL
 5851 2C1C ~                ADD  A,A
 5852 2C1C ~                JP   NC,$+4
 5853 2C1C ~                ADD  HL,BC
 5854 2C1C ~            __x80_mul16_b4:
 5855 2C1C ~                ADD  HL,HL
 5856 2C1C ~                ADD  A,A
 5857 2C1C ~                JP   NC,$+4
 5858 2C1C ~                ADD  HL,BC
 5859 2C1C ~            __x80_mul16_b3:
 5860 2C1C ~                ADD  HL,HL
 5861 2C1C ~                ADD  A,A
 5862 2C1C ~                JP   NC,$+4
 5863 2C1C ~                ADD  HL,BC
 5864 2C1C ~            __x80_mul16_b2:
 5865 2C1C ~                ADD  HL,HL
 5866 2C1C ~                ADD  A,A
 5867 2C1C ~                JP   NC,$+4
 5868 2C1C ~                ADD  HL,BC
 5869 2C1C ~            __x80_mul16_b1:
 5870 2C1C ~                ADD  HL,HL
 5871 2C1C ~                ADD  A,A
 5872 2C1C ~                RET  NC
 5873 2C1C ~                ADD  HL,BC
 5874 2C1C ~                RET
 5875 2C1C                  ENDIF
 5876 2C1C                  ENDIF
