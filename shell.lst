 1640 2ABB ~                OR   80H
 1641 2ABB ~                LD   D,A
 1642 2ABB ~            .b_bytes:
 1643 2ABB ~                DEC  HL
 1644 2ABB ~                LD   E,(HL)
 1645 2ABB ~                DEC  HL
 1646 2ABB ~                LD   H,(HL)
