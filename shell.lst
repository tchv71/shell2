 2841 2ABB ~                LD   (__x80_fps),A
 2842 2ABB ~                RET
 2843 2ABB                  ENDIF
 2844 2ABB
 2845 2ABB                  IFUSED __x80_fsqrt
 2846 2ABB ~            ; ---------------------------------------------------------------------------
 2847 2ABB ~            ; HL:DE = the square root of the float in HL:DE, which is not below zero unless it is a NaN --
 2848 2ABB ~            ; sqrtf (lib/libc/math.c) takes the others, for errno: correctly rounded, bit by bit as fdlibm's
 2849 2ABB ~            ; e_sqrtf.c, so the same as (float)sqrt(x).
 2850 2ABB ~            ;
 2851 2ABB ~            ; ix, the remainder, in BCDE; t, twice the root so far with the bit being tried, in fpa, low byte
 2852 2ABB ~            ; first; that bit in fpb, within its byte of t; the result's exponent in fpb+1. The bytes of t
 2853 2ABB ~            ; below the bit's are zero: only those from the bit's up are compared and subtracted, a phase of
 2854 2ABB ~            ; eight bits for each byte.
 2855 2ABB ~            ; ---------------------------------------------------------------------------
 2856 2ABB ~            __x80_fsqrt:
 2857 2ABB ~                LD   A,E
 2858 2ABB ~                RLA
 2859 2ABB ~                LD   A,D
 2860 2ABB ~                RLA                     ; the exponent
 2861 2ABB ~                LD   B,A
 2862 2ABB ~                INC  A
 2863 2ABB ~                JP   Z,.nan
 2864 2ABB ~                LD   A,E
 2865 2ABB ~                OR   80H
 2866 2ABB ~                LD   C,A                ; the significand with its leading one, C H L
 2867 2ABB ~                LD   A,B
 2868 2ABB ~                OR   A
 2869 2ABB ~                JP   Z,.tiny
 2870 2ABB ~                ADD  A,127              ; m + 127, the ninth bit in the carry
 2871 2ABB ~            .exp:
 2872 2ABB ~                RRA                     ; (m + 127) / 2, the result's exponent; carry: m - 127 is odd
 2873 2ABB ~                LD   (__x80_fpb+1),A
 2874 2ABB ~                LD   B,0
 2875 2ABB ~                LD   D,H
 2876 2ABB ~                LD   E,L                ; ix = the significand
 2877 2ABB ~                JP   NC,.even
 2878 2ABB ~                EX   DE,HL
 2879 2ABB ~                ADD  HL,HL
 2880 2ABB ~                EX   DE,HL
 2881 2ABB ~                LD   A,C
 2882 2ABB ~                ADC  A,A
