 4208 2ABA                  IFUSED __x80_zero32
 4209 2ABA ~
 4210 2ABA ~            __x80_zero32:
 4211 2ABA ~                LD   HL,0
 4212 2ABA ~                LD   D,H
 4213 2ABA ~                LD   E,L
 4214 2ABA ~                RET
 4215 2ABA                  ENDIF
 4216 2ABA
 4217 2ABA                  IFUSED __x80_ludiv
 4218 2ABA
 4219 2ABA              ; ---------------------------------------------------------------------------
 4220 2ABA              ; Division and remainder, unsigned and signed.
 4221 2ABA              ;
 4222 2ABA              ; Over memory: the dividend in rt_a, which then holds the quotient, the divisor in rt_b, the
 4223 2ABA              ; remainder in rt_r (__x80_divide). A byte of the quotient at a time: by __x80_dpass8 and
 4224 2ABA              ; __x80_dpass16 for a divisor below 32768, by passes with a 24- or 32-bit remainder for a larger. C truncates the quotient towards zero and gives the remainder the sign of the dividend, so the
 4225 2ABA              ; signed forms are the unsigned division of the magnitudes with the sign put back afterwards.
 4226 2ABA              ; ---------------------------------------------------------------------------
 4227 2ABA              __x80_ludiv:
 4228 2ABA CD C3 2A         CALL __x80_div_args
 4229 2ABD CD EB 2A         CALL __x80_divide
 4230 2AC0 C3 DB 2A         JP   __x80_quotient
 4231 2AC3                  ENDIF
 4232 2AC3
 4233 2AC3                  IFUSED __x80_lurem
 4234 2AC3 ~
 4235 2AC3 ~            __x80_lurem:
 4236 2AC3 ~                CALL __x80_div_args
 4237 2AC3 ~                CALL __x80_divide
 4238 2AC3 ~                JP   __x80_remainder
 4239 2AC3                  ENDIF
 4240 2AC3
 4241 2AC3                  IFUSED __x80_lsdiv
 4242 2AC3 ~
 4243 2AC3 ~            __x80_lsdiv:
 4244 2AC3 ~                CALL __x80_div_args
 4245 2AC3 ~                LD   A,(__x80_rt_a+3)   ; the quotient is negative when the signs differ
 4246 2AC3 ~                LD   C,A
 4247 2AC3 ~                LD   A,(__x80_rt_b+3)
 4248 2AC3 ~                XOR  C
 4249 2AC3 ~                CALL __x80_signed_divide
 4250 2AC3 ~                CALL Z,__x80_negate_a
 4251 2AC3 ~                JP   __x80_quotient
 4252 2AC3                  ENDIF
 4253 2AC3
 4254 2AC3                  IFUSED __x80_lsrem
 4255 2AC3 ~
 4256 2AC3 ~            __x80_lsrem:
 4257 2AC3 ~                CALL __x80_div_args
 4258 2AC3 ~                LD   A,(__x80_rt_a+3)   ; the remainder takes the sign of the dividend
 4259 2AC3 ~                CALL __x80_signed_divide
 4260 2AC3 ~                LD   HL,__x80_rt_r
 4261 2AC3 ~                CALL Z,__x80_negate32
 4262 2AC3 ~                JP   __x80_remainder
 4263 2AC3                  ENDIF
 4264 2AC3
 4265 2AC3                  IFUSED __x80_div_args
 4266 2AC3
 4267 2AC3              ; rt_a = DE:HL, rt_b = [SP+4]:BC -- the stack argument is two return addresses up.
 4268 2AC3              __x80_div_args:
 4269 2AC3 22 4C 2C         LD   (__x80_rt_a),HL
 4270 2AC6 EB               EX   DE,HL
 4271 2AC7 22 4E 2C         LD   (__x80_rt_a+2),HL
 4272 2ACA 60               LD   H,B
 4273 2ACB 69               LD   L,C
 4274 2ACC 22 48 2C         LD   (__x80_rt_b),HL
 4275 2ACF 21 04 00         LD   HL,4
 4276 2AD2 39               ADD  HL,SP
 4277 2AD3 7E               LD   A,(HL)
 4278 2AD4 23               INC  HL
 4279 2AD5 66               LD   H,(HL)
 4280 2AD6 6F               LD   L,A
 4281 2AD7 22 4A 2C         LD   (__x80_rt_b+2),HL
 4282 2ADA C9               RET
 4283 2ADB                  ENDIF
 4284 2ADB
 4285 2ADB                  IFUSED __x80_signed_divide
 4286 2ADB ~
 4287 2ADB ~            ; Divides the magnitudes, with the sign the result should have in bit 7 of A on entry; returns
 4288 2ADB ~            ; with Z clear when the result is to stay as it is and Z set when it is to be negated.
 4289 2ADB ~            __x80_signed_divide:
 4290 2ADB ~                AND  80H
 4291 2ADB ~                LD   (__x80_rt_sign),A
 4292 2ADB ~                LD   HL,__x80_rt_a
 4293 2ADB ~                CALL __x80_abs32
 4294 2ADB ~                LD   HL,__x80_rt_b
 4295 2ADB ~                CALL __x80_abs32
 4296 2ADB ~                CALL __x80_divide
 4297 2ADB ~                LD   A,(__x80_rt_sign)
 4298 2ADB ~                CP   80H
 4299 2ADB ~                RET
 4300 2ADB                  ENDIF
 4301 2ADB
 4302 2ADB                  IFUSED __x80_negate_a
 4303 2ADB ~
 4304 2ADB ~            __x80_negate_a:
 4305 2ADB ~                LD   HL,__x80_rt_a
 4306 2ADB ~                JP   __x80_negate32
 4307 2ADB                  ENDIF
 4308 2ADB
 4309 2ADB                  IFUSED __x80_quotient
 4310 2ADB
 4311 2ADB              __x80_quotient:
 4312 2ADB 2A 4E 2C         LD   HL,(__x80_rt_a+2)
 4313 2ADE EB               EX   DE,HL
 4314 2ADF 2A 4C 2C         LD   HL,(__x80_rt_a)
 4315 2AE2 C9               RET
 4316 2AE3                  ENDIF
 4317 2AE3
 4318 2AE3                  IFUSED __x80_remainder
 4319 2AE3
 4320 2AE3              __x80_remainder:
 4321 2AE3 2A 46 2C         LD   HL,(__x80_rt_r+2)
 4322 2AE6 EB               EX   DE,HL
 4323 2AE7 2A 44 2C         LD   HL,(__x80_rt_r)
 4324 2AEA C9               RET
 4325 2AEB                  ENDIF
 4326 2AEB
 4327 2AEB                  IFUSED __x80_divide
 4328 2AEB
 4329 2AEB              __x80_divide:
 4330 2AEB                  IFDEF X80_OPT_SIZE
 4331 2AEB                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2AEB                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2AEB                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2AEB                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2AEB                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2AEB 2A 48 2C         LD   HL,(__x80_rt_b)
 4337 2AEE 7C               LD   A,H
 4338 2AEF B5               OR   L
 4339 2AF0 2A 4A 2C         LD   HL,(__x80_rt_b+2)
 4340 2AF3 B4               OR   H
 4341 2AF4 B5               OR   L
 4342 2AF5 CA 98 2B         JP   Z,.s_zero
 4343 2AF8 21 48 2C         LD   HL,__x80_rt_b
 4344 2AFB 11 44 2C         LD   DE,__x80_rt_r
 4345 2AFE 06 04            LD   B,4
 4346 2B00              .s_not:
 4347 2B00 7E               LD   A,(HL)
 4348 2B01 2F               CPL
 4349 2B02 12               LD   (DE),A
 4350 2B03 23               INC  HL
 4351 2B04 13               INC  DE
 4352 2B05 05               DEC  B
 4353 2B06 C2 00 2B         JP   NZ,.s_not
 4354 2B09 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 2B0B              .s_skip:                    ; remainder zero still and the quotient's bits 0
 4356 2B0B 3A 4F 2C         LD   A,(__x80_rt_a+3)
 4357 2B0E B7               OR   A
 4358 2B0F C2 29 2B         JP   NZ,.s_go
 4359 2B12 2A 4D 2C         LD   HL,(__x80_rt_a+1)
 4360 2B15 22 4E 2C         LD   (__x80_rt_a+2),HL
 4361 2B18 3A 4C 2C         LD   A,(__x80_rt_a)
 4362 2B1B 32 4D 2C         LD   (__x80_rt_a+1),A
 4363 2B1E AF               XOR  A
 4364 2B1F 32 4C 2C         LD   (__x80_rt_a),A
 4365 2B22 78               LD   A,B
 4366 2B23 D6 08            SUB  8
 4367 2B25 47               LD   B,A
 4368 2B26 C2 0B 2B         JP   NZ,.s_skip
 4369 2B29              .s_go:
 4370 2B29 21 00 00         LD   HL,0
 4371 2B2C 54               LD   D,H
 4372 2B2D 5D               LD   E,L
 4373 2B2E 78               LD   A,B
 4374 2B2F B7               OR   A
 4375 2B30 CA 90 2B         JP   Z,.s_done          ; a dividend of zero
 4376 2B33              .s_loop:
 4377 2B33 F5               PUSH AF
 4378 2B34 3A 4C 2C         LD   A,(__x80_rt_a)     ; the dividend's top bit out, a 0 in for the quotient's bit
 4379 2B37 87               ADD  A,A
 4380 2B38 32 4C 2C         LD   (__x80_rt_a),A
 4381 2B3B 3A 4D 2C         LD   A,(__x80_rt_a+1)
 4382 2B3E 17               RLA
 4383 2B3F 32 4D 2C         LD   (__x80_rt_a+1),A
 4384 2B42 3A 4E 2C         LD   A,(__x80_rt_a+2)
 4385 2B45 17               RLA
 4386 2B46 32 4E 2C         LD   (__x80_rt_a+2),A
 4387 2B49 3A 4F 2C         LD   A,(__x80_rt_a+3)
 4388 2B4C 17               RLA
 4389 2B4D 32 4F 2C         LD   (__x80_rt_a+3),A
 4390 2B50 7D               LD   A,L                ; and into the remainder, the carry its thirty-third bit
 4391 2B51 17               RLA
 4392 2B52 6F               LD   L,A
 4393 2B53 7C               LD   A,H
 4394 2B54 17               RLA
 4395 2B55 67               LD   H,A
 4396 2B56 7B               LD   A,E
 4397 2B57 17               RLA
 4398 2B58 5F               LD   E,A
 4399 2B59 7A               LD   A,D
 4400 2B5A 17               RLA
 4401 2B5B 57               LD   D,A
 4402 2B5C 01 44 2C         LD   BC,__x80_rt_r
 4403 2B5F DA 74 2B         JP   C,.s_take          ; above the divisor whatever the rest
 4404 2B62 37               SCF                     ; R + ~d + 1: the carry if R is not below d
 4405 2B63 0A               LD   A,(BC)
 4406 2B64 8D               ADC  A,L
 4407 2B65 03               INC  BC
 4408 2B66 0A               LD   A,(BC)
 4409 2B67 8C               ADC  A,H
 4410 2B68 03               INC  BC
 4411 2B69 0A               LD   A,(BC)
 4412 2B6A 8B               ADC  A,E
 4413 2B6B 03               INC  BC
 4414 2B6C 0A               LD   A,(BC)
 4415 2B6D 8A               ADC  A,D
 4416 2B6E D2 8B 2B         JP   NC,.s_next
 4417 2B71 01 44 2C         LD   BC,__x80_rt_r
 4418 2B74              .s_take:
 4419 2B74 37               SCF                     ; d taken off, and a 1
 4420 2B75 0A               LD   A,(BC)
 4421 2B76 8D               ADC  A,L
 4422 2B77 6F               LD   L,A
 4423 2B78 03               INC  BC
 4424 2B79 0A               LD   A,(BC)
 4425 2B7A 8C               ADC  A,H
 4426 2B7B 67               LD   H,A
 4427 2B7C 03               INC  BC
 4428 2B7D 0A               LD   A,(BC)
 4429 2B7E 8B               ADC  A,E
 4430 2B7F 5F               LD   E,A
 4431 2B80 03               INC  BC
 4432 2B81 0A               LD   A,(BC)
 4433 2B82 8A               ADC  A,D
 4434 2B83 57               LD   D,A
 4435 2B84 3A 4C 2C         LD   A,(__x80_rt_a)
 4436 2B87 3C               INC  A
 4437 2B88 32 4C 2C         LD   (__x80_rt_a),A
 4438 2B8B              .s_next:
 4439 2B8B F1               POP  AF
 4440 2B8C 3D               DEC  A
 4441 2B8D C2 33 2B         JP   NZ,.s_loop
 4442 2B90              .s_done:
 4443 2B90 22 44 2C         LD   (__x80_rt_r),HL
 4444 2B93 EB               EX   DE,HL
 4445 2B94 22 46 2C         LD   (__x80_rt_r+2),HL
 4446 2B97 C9               RET
 4447 2B98              .s_zero:
 4448 2B98 2A 4C 2C         LD   HL,(__x80_rt_a)    ; as below: all ones, and the dividend left over
 4449 2B9B 22 44 2C         LD   (__x80_rt_r),HL
 4450 2B9E 2A 4E 2C         LD   HL,(__x80_rt_a+2)
 4451 2BA1 22 46 2C         LD   (__x80_rt_r+2),HL
 4452 2BA4 21 FF FF         LD   HL,0FFFFH
 4453 2BA7 22 4C 2C         LD   (__x80_rt_a),HL
 4454 2BAA 22 4E 2C         LD   (__x80_rt_a+2),HL
 4455 2BAD C9               RET
 4456 2BAE                  ELSE
 4457 2BAE ~                ; A divisor below 32768 -- ten for a number being printed, a modulus, a count -- is a byte of
 4458 2BAE ~                ; the quotient at a time (__x80_dpass8, __x80_dpass16), the dividend's bytes from the top: some
 4459 2BAE ~                ; 1 300 T-states for a byte divisor, 1 100 for a word, where shifting the four bytes through
 4460 2BAE ~                ; memory a bit at a time was several thousand.
 4461 2BAE ~                LD   HL,(__x80_rt_b+2)
 4462 2BAE ~                LD   A,H
 4463 2BAE ~                OR   L
 4464 2BAE ~                JP   NZ,.general
 4465 2BAE ~                LD   HL,(__x80_rt_b)
 4466 2BAE ~                LD   A,H
 4467 2BAE ~                OR   A
 4468 2BAE ~                JP   M,.general         ; 32768 or more
 4469 2BAE ~                JP   NZ,.word
 4470 2BAE ~                OR   L
 4471 2BAE ~                JP   Z,.by_zero
 4472 2BAE ~                LD   E,L                ; a byte: four passes, or three when the top byte is below it
 4473 2BAE ~                CALL __x80_dsetup8
 4474 2BAE ~                LD   A,C
 4475 2BAE ~                RLA
 4476 2BAE ~                LD   A,B
 4477 2BAE ~                RLA                     ; the divisor again, from BC
 4478 2BAE ~                LD   L,A
 4479 2BAE ~                LD   A,(__x80_rt_a+3)
 4480 2BAE ~                CP   L
 4481 2BAE ~                LD   H,A                ; below: no quotient there, and the byte is the remainder
 4482 2BAE ~                LD   A,0
 4483 2BAE ~                JP   C,.b3
 4484 2BAE ~                LD   L,H
 4485 2BAE ~                LD   H,A
 4486 2BAE ~                CALL __x80_dpass8
 4487 2BAE ~            .b3:
 4488 2BAE ~                LD   (__x80_rt_a+3),A
 4489 2BAE ~                LD   A,(__x80_rt_a+2)
 4490 2BAE ~                LD   L,A
 4491 2BAE ~                CALL __x80_dpass8
 4492 2BAE ~                LD   (__x80_rt_a+2),A
 4493 2BAE ~                LD   A,(__x80_rt_a+1)
 4494 2BAE ~                LD   L,A
 4495 2BAE ~                CALL __x80_dpass8
 4496 2BAE ~                LD   (__x80_rt_a+1),A
 4497 2BAE ~                LD   A,(__x80_rt_a)
 4498 2BAE ~                LD   L,A
 4499 2BAE ~                CALL __x80_dpass8
 4500 2BAE ~                LD   (__x80_rt_a),A
 4501 2BAE ~                LD   L,H                ; the remainder
 4502 2BAE ~                LD   H,0
 4503 2BAE ~                LD   (__x80_rt_r),HL
 4504 2BAE ~                LD   L,H
 4505 2BAE ~                LD   (__x80_rt_r+2),HL
 4506 2BAE ~                RET
 4507 2BAE ~            .word:
 4508 2BAE ~                ; 256..32767: the top byte is below the divisor, the remainder to start from, and the
 4509 2BAE ~                ; quotient's top byte is zero; three passes, each adding the next byte after it.
 4510 2BAE ~                LD   B,H
 4511 2BAE ~                LD   C,L
 4512 2BAE ~                XOR  A
 4513 2BAE ~                SUB  L
 4514 2BAE ~                LD   E,A
 4515 2BAE ~                LD   A,0
 4516 2BAE ~                SBC  A,H
 4517 2BAE ~                LD   D,A
 4518 2BAE ~                LD   A,(__x80_rt_a+3)
 4519 2BAE ~                LD   L,A
 4520 2BAE ~                LD   H,0
 4521 2BAE ~                ADD  HL,DE              ; as __x80_dpass16 takes a remainder
 4522 2BAE ~                CALL __x80_dpass16
 4523 2BAE ~                PUSH AF
 4524 2BAE ~                LD   A,(__x80_rt_a+2)   ; the next byte added
 4525 2BAE ~                ADD  A,L
 4526 2BAE ~                LD   L,A
 4527 2BAE ~                LD   A,H
 4528 2BAE ~                ADC  A,0
 4529 2BAE ~                LD   H,A
 4530 2BAE ~                JP   NC,.w2
 4531 2BAE ~                ADD  HL,DE              ; it reached the divisor: taken off, and one more in the quotient
 4532 2BAE ~                POP  AF
 4533 2BAE ~                INC  A
 4534 2BAE ~                PUSH AF
 4535 2BAE ~            .w2:
 4536 2BAE ~                POP  AF
 4537 2BAE ~                LD   (__x80_rt_a+2),A
 4538 2BAE ~                CALL __x80_dpass16
 4539 2BAE ~                PUSH AF
 4540 2BAE ~                LD   A,(__x80_rt_a+1)
 4541 2BAE ~                ADD  A,L
 4542 2BAE ~                LD   L,A
 4543 2BAE ~                LD   A,H
 4544 2BAE ~                ADC  A,0
 4545 2BAE ~                LD   H,A
 4546 2BAE ~                JP   NC,.w1
 4547 2BAE ~                ADD  HL,DE
 4548 2BAE ~                POP  AF
 4549 2BAE ~                INC  A
 4550 2BAE ~                PUSH AF
 4551 2BAE ~            .w1:
 4552 2BAE ~                POP  AF
 4553 2BAE ~                LD   (__x80_rt_a+1),A
 4554 2BAE ~                CALL __x80_dpass16
 4555 2BAE ~                PUSH AF
 4556 2BAE ~                LD   A,(__x80_rt_a)     ; the last byte: the remainder made positive
 4557 2BAE ~                ADD  A,L
 4558 2BAE ~                LD   L,A
 4559 2BAE ~                LD   A,H
 4560 2BAE ~                ADC  A,0
 4561 2BAE ~                LD   H,A
 4562 2BAE ~                JP   C,.w0
 4563 2BAE ~                ADD  HL,BC              ; below the divisor still: as it is
 4564 2BAE ~                POP  AF
 4565 2BAE ~                JP   .w_end
 4566 2BAE ~            .w0:
 4567 2BAE ~                POP  AF                 ; reached it: the remainder is what is over, one more
 4568 2BAE ~                INC  A
 4569 2BAE ~            .w_end:
 4570 2BAE ~                LD   (__x80_rt_a),A
 4571 2BAE ~                LD   (__x80_rt_r),HL
 4572 2BAE ~                XOR  A
 4573 2BAE ~                LD   (__x80_rt_a+3),A
 4574 2BAE ~                LD   H,A
 4575 2BAE ~                LD   L,A
 4576 2BAE ~                LD   (__x80_rt_r+2),HL
 4577 2BAE ~                RET
 4578 2BAE ~            .general:
 4579 2BAE ~                ; A divisor of 32768 or more: still a byte of the quotient at a time, the same non-restoring
 4580 2BAE ~                ; steps with the next byte of the dividend added after each pass, but the remainder no longer
 4581 2BAE ~                ; fits sixteen bits. Below 2^23 it is twenty-four, in E:HL, and the quotient's byte comes
 4582 2BAE ~                ; together in D behind a sentinel bit that drops out at the eighth step; from 2^23 it is
 4583 2BAE ~                ; thirty-two, DE:HL, and the quotient's byte waits in rt_lo. The divisor's low word is in BC,
 4584 2BAE ~                ; to add; the rest of it, and its negative to take it off, in memory -- -d in rt_r, which the
 4585 2BAE ~                ; remainder replaces at the end. As the 16-bit passes do, the carry tells which way the
 4586 2BAE ~                ; remainder went, which holds while the doubled remainder fits: hence the limits 2^23 and
 4587 2BAE ~                ; 2^31. From 2^31 the quotient is 0 or 1.
 4588 2BAE ~                LD   A,(__x80_rt_b+3)
 4589 2BAE ~                OR   A
 4590 2BAE ~                JP   M,.huge
 4591 2BAE ~                JP   NZ,.g32
 4592 2BAE ~                LD   A,(__x80_rt_b+2)
 4593 2BAE ~                CP   80H
 4594 2BAE ~                JP   NC,.g32
 4595 2BAE ~                CALL .negate_d
 4596 2BAE ~                LD   HL,(__x80_rt_b)
 4597 2BAE ~                LD   B,H
 4598 2BAE ~                LD   C,L
 4599 2BAE ~                LD   A,(__x80_rt_b+2)
 4600 2BAE ~                OR   A
 4601 2BAE ~                LD   E,0
 4602 2BAE ~                JP   NZ,.g24w
 4603 2BAE ~                LD   H,A                ; below 65536: the top byte the remainder, three passes
 4604 2BAE ~                LD   A,(__x80_rt_a+3)
 4605 2BAE ~                LD   L,A
 4606 2BAE ~                XOR  A
 4607 2BAE ~                LD   (__x80_rt_a+3),A
 4608 2BAE ~                LD   A,(__x80_rt_a+2)
 4609 2BAE ~                CALL .g24byte
 4610 2BAE ~                LD   (__x80_rt_a+2),A
 4611 2BAE ~                JP   .g24two
 4612 2BAE ~            .g24w:
 4613 2BAE ~                LD   HL,(__x80_rt_a+2)  ; 65536 or more: the top word the remainder, two passes
 4614 2BAE ~                XOR  A
 4615 2BAE ~                LD   (__x80_rt_a+3),A
 4616 2BAE ~                LD   (__x80_rt_a+2),A
 4617 2BAE ~            .g24two:
 4618 2BAE ~                LD   A,(__x80_rt_a+1)
 4619 2BAE ~                CALL .g24byte
 4620 2BAE ~                LD   (__x80_rt_a+1),A
 4621 2BAE ~                LD   A,(__x80_rt_a)
 4622 2BAE ~                CALL .g24byte
 4623 2BAE ~                LD   (__x80_rt_a),A
 4624 2BAE ~                LD   (__x80_rt_r),HL
 4625 2BAE ~                LD   L,E
 4626 2BAE ~                LD   H,0
 4627 2BAE ~                LD   (__x80_rt_r+2),HL
 4628 2BAE ~                RET
 4629 2BAE ~
 4630 2BAE ~            ; A pass, the remainder twenty-four bits: E:HL = R, below the divisor; A = the next byte of the
 4631 2BAE ~            ; dividend. Returns the quotient's byte of R * 256 + A in A, the remainder in E:HL.
 4632 2BAE ~            .g24byte:
 4633 2BAE ~                PUSH AF
 4634 2BAE ~                LD   D,A
 4635 2BAE ~                LD   A,E                ; the remainder below 65536, and R * 256 + the byte below d: no
 4636 2BAE ~                OR   A                  ; quotient here, the byte only moved in -- most of a pass saved
 4637 2BAE ~                JP   NZ,.g24go          ; when the quotient is short
 4638 2BAE ~                LD   A,(__x80_rt_r)
 4639 2BAE ~                ADD  A,D
 4640 2BAE ~                LD   A,(__x80_rt_r+1)
 4641 2BAE ~                ADC  A,L
 4642 2BAE ~                LD   A,(__x80_rt_r+2)
 4643 2BAE ~                ADC  A,H
 4644 2BAE ~                JP   C,.g24go
 4645 2BAE ~                POP  AF
 4646 2BAE ~                LD   E,H
 4647 2BAE ~                LD   H,L
 4648 2BAE ~                LD   L,A
 4649 2BAE ~                XOR  A
 4650 2BAE ~                RET
 4651 2BAE ~            .g24go:
 4652 2BAE ~                LD   D,1                ; the sentinel
 4653 2BAE ~            .g24s:
 4654 2BAE ~                ADD  HL,HL              ; the remainder not below zero: doubled, and d taken off
 4655 2BAE ~                LD   A,E
 4656 2BAE ~                ADC  A,A
 4657 2BAE ~                LD   E,A
 4658 2BAE ~                LD   A,(__x80_rt_r)
 4659 2BAE ~                ADD  A,L
 4660 2BAE ~                LD   L,A
 4661 2BAE ~                LD   A,(__x80_rt_r+1)
 4662 2BAE ~                ADC  A,H
 4663 2BAE ~                LD   H,A
 4664 2BAE ~                LD   A,(__x80_rt_r+2)
 4665 2BAE ~                ADC  A,E
 4666 2BAE ~                LD   E,A
 4667 2BAE ~            .g24q:
 4668 2BAE ~                LD   A,D                ; the carry the quotient's bit
