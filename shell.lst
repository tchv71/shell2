 8239 2C43
 8240 2C43                  IFUSED __x80_call_hl
 8241 2C43 ~            ; ---------------------------------------------------------------------------
 8242 2C43 ~            ; Calls the address in HL, for a call through a pointer that gives HL to no
 8243 2C43 ~            ; argument: CALL here and JP (HL), the callee's RET coming back to the caller.
 8244 2C43 ~            ; Five T-states against __x80_call_bc's twenty-one, and the address is most
 8245 2C43 ~            ; often in HL already. A call in the last place, CALL / RET, is a jump here, and
 8246 2C43 ~            ; the compiler writes JP (HL) itself (emit.c) -- not in an interrupt's code,
 8247 2C43 ~            ; whose copy of this turns the address into the function's copy first
 8248 2C43 ~            ; (marinovsoft, zx-pk.ru).
 8249 2C43 ~            ; ---------------------------------------------------------------------------
 8250 2C43 ~            __x80_call_hl:
 8251 2C43 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8252 2C43 ~                JP   (HL)
 8253 2C43                  ENDIF
 8254 2C43
 8255 2C43                  IFUSED __x80_call_bc
 8256 2C43
 8257 2C43              ; ---------------------------------------------------------------------------
 8258 2C43              ; Calls the address in BC. The processor has no indirect CALL, and this is the
 8259 2C43              ; cheapest stand-in that clobbers nothing: PUSH BC puts the target on the stack
 8260 2C43              ; above the return address the caller's CALL pushed, RET jumps to it, and the
 8261 2C43              ; callee's own RET then finds the caller's address underneath and comes back.
 8262 2C43              ;
 8263 2C43              ; BC because the convention offers the pairs to arguments in the order HL, DE,
 8264 2C43              ; BC, so this is the one least likely to be wanted for something else. JP (HL)
 8265 2C43              ; would be five T-states rather than twenty-one, but HL is the first pair an
 8266 2C43              ; argument gets.
 8267 2C43              ; ---------------------------------------------------------------------------
 8268 2C43              __x80_call_bc:
 8269 2C43              ;@irq    PUSH HL             ; an interrupt's copy: to the function's copy (__x80_xlat)
 8270 2C43              ;@irq    LD   H,B
 8271 2C43              ;@irq    LD   L,C
 8272 2C43              ;@irq    CALL __x80_xlat
 8273 2C43              ;@irq    LD   B,H
 8274 2C43              ;@irq    LD   C,L
 8275 2C43              ;@irq    POP  HL
 8276 2C43 C5               PUSH BC
 8277 2C44 C9               RET
 8278 2C45                  ENDIF
 8279 2C45
 8280 2C45                  IFUSED __x80_call_mem
 8281 2C45 ~            ; ---------------------------------------------------------------------------
 8282 2C45 ~            ; Calls the address in __x80_call_target, for a call through a pointer whose
 8283 2C45 ~            ; arguments fill HL, DE and BC: the address could go in no register. EX (SP),HL
 8284 2C45 ~            ; puts it on the stack and gives HL back, and RET jumps to it with the caller's
 8285 2C45 ~            ; return address underneath. Forty-three T-states.
 8286 2C45 ~            ; ---------------------------------------------------------------------------
 8287 2C45 ~            __x80_call_mem:
 8288 2C45 ~                PUSH HL
 8289 2C45 ~                LD   HL,(__x80_call_target)
 8290 2C45 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8291 2C45 ~                EX   (SP),HL
 8292 2C45 ~                RET
 8293 2C45                  ENDIF
 8294 2C45
 8295 2C45                  IFUSED _setjmp
 8296 2C45 ~            ; ---------------------------------------------------------------------------
 8297 2C45 ~            ; setjmp(env), env in HL (lib/include/setjmp.h): the return address, and the
 8298 2C45 ~            ; stack pointer as it will be once this returns. Every register is the caller's
 8299 2C45 ~            ; to save, so those two words are all there is.
 8300 2C45 ~            ; ---------------------------------------------------------------------------
 8301 2C45 ~            _setjmp:
 8302 2C45 ~                POP  DE             ; the return address
 8303 2C45 ~                PUSH DE
 8304 2C45 ~                LD   (HL),E
 8305 2C45 ~                INC  HL
 8306 2C45 ~                LD   (HL),D
 8307 2C45 ~                INC  HL
 8308 2C45 ~                EX   DE,HL          ; DE -> the second word
 8309 2C45 ~                LD   HL,2
 8310 2C45 ~                ADD  HL,SP          ; the caller's SP after the return
 8311 2C45 ~                EX   DE,HL
 8312 2C45 ~                LD   (HL),E
 8313 2C45 ~                INC  HL
 8314 2C45 ~                LD   (HL),D
 8315 2C45 ~                LD   HL,0
 8316 2C45 ~                RET
 8317 2C45                  ENDIF
 8318 2C45
 8319 2C45                  IFUSED _longjmp
 8320 2C45 ~            ; ---------------------------------------------------------------------------
 8321 2C45 ~            ; longjmp(env, val), env in HL and val in DE: back to where setjmp returned,
 8322 2C45 ~            ; returning val there -- or 1, if val is 0.
 8323 2C45 ~            ; ---------------------------------------------------------------------------
 8324 2C45 ~            _longjmp:
 8325 2C45 ~                LD   A,D
 8326 2C45 ~                OR   E
 8327 2C45 ~                JP   NZ,.value
 8328 2C45 ~                INC  DE
 8329 2C45 ~            .value:
 8330 2C45 ~                LD   C,(HL)
 8331 2C45 ~                INC  HL
 8332 2C45 ~                LD   B,(HL)         ; BC = where to go
 8333 2C45 ~                INC  HL
 8334 2C45 ~                LD   A,(HL)
 8335 2C45 ~                INC  HL
 8336 2C45 ~                LD   H,(HL)
 8337 2C45 ~                LD   L,A
 8338 2C45 ~                LD   SP,HL          ; the stack as setjmp's caller had it
 8339 2C45 ~                EX   DE,HL          ; the value, in HL
 8340 2C45 ~                PUSH BC
 8341 2C45 ~                RET
 8342 2C45                  ENDIF
 8343 2C45
 8344 2C45                  IFUSED __x80_sp
 8345 2C45 ~            ; ---------------------------------------------------------------------------
 8346 2C45 ~            ; The stack pointer, in HL: where the C library's heap has to stop. Its own
 8347 2C45 ~            ; return address is on the stack, so the caller sees two bytes less than it had.
 8348 2C45 ~            ; ---------------------------------------------------------------------------
 8349 2C45 ~            __x80_sp:
 8350 2C45 ~                LD   HL,0
 8351 2C45 ~                ADD  HL,SP
 8352 2C45 ~                RET
 8353 2C45                  ENDIF
 8354 2C45
 8355 2C45              ;@shared
 8356 2C45                  IFNDEF X80_EXIT_DEFINED
 8357 2C45                  IFUSED __x80_exit
 8358 2C45 ~            ; ---------------------------------------------------------------------------
 8359 2C45 ~            ; How a program ends when it calls exit, _Exit or abort, the status in HL. On
 8360 2C45 ~            ; the machine there is nobody to tell, so it halts; a test platform defines
 8361 2C45 ~            ; __x80_exit itself, before this file, with DEFINE X80_EXIT_DEFINED -- IFNDEF
 8362 2C45 ~            ; tests DEFINEs, not labels -- and reports the status instead
 8363 2C45 ~            ; (lib/crt/test_start.asm).
 8364 2C45 ~            ; ---------------------------------------------------------------------------
 8365 2C45 ~            __x80_exit:
 8366 2C45 ~                JP   __x80_halt
 8367 2C45                  ENDIF
 8368 2C45                  ENDIF
 8369 2C45
 8370 2C45                  IFUSED __x80_halt
 8371 2C45 ~            ; ---------------------------------------------------------------------------
 8372 2C45 ~            ; The end of a program that stops itself: exit, abort. HALT, and HALT again if
 8373 2C45 ~            ; an interrupt wakes it -- there is nothing to return to.
 8374 2C45 ~            ; ---------------------------------------------------------------------------
 8375 2C45 ~            __x80_halt:
 8376 2C45 ~                HALT
 8377 2C45 ~                JP   __x80_halt
 8378 2C45                  ENDIF
 8379 2C45              ;@end
 8380 2C45
 8381 2C45                  IFUSED __x80_rt_a
 8382 2C45              ; ---------------------------------------------------------------------------
 8383 2C45              ; Working space, for division. Like every object that starts as zeros, not in the image: an
 8384 2C45              ; address below __x80_bss_top that the startup code clears.
 8385 2C45              ; ---------------------------------------------------------------------------
 8386 2C45              __x80_bss_off = __x80_bss_off + 4
 8387 2C45              __x80_rt_a EQU __x80_bss_top - __x80_bss_off      ; the dividend, then the quotient
 8388 2C45                  ENDIF
 8389 2C45
 8390 2C45                  IFUSED __x80_rt_b
 8391 2C45              __x80_bss_off = __x80_bss_off + 4
 8392 2C45              __x80_rt_b EQU __x80_bss_top - __x80_bss_off      ; the divisor
 8393 2C45                  ENDIF
 8394 2C45
 8395 2C45                  IFUSED __x80_rt_r
 8396 2C45              __x80_bss_off = __x80_bss_off + 4
 8397 2C45              __x80_rt_r EQU __x80_bss_top - __x80_bss_off      ; the remainder
 8398 2C45                  ENDIF
 8399 2C45
 8400 2C45                  IFUSED __x80_rt_sign
 8401 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8402 2C45 ~            __x80_rt_sign EQU __x80_bss_top - __x80_bss_off      ; the sign the result should end up with
 8403 2C45                  ENDIF
 8404 2C45
 8405 2C45                  IFUSED __x80_rt_lo
 8406 2C45 ~            __x80_bss_off = __x80_bss_off + 2
 8407 2C45 ~            __x80_rt_lo EQU __x80_bss_top - __x80_bss_off      ; the low word of a product, while the high one is summed
 8408 2C45                  ENDIF
 8409 2C45
 8410 2C45                  IFUSED __x80_call_target
 8411 2C45 ~            __x80_bss_off = __x80_bss_off + 2
 8412 2C45 ~            __x80_call_target EQU __x80_bss_top - __x80_bss_off  ; the address __x80_call_mem calls
 8413 2C45                  ENDIF
 8414 2C45
 8415 2C45                  IFUSED __x80_sp_save
 8416 2C45 ~            __x80_bss_off = __x80_bss_off + 2
 8417 2C45 ~            __x80_sp_save EQU __x80_bss_top - __x80_bss_off  ; -mstack-copy: SP, while it is the pointer
 8418 2C45                  ENDIF
 8419 2C45
 8420 2C45              ; Working space, for double.
 8421 2C45                  IFUSED __x80_dsg
 8422 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8423 2C45 ~            __x80_dsg EQU __x80_bss_top - __x80_bss_off      ; the result's sign, in bit 7
 8424 2C45                  ENDIF
 8425 2C45
 8426 2C45                  IFUSED __x80_dx
 8427 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8428 2C45 ~            __x80_dx EQU __x80_bss_top - __x80_bss_off      ; a flip of b's sign, then a subtraction
 8429 2C45                  ENDIF
 8430 2C45
 8431 2C45                  IFUSED __x80_dexp
 8432 2C45 ~            __x80_bss_off = __x80_bss_off + 2
 8433 2C45 ~            __x80_dexp EQU __x80_bss_top - __x80_bss_off      ; an exponent
 8434 2C45                  ENDIF
 8435 2C45
 8436 2C45              ; Working space, for float.
 8437 2C45                  IFUSED __x80_fpa
 8438 2C45 ~            __x80_bss_off = __x80_bss_off + 4
 8439 2C45 ~            __x80_fpa EQU __x80_bss_top - __x80_bss_off      ; the first operand, then its significand
 8440 2C45                  ENDIF
 8441 2C45
 8442 2C45                  IFUSED __x80_fpb
 8443 2C45 ~            __x80_bss_off = __x80_bss_off + 4
 8444 2C45 ~            __x80_fpb EQU __x80_bss_top - __x80_bss_off      ; the second operand, then its significand
 8445 2C45                  ENDIF
 8446 2C45
 8447 2C45                  IFUSED __x80_fpp
 8448 2C45 ~            __x80_bss_off = __x80_bss_off + 6
 8449 2C45 ~            __x80_fpp EQU __x80_bss_top - __x80_bss_off      ; a product of significands, forty-eight bits
 8450 2C45                  ENDIF
 8451 2C45
 8452 2C45                  IFUSED __x80_fps
 8453 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8454 2C45 ~            __x80_fps EQU __x80_bss_top - __x80_bss_off      ; the result's sign, in bit 7
 8455 2C45                  ENDIF
 8456 2C45
 8457 2C45                  IFUSED __x80_fpx
 8458 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8459 2C45 ~            __x80_fpx EQU __x80_bss_top - __x80_bss_off      ; a flip of b's sign, a subtraction, a quotient byte
 8460 2C45                  ENDIF
 8461 2C45
 8462 2C45                  IFUSED __x80_fpe
 8463 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8464 2C45 ~            __x80_fpe EQU __x80_bss_top - __x80_bss_off      ; an exponent, a count
 8465 2C45                  ENDIF
 8466 2C45
 8467 2C45              ; Working space, for sixty-four bits.
 8468 2C45                  IFUSED __x80_qa
 8469 2C45 ~            __x80_bss_off = __x80_bss_off + 8
 8470 2C45 ~            __x80_qa EQU __x80_bss_top - __x80_bss_off      ; the first operand, the product's multiplicand, the quotient
 8471 2C45                  ENDIF
 8472 2C45
 8473 2C45                  IFUSED __x80_qb
 8474 2C45 ~            __x80_bss_off = __x80_bss_off + 8
 8475 2C45 ~            __x80_qb EQU __x80_bss_top - __x80_bss_off      ; the second operand
 8476 2C45                  ENDIF
 8477 2C45
 8478 2C45                  IFUSED __x80_qr
 8479 2C45 ~            __x80_bss_off = __x80_bss_off + 8
 8480 2C45 ~            __x80_qr EQU __x80_bss_top - __x80_bss_off      ; the product, the remainder
 8481 2C45                  ENDIF
 8482 2C45
 8483 2C45                  IFUSED __x80_qn
 8484 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8485 2C45 ~            __x80_qn EQU __x80_bss_top - __x80_bss_off      ; the loop counter
 8486 2C45                  ENDIF
 8487 2C45
 8488 2C45                  IFUSED __x80_qst
 8489 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8490 2C45 ~            __x80_qst EQU __x80_bss_top - __x80_bss_off      ; a product's sticky bit
 8491 2C45                  ENDIF
 8492 2C45
 8493 2C45                  IFUSED __x80_qsign
 8494 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8495 2C45 ~            __x80_qsign EQU __x80_bss_top - __x80_bss_off      ; the sign the result should end up with
 8496 2C45                  ENDIF
 8497 2C45
 8498 2C45                  IFUSED __x80_qpa
 8499 2C45 ~            __x80_bss_off = __x80_bss_off + 2
 8500 2C45 ~            __x80_qpa EQU __x80_bss_top - __x80_bss_off      ; where the result goes
 8501 2C45                  ENDIF
 8502 2C45
 8503 2C45              ;@shared
 8504 2C45              ; main's argv: no arguments, so argv[0], which is argv[argc], is the null pointer.
 8505 2C45                  IFUSED __x80_argv
 8506 2C45 ~            __x80_argv: DEFW 0
 8507 2C45                  ENDIF
 8508 2C45              ;@end
 8509 2C45
 8510 2C45              ; printf's floating-point conversions (lib/libc/stdio.c) are reached through this
 8511 2C45              ; word: the address of __x80_format_double when the program passes a floating
 8512 2C45              ; value to a function with `...` -- the compiler then names __x80_float_varargs
 8513 2C45              ; in an EQU, which is what IFUSED counts -- and zero otherwise, so that a program
 8514 2C45              ; printing only integers does not carry them.
 8515 2C45              ;@shared
 8516 2C45              __x80_float_varargs EQU 0
 8517 2C45              ;@end
 8518 2C45
 8519 2C45                  IFUSED __x80_printf_float
 8520 2C45 ~            __x80_printf_float:
 8521 2C45 ~                IFUSED __x80_float_varargs
 8522 2C45 ~                DEFW __x80_format_double
 8523 2C45 ~                ELSE
 8524 2C45 ~                DEFW 0
 8525 2C45 ~                ENDIF
 8526 2C45                  ENDIF
 8527 2C45
 8528 2C45              ; And the same for printf's 64-bit integers, %lld and its kind: __x80_format_ll when the program
 8529 2C45              ; passes a 64-bit integer to a function with `...` (__x80_ll_varargs), zero otherwise.
 8530 2C45              ;@shared
 8531 2C45              __x80_ll_varargs EQU 0
 8532 2C45              ;@end
 8533 2C45
 8534 2C45                  IFUSED __x80_printf_ll
 8535 2C45 ~            __x80_printf_ll:
 8536 2C45 ~                IFUSED __x80_ll_varargs
 8537 2C45 ~                DEFW __x80_format_ll
 8538 2C45 ~                ELSE
 8539 2C45 ~                DEFW 0
 8540 2C45 ~                ENDIF
 8541 2C45                  ENDIF
 8542 2C45
 8543 2C45              ; Where the characters of a written-out printf go (lib/libc/stdio.c, pw_out): to putchar, the
 8544 2C45              ; character in L -- or, in a program that has sprintf or snprintf written out, which is what uses
 8545 2C45              ; __x80_put_to, into the buffer while __x80_pw_mode is set. A program that only prints carries the
 8546 2C45              ; JP alone.
 8547 2C45                  IFUSED __x80_pw_out
 8548 2C45 ~            __x80_pw_out:
 8549 2C45 ~                IFUSED __x80_put_to
 8550 2C45 ~                LD   A,(__x80_pw_mode)
 8551 2C45 ~                OR   A
 8552 2C45 ~                JP   NZ,__x80_pw_buffer
 8553 2C45 ~                ENDIF
 8554 2C45 ~                JP   _putchar
 8555 2C45                  ENDIF
 8556 2C45                  IFUSED __x80_pw_mode
 8557 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8558 2C45 ~            __x80_pw_mode EQU __x80_bss_top - __x80_bss_off   ; sprintf's buffer is where the characters go
 8559 2C45                  ENDIF
 8560 2C45
 8561 2C45              ; The Вектор-06Ц's frame hook, vc_on_frame, which its board support package's interrupt handler
 8562 2C45              ; calls (lib/bsp/vector06c.c): nothing, unless the program defines its own. The compiler marks
 8563 2C45              ; every definition it writes with DEFINE __X80_DEF_name -- the way the C library gives way to the
 8564 2C45              ; program -- and this file is assembled after the program, so the mark has been seen. Here and not
 8565 2C45              ; in the Вектор's startup code because that is assembled first, before the mark.
 8566 2C45              ;@shared
 8567 2C45                  IFUSED _vc_on_frame
 8568 2C45 ~                IFNDEF __X80_DEF_vc_on_frame
 8569 2C45 ~            _vc_on_frame:
 8570 2C45 ~                RET
 8571 2C45 ~                ENDIF
 8572 2C45                  ENDIF
 8573 2C45              ;@end
 8574 2C45
 8575 2C45              ; A call through a pointer in an interrupt's code: a pointer is always the
 8576 2C45              ; program's function, and the copy of __x80_call_hl, __x80_call_bc or __x80_call_mem turns it into the
 8577 2C45              ; function's copy for interrupts before it calls. Each module that has functions whose address is
 8578 2C45              ; taken, and copies of them, writes a segment of pairs -- DEFW the function, its copy -- ended by
 8579 2C45              ; a zero word and preceded by the segment before it, __x80_xlat_head as it was; the last one is
 8580 2C45              ; __x80_xlat_last. Kept only when something calls through a pointer in an interrupt, and so
 8581 2C45              ; names __x80_xlat. HL the address, and the copy's back in it, or the address as it was -- a
 8582 2C45              ; function written in assembly, which has none; every other register kept.
 8583 2C45              ;@shared
 8584 2C45                  IFUSED __x80_xlat
 8585 2C45 ~            __x80_xlat:
 8586 2C45 ~                PUSH AF
 8587 2C45 ~                PUSH BC
 8588 2C45 ~                PUSH DE
 8589 2C45 ~                EX   DE,HL              ; DE the address
 8590 2C45 ~                LD   HL,__x80_xlat_last
 8591 2C45 ~            .segment:
 8592 2C45 ~                LD   A,H
 8593 2C45 ~                OR   L
 8594 2C45 ~                JP   Z,.done
 8595 2C45 ~                LD   C,(HL)
 8596 2C45 ~                INC  HL
 8597 2C45 ~                LD   B,(HL)             ; BC the segment before
 8598 2C45 ~                INC  HL
 8599 2C45 ~            .entry:
 8600 2C45 ~                LD   A,(HL)
 8601 2C45 ~                INC  HL
 8602 2C45 ~                OR   (HL)
 8603 2C45 ~                JP   Z,.end             ; the zero word
 8604 2C45 ~                DEC  HL
 8605 2C45 ~                LD   A,(HL)
 8606 2C45 ~                CP   E
 8607 2C45 ~                INC  HL
 8608 2C45 ~                JP   NZ,.skip
 8609 2C45 ~                LD   A,(HL)
 8610 2C45 ~                CP   D
 8611 2C45 ~                JP   Z,.found
 8612 2C45 ~            .skip:
 8613 2C45 ~                INC  HL
 8614 2C45 ~                INC  HL
 8615 2C45 ~                INC  HL
 8616 2C45 ~                JP   .entry
 8617 2C45 ~            .found:
 8618 2C45 ~                INC  HL
 8619 2C45 ~                LD   E,(HL)
 8620 2C45 ~                INC  HL
 8621 2C45 ~                LD   D,(HL)             ; DE the copy
 8622 2C45 ~                JP   .done
 8623 2C45 ~            .end:
 8624 2C45 ~                LD   H,B
 8625 2C45 ~                LD   L,C
 8626 2C45 ~                JP   .segment
 8627 2C45 ~            .done:
 8628 2C45 ~                EX   DE,HL
 8629 2C45 ~                POP  DE
 8630 2C45 ~                POP  BC
 8631 2C45 ~                POP  AF
 8632 2C45 ~                RET
 8633 2C45                  ENDIF
 8634 2C45              ;@end
 8635 2C45
 8636 2C45              ; The library's critical sections (lib/libc/critical.h), in a program whose interrupt handlers call
 8637 2C45              ; the library: __x80_busy counts the sections the program is in, and an interrupt's entry that
 8638 2C45              ; finds it set leaves its address in __x80_pending and returns at once. The end of the outermost
 8639 2C45              ; section calls __x80_run_deferred, which runs that entry as the interrupt would have: interrupts
 8640 2C45              ; off, and on again after -- they were on, or it would not have come, and the program has been in
 8641 2C45              ; the library since. Every register kept.
 8642 2C45              ;@shared
 8643 2C45                  IFUSED __x80_busy
 8644 2C45 ~            __x80_bss_off = __x80_bss_off + 1
 8645 2C45 ~            __x80_busy EQU __x80_bss_top - __x80_bss_off
 8646 2C45                  ENDIF
 8647 2C45                  IFUSED __x80_pending
 8648 2C45 ~            __x80_bss_off = __x80_bss_off + 2
 8649 2C45 ~            __x80_pending EQU __x80_bss_top - __x80_bss_off
 8650 2C45                  ENDIF
 8651 2C45                  IFUSED __x80_run_deferred
 8652 2C45 ~            __x80_run_deferred:
 8653 2C45 ~                PUSH AF
 8654 2C45 ~                PUSH HL
 8655 2C45 ~                LD   HL,(__x80_pending)
 8656 2C45 ~                LD   A,H
 8657 2C45 ~                OR   L
 8658 2C45 ~                JP   Z,.done
 8659 2C45 ~                PUSH BC
 8660 2C45 ~                PUSH DE
 8661 2C45 ~                PUSH HL
 8662 2C45 ~                LD   HL,0
 8663 2C45 ~                LD   (__x80_pending),HL
 8664 2C45 ~                POP  HL
 8665 2C45 ~                DI
 8666 2C45 ~                CALL .go
 8667 2C45 ~                EI
 8668 2C45 ~                POP  DE
 8669 2C45 ~                POP  BC
 8670 2C45 ~            .done:
 8671 2C45 ~                POP  HL
 8672 2C45 ~                POP  AF
 8673 2C45 ~                RET
 8674 2C45 ~            .go:
 8675 2C45 ~                JP   (HL)
 8676 2C45                  ENDIF
 8677 2C45              ;@end
 8678 2C45
 8679 2C45              ; The end of everything assembled, and so of the image: the C library's heap starts here. And
 8680 2C45              ; how much the objects the program starts with zeroed take: they are not in the image but at the
 8681 2C45              ; top of memory, each file handing out addresses down from __x80_bss_top as it defines them
 8682 2C45              ; and the startup code clears them and puts the stack below them. Last in the
 8683 2C45              ; file, and this file last on the assembler's command line.
 8684 2C45              ;@shared
 8685 2C45                  IFUSED __x80_xlat
 8686 2C45 ~            __x80_xlat_last EQU __x80_xlat_head
 8687 2C45                  ENDIF
 8688 2C45              __x80_bss_size EQU __x80_bss_off
 8689 2C45                  ; --target=bin --no-startup (lib/crt/bin_start.asm): no startup to clear them, so they are
 8690 2C45                  ; zeros in the image, here at its end, and __x80_bss_top is the end of these.
 8691 2C45                  IFDEF X80_BSS_IN_IMAGE
 8692 2C45              __x80_bss_image:
 8693 2C45                  IF __x80_bss_size
 8694 2C45 00 00 00...      DEFS __x80_bss_size
 8695 2FAF                  ENDIF
 8696 2FAF                  ENDIF
 8697 2FAF                  IFUSED __x80_heap
 8698 2FAF ~            __x80_heap:
 8699 2FAF                  ENDIF
 8700 2FAF              ;@end
 8701 2FAF
