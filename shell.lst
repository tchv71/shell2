 1909 2ABC ~                JP   NC,.normal
 1910 2ABC ~                ELSE
 1911 2ABC ~                ; Two normal numbers, as __x80_fadd takes them: the low words to fpa and fpb, the high words
 1912 2ABC ~                ; read where they come, the leading ones put in and the exponents' sum made in registers.
 1913 2ABC ~                ; Anything else goes the general way, everything stored as __x80_fp_load2 would have.
 1914 2ABC ~                LD   (__x80_fpa),HL
 1915 2ABC ~                LD   H,B
 1916 2ABC ~                LD   L,C
 1917 2ABC ~                LD   (__x80_fpb),HL
