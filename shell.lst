 5007 2BB0 ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 2BB0 ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 2BB0 ~                LD   D,A
