 3587 2ABB ~                CALL __x80_q_signed
 3588 2ABB ~                LD   HL,__x80_qr
 3589 2ABB ~                CALL Z,__x80_q_negate
 3590 2ABB ~                LD   HL,__x80_qr
 3591 2ABB ~                JP   __x80_q_give
 3592 2ABB                  ENDIF
