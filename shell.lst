 1483 2ABC ~                LD   H,(HL)
 1484 2ABC ~                LD   L,A                ; b's high word
 1485 2ABC ~                LD   A,E
 1486 2ABC ~                ADD  A,A
 1487 2ABC ~                LD   A,D
 1488 2ABC ~                ADC  A,A
 1489 2ABC ~                LD   C,A                ; a's exponent field
 1490 2ABC ~                INC  A
 1491 2ABC ~                CP   2
 1492 2ABC ~                JP   C,.slow            ; 0 or 255
 1493 2ABC ~                LD   A,L
 1494 2ABC ~                ADD  A,A
 1495 2ABC ~                LD   A,H
