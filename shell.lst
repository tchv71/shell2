 2269 2ABB ~                SUB  C
 2270 2ABB ~                LD   C,A
 2271 2ABB ~                LD   A,0
 2272 2ABB ~                SBC  A,B
 2273 2ABB ~                LD   B,A
 2274 2ABB ~                LD   A,B
 2275 2ABB ~                OR   C
 2276 2ABB ~                JP   NZ,.negated
 2277 2ABB ~                DEC  D                  ; d_lo = 0: d as D - 1 and a low word of 65536
 2278 2ABB ~            .negated:
 2279 2ABB ~                POP  AF
 2280 2ABB ~                LD   A,E
 2281 2ABB ~                JP   NC,.step           ; the carry clear
 2282 2ABB ~                EX   (SP),HL
 2283 2ABB ~                DEC  HL
 2284 2ABB ~                EX   (SP),HL
 2285 2ABB ~                IFDEF X80_OPT_SPEED
