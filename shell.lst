 3314 2ABC ~                RRA
 3315 2ABC ~                JP   NC,.pack
 3316 2ABC ~            .up:
 3317 2ABC ~                INC  H
 3318 2ABC ~                JP   NZ,.pack
 3319 2ABC ~                INC  E
 3320 2ABC ~                JP   NZ,.pack
 3321 2ABC ~                INC  D
 3322 2ABC ~                JP   NZ,.pack
 3323 2ABC ~                LD   D,80H              ; 2.0: 1.0 at the next exponent
 3324 2ABC ~                INC  C
