 6202 2C3E ~                JP   C,.up
 6203 2C3E ~                JP   NZ,.far            ; the high byte of d - s
 6204 2C3E ~                LD   A,L
 6205 2C3E ~                SUB  E
 6206 2C3E ~                CP   X80_SP_RESERVE + 16
 6207 2C3E ~                JP   C,.near
 6208 2C3E ~            .far:
 6209 2C3E ~                LD   A,B
