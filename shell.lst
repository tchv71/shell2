 1583 2ABB ~                INC  A
 1584 2ABB ~                JP   Z,.special         ; all ones: an infinity or a NaN
 1585 2ABB ~                LD   A,B
 1586 2ABB ~                INC  A
 1587 2ABB ~                JP   Z,.special
