 8503 2C68              ;@shared
 8504 2C68              ; main's argv: no arguments, so argv[0], which is argv[argc], is the null pointer.
 8505 2C68                  IFUSED __x80_argv
 8506 2C68 ~            __x80_argv: DEFW 0
 8507 2C68                  ENDIF
 8508 2C68              ;@end
 8509 2C68
 8510 2C68              ; printf's floating-point conversions (lib/libc/stdio.c) are reached through this
 8511 2C68              ; word: the address of __x80_format_double when the program passes a floating
 8512 2C68              ; value to a function with `...` -- the compiler then names __x80_float_varargs
 8513 2C68              ; in an EQU, which is what IFUSED counts -- and zero otherwise, so that a program
 8514 2C68              ; printing only integers does not carry them.
 8515 2C68              ;@shared
 8516 2C68              __x80_float_varargs EQU 0
 8517 2C68              ;@end
 8518 2C68
 8519 2C68                  IFUSED __x80_printf_float
 8520 2C68 ~            __x80_printf_float:
 8521 2C68 ~                IFUSED __x80_float_varargs
 8522 2C68 ~                DEFW __x80_format_double
 8523 2C68 ~                ELSE
 8524 2C68 ~                DEFW 0
 8525 2C68 ~                ENDIF
 8526 2C68                  ENDIF
 8527 2C68
 8528 2C68              ; And the same for printf's 64-bit integers, %lld and its kind: __x80_format_ll when the program
 8529 2C68              ; passes a 64-bit integer to a function with `...` (__x80_ll_varargs), zero otherwise.
 8530 2C68              ;@shared
 8531 2C68              __x80_ll_varargs EQU 0
 8532 2C68              ;@end
 8533 2C68
 8534 2C68                  IFUSED __x80_printf_ll
 8535 2C68 ~            __x80_printf_ll:
 8536 2C68 ~                IFUSED __x80_ll_varargs
 8537 2C68 ~                DEFW __x80_format_ll
 8538 2C68 ~                ELSE
 8539 2C68 ~                DEFW 0
 8540 2C68 ~                ENDIF
 8541 2C68                  ENDIF
 8542 2C68
 8543 2C68              ; Where the characters of a written-out printf go (lib/libc/stdio.c, pw_out): to putchar, the
 8544 2C68              ; character in L -- or, in a program that has sprintf or snprintf written out, which is what uses
 8545 2C68              ; __x80_put_to, into the buffer while __x80_pw_mode is set. A program that only prints carries the
 8546 2C68              ; JP alone.
 8547 2C68                  IFUSED __x80_pw_out
 8548 2C68 ~            __x80_pw_out:
 8549 2C68 ~                IFUSED __x80_put_to
 8550 2C68 ~                LD   A,(__x80_pw_mode)
 8551 2C68 ~                OR   A
 8552 2C68 ~                JP   NZ,__x80_pw_buffer
 8553 2C68 ~                ENDIF
 8554 2C68 ~                JP   _putchar
 8555 2C68                  ENDIF
 8556 2C68                  IFUSED __x80_pw_mode
 8557 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8558 2C68 ~            __x80_pw_mode EQU __x80_bss_top - __x80_bss_off   ; sprintf's buffer is where the characters go
 8559 2C68                  ENDIF
 8560 2C68
 8561 2C68              ; The Вектор-06Ц's frame hook, vc_on_frame, which its board support package's interrupt handler
 8562 2C68              ; calls (lib/bsp/vector06c.c): nothing, unless the program defines its own. The compiler marks
 8563 2C68              ; every definition it writes with DEFINE __X80_DEF_name -- the way the C library gives way to the
 8564 2C68              ; program -- and this file is assembled after the program, so the mark has been seen. Here and not
 8565 2C68              ; in the Вектор's startup code because that is assembled first, before the mark.
 8566 2C68              ;@shared
 8567 2C68                  IFUSED _vc_on_frame
 8568 2C68 ~                IFNDEF __X80_DEF_vc_on_frame
 8569 2C68 ~            _vc_on_frame:
 8570 2C68 ~                RET
 8571 2C68 ~                ENDIF
 8572 2C68                  ENDIF
 8573 2C68              ;@end
 8574 2C68
 8575 2C68              ; A call through a pointer in an interrupt's code: a pointer is always the
 8576 2C68              ; program's function, and the copy of __x80_call_hl, __x80_call_bc or __x80_call_mem turns it into the
 8577 2C68              ; function's copy for interrupts before it calls. Each module that has functions whose address is
 8578 2C68              ; taken, and copies of them, writes a segment of pairs -- DEFW the function, its copy -- ended by
 8579 2C68              ; a zero word and preceded by the segment before it, __x80_xlat_head as it was; the last one is
 8580 2C68              ; __x80_xlat_last. Kept only when something calls through a pointer in an interrupt, and so
 8581 2C68              ; names __x80_xlat. HL the address, and the copy's back in it, or the address as it was -- a
 8582 2C68              ; function written in assembly, which has none; every other register kept.
 8583 2C68              ;@shared
 8584 2C68                  IFUSED __x80_xlat
 8585 2C68 ~            __x80_xlat:
 8586 2C68 ~                PUSH AF
 8587 2C68 ~                PUSH BC
 8588 2C68 ~                PUSH DE
 8589 2C68 ~                EX   DE,HL              ; DE the address
 8590 2C68 ~                LD   HL,__x80_xlat_last
 8591 2C68 ~            .segment:
 8592 2C68 ~                LD   A,H
 8593 2C68 ~                OR   L
 8594 2C68 ~                JP   Z,.done
 8595 2C68 ~                LD   C,(HL)
 8596 2C68 ~                INC  HL
 8597 2C68 ~                LD   B,(HL)             ; BC the segment before
 8598 2C68 ~                INC  HL
 8599 2C68 ~            .entry:
 8600 2C68 ~                LD   A,(HL)
 8601 2C68 ~                INC  HL
 8602 2C68 ~                OR   (HL)
 8603 2C68 ~                JP   Z,.end             ; the zero word
 8604 2C68 ~                DEC  HL
 8605 2C68 ~                LD   A,(HL)
 8606 2C68 ~                CP   E
 8607 2C68 ~                INC  HL
 8608 2C68 ~                JP   NZ,.skip
 8609 2C68 ~                LD   A,(HL)
 8610 2C68 ~                CP   D
 8611 2C68 ~                JP   Z,.found
 8612 2C68 ~            .skip:
 8613 2C68 ~                INC  HL
 8614 2C68 ~                INC  HL
 8615 2C68 ~                INC  HL
 8616 2C68 ~                JP   .entry
 8617 2C68 ~            .found:
 8618 2C68 ~                INC  HL
 8619 2C68 ~                LD   E,(HL)
 8620 2C68 ~                INC  HL
 8621 2C68 ~                LD   D,(HL)             ; DE the copy
 8622 2C68 ~                JP   .done
 8623 2C68 ~            .end:
 8624 2C68 ~                LD   H,B
 8625 2C68 ~                LD   L,C
 8626 2C68 ~                JP   .segment
 8627 2C68 ~            .done:
 8628 2C68 ~                EX   DE,HL
 8629 2C68 ~                POP  DE
 8630 2C68 ~                POP  BC
 8631 2C68 ~                POP  AF
 8632 2C68 ~                RET
 8633 2C68                  ENDIF
 8634 2C68              ;@end
 8635 2C68
 8636 2C68              ; The library's critical sections (lib/libc/critical.h), in a program whose interrupt handlers call
 8637 2C68              ; the library: __x80_busy counts the sections the program is in, and an interrupt's entry that
 8638 2C68              ; finds it set leaves its address in __x80_pending and returns at once. The end of the outermost
 8639 2C68              ; section calls __x80_run_deferred, which runs that entry as the interrupt would have: interrupts
 8640 2C68              ; off, and on again after -- they were on, or it would not have come, and the program has been in
 8641 2C68              ; the library since. Every register kept.
 8642 2C68              ;@shared
 8643 2C68                  IFUSED __x80_busy
 8644 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8645 2C68 ~            __x80_busy EQU __x80_bss_top - __x80_bss_off
 8646 2C68                  ENDIF
 8647 2C68                  IFUSED __x80_pending
 8648 2C68 ~            __x80_bss_off = __x80_bss_off + 2
 8649 2C68 ~            __x80_pending EQU __x80_bss_top - __x80_bss_off
 8650 2C68                  ENDIF
 8651 2C68                  IFUSED __x80_run_deferred
 8652 2C68 ~            __x80_run_deferred:
 8653 2C68 ~                PUSH AF
 8654 2C68 ~                PUSH HL
 8655 2C68 ~                LD   HL,(__x80_pending)
 8656 2C68 ~                LD   A,H
 8657 2C68 ~                OR   L
 8658 2C68 ~                JP   Z,.done
 8659 2C68 ~                PUSH BC
 8660 2C68 ~                PUSH DE
 8661 2C68 ~                PUSH HL
 8662 2C68 ~                LD   HL,0
 8663 2C68 ~                LD   (__x80_pending),HL
 8664 2C68 ~                POP  HL
 8665 2C68 ~                DI
 8666 2C68 ~                CALL .go
 8667 2C68 ~                EI
 8668 2C68 ~                POP  DE
 8669 2C68 ~                POP  BC
 8670 2C68 ~            .done:
 8671 2C68 ~                POP  HL
 8672 2C68 ~                POP  AF
 8673 2C68 ~                RET
 8674 2C68 ~            .go:
 8675 2C68 ~                JP   (HL)
 8676 2C68                  ENDIF
 8677 2C68              ;@end
 8678 2C68
 8679 2C68              ; The end of everything assembled, and so of the image: the C library's heap starts here. And
 8680 2C68              ; how much the objects the program starts with zeroed take: they are not in the image but at the
 8681 2C68              ; top of memory, each file handing out addresses down from __x80_bss_top as it defines them
 8682 2C68              ; and the startup code clears them and puts the stack below them. Last in the
 8683 2C68              ; file, and this file last on the assembler's command line.
 8684 2C68              ;@shared
 8685 2C68                  IFUSED __x80_xlat
 8686 2C68 ~            __x80_xlat_last EQU __x80_xlat_head
 8687 2C68                  ENDIF
 8688 2C68              __x80_bss_size EQU __x80_bss_off
 8689 2C68                  ; --target=bin --no-startup (lib/crt/bin_start.asm): no startup to clear them, so they are
 8690 2C68                  ; zeros in the image, here at its end, and __x80_bss_top is the end of these.
 8691 2C68                  IFDEF X80_BSS_IN_IMAGE
 8692 2C68              __x80_bss_image:
 8693 2C68                  IF __x80_bss_size
 8694 2C68 00 00 00...      DEFS __x80_bss_size
 8695 2FD2                  ENDIF
 8696 2FD2                  ENDIF
 8697 2FD2                  IFUSED __x80_heap
 8698 2FD2 ~            __x80_heap:
 8699 2FD2                  ENDIF
 8700 2FD2              ;@end
 8701 2FD2
# file closed: runtime.asm
# file opened: runtime32.asm
    1 2FD2              ; runtime32.asm -- empty. The thirty-two-bit routines are in runtime.asm, with the sixteen-bit
    2 2FD2              ; ones they call, so that the assembler can leave out whatever a program does not use; see the
    3 2FD2              ; comment at the top of that file. Kept so that command lines naming it still work.
    4 2FD2
