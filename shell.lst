 8240 2C44                  IFUSED __x80_call_hl
 8241 2C44 ~            ; ---------------------------------------------------------------------------
 8242 2C44 ~            ; Calls the address in HL, for a call through a pointer that gives HL to no
 8243 2C44 ~            ; argument: CALL here and JP (HL), the callee's RET coming back to the caller.
 8244 2C44 ~            ; Five T-states against __x80_call_bc's twenty-one, and the address is most
 8245 2C44 ~            ; often in HL already. A call in the last place, CALL / RET, is a jump here, and
 8246 2C44 ~            ; the compiler writes JP (HL) itself (emit.c) -- not in an interrupt's code,
 8247 2C44 ~            ; whose copy of this turns the address into the function's copy first
 8248 2C44 ~            ; (marinovsoft, zx-pk.ru).
 8249 2C44 ~            ; ---------------------------------------------------------------------------
 8250 2C44 ~            __x80_call_hl:
 8251 2C44 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8252 2C44 ~                JP   (HL)
 8253 2C44                  ENDIF
 8254 2C44
 8255 2C44                  IFUSED __x80_call_bc
 8256 2C44
 8257 2C44              ; ---------------------------------------------------------------------------
 8258 2C44              ; Calls the address in BC. The processor has no indirect CALL, and this is the
 8259 2C44              ; cheapest stand-in that clobbers nothing: PUSH BC puts the target on the stack
 8260 2C44              ; above the return address the caller's CALL pushed, RET jumps to it, and the
 8261 2C44              ; callee's own RET then finds the caller's address underneath and comes back.
 8262 2C44              ;
 8263 2C44              ; BC because the convention offers the pairs to arguments in the order HL, DE,
 8264 2C44              ; BC, so this is the one least likely to be wanted for something else. JP (HL)
 8265 2C44              ; would be five T-states rather than twenty-one, but HL is the first pair an
 8266 2C44              ; argument gets.
 8267 2C44              ; ---------------------------------------------------------------------------
 8268 2C44              __x80_call_bc:
 8269 2C44              ;@irq    PUSH HL             ; an interrupt's copy: to the function's copy (__x80_xlat)
 8270 2C44              ;@irq    LD   H,B
 8271 2C44              ;@irq    LD   L,C
 8272 2C44              ;@irq    CALL __x80_xlat
 8273 2C44              ;@irq    LD   B,H
 8274 2C44              ;@irq    LD   C,L
 8275 2C44              ;@irq    POP  HL
 8276 2C44 C5               PUSH BC
 8277 2C45 C9               RET
 8278 2C46                  ENDIF
 8279 2C46
 8280 2C46                  IFUSED __x80_call_mem
 8281 2C46 ~            ; ---------------------------------------------------------------------------
 8282 2C46 ~            ; Calls the address in __x80_call_target, for a call through a pointer whose
 8283 2C46 ~            ; arguments fill HL, DE and BC: the address could go in no register. EX (SP),HL
 8284 2C46 ~            ; puts it on the stack and gives HL back, and RET jumps to it with the caller's
 8285 2C46 ~            ; return address underneath. Forty-three T-states.
 8286 2C46 ~            ; ---------------------------------------------------------------------------
 8287 2C46 ~            __x80_call_mem:
 8288 2C46 ~                PUSH HL
 8289 2C46 ~                LD   HL,(__x80_call_target)
 8290 2C46 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8291 2C46 ~                EX   (SP),HL
 8292 2C46 ~                RET
 8293 2C46                  ENDIF
 8294 2C46
 8295 2C46                  IFUSED _setjmp
 8296 2C46 ~            ; ---------------------------------------------------------------------------
 8297 2C46 ~            ; setjmp(env), env in HL (lib/include/setjmp.h): the return address, and the
 8298 2C46 ~            ; stack pointer as it will be once this returns. Every register is the caller's
 8299 2C46 ~            ; to save, so those two words are all there is.
 8300 2C46 ~            ; ---------------------------------------------------------------------------
 8301 2C46 ~            _setjmp:
 8302 2C46 ~                POP  DE             ; the return address
 8303 2C46 ~                PUSH DE
 8304 2C46 ~                LD   (HL),E
 8305 2C46 ~                INC  HL
 8306 2C46 ~                LD   (HL),D
 8307 2C46 ~                INC  HL
 8308 2C46 ~                EX   DE,HL          ; DE -> the second word
 8309 2C46 ~                LD   HL,2
 8310 2C46 ~                ADD  HL,SP          ; the caller's SP after the return
 8311 2C46 ~                EX   DE,HL
 8312 2C46 ~                LD   (HL),E
 8313 2C46 ~                INC  HL
 8314 2C46 ~                LD   (HL),D
 8315 2C46 ~                LD   HL,0
 8316 2C46 ~                RET
 8317 2C46                  ENDIF
 8318 2C46
 8319 2C46                  IFUSED _longjmp
 8320 2C46 ~            ; ---------------------------------------------------------------------------
 8321 2C46 ~            ; longjmp(env, val), env in HL and val in DE: back to where setjmp returned,
 8322 2C46 ~            ; returning val there -- or 1, if val is 0.
 8323 2C46 ~            ; ---------------------------------------------------------------------------
 8324 2C46 ~            _longjmp:
 8325 2C46 ~                LD   A,D
 8326 2C46 ~                OR   E
 8327 2C46 ~                JP   NZ,.value
 8328 2C46 ~                INC  DE
 8329 2C46 ~            .value:
 8330 2C46 ~                LD   C,(HL)
 8331 2C46 ~                INC  HL
 8332 2C46 ~                LD   B,(HL)         ; BC = where to go
 8333 2C46 ~                INC  HL
 8334 2C46 ~                LD   A,(HL)
 8335 2C46 ~                INC  HL
 8336 2C46 ~                LD   H,(HL)
 8337 2C46 ~                LD   L,A
 8338 2C46 ~                LD   SP,HL          ; the stack as setjmp's caller had it
 8339 2C46 ~                EX   DE,HL          ; the value, in HL
 8340 2C46 ~                PUSH BC
 8341 2C46 ~                RET
 8342 2C46                  ENDIF
 8343 2C46
 8344 2C46                  IFUSED __x80_sp
 8345 2C46 ~            ; ---------------------------------------------------------------------------
 8346 2C46 ~            ; The stack pointer, in HL: where the C library's heap has to stop. Its own
 8347 2C46 ~            ; return address is on the stack, so the caller sees two bytes less than it had.
 8348 2C46 ~            ; ---------------------------------------------------------------------------
 8349 2C46 ~            __x80_sp:
 8350 2C46 ~                LD   HL,0
 8351 2C46 ~                ADD  HL,SP
 8352 2C46 ~                RET
 8353 2C46                  ENDIF
