 8543 2C44              ; Where the characters of a written-out printf go (lib/libc/stdio.c, pw_out): to putchar, the
 8544 2C44              ; character in L -- or, in a program that has sprintf or snprintf written out, which is what uses
 8545 2C44              ; __x80_put_to, into the buffer while __x80_pw_mode is set. A program that only prints carries the
 8546 2C44              ; JP alone.
 8547 2C44                  IFUSED __x80_pw_out
 8548 2C44 ~            __x80_pw_out:
