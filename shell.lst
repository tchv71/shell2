 2480 2ABA ~            ; ---------------------------------------------------------------------------
 2481 2ABA ~            ; A = 0 if a = b, 1 if a < b, 2 if a > b, 3 if either is a NaN. Two zeros are equal whatever
 2482 2ABA ~            ; their signs; otherwise floats of one sign are ordered as their bits are, upside down for
 2483 2ABA ~            ; negative ones.
 2484 2ABA ~            ;
 2485 2ABA ~            ; Straight from the registers and the stack while neither exponent's top seven bits are all
 2486 2ABA ~            ; ones, so neither can be a NaN; else the full path through fpa and fpb. -Os has the full path
 2487 2ABA ~            ; alone, some 70 bytes less.
 2488 2ABA ~            ; ---------------------------------------------------------------------------
 2489 2ABA ~            __x80_fcmp:
 2490 2ABA ~                IFNDEF X80_OPT_SIZE
 2491 2ABA ~                PUSH HL                 ; a's low word
 2492 2ABA ~                LD   HL,5
