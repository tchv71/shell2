 4329 2B0F              __x80_divide:
 4330 2B0F                  IFDEF X80_OPT_SIZE
 4331 2B0F                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2B0F                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2B0F                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2B0F                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2B0F                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2B0F 2A 6C 2C         LD   HL,(__x80_rt_b)
 4337 2B12 7C               LD   A,H
 4338 2B13 B5               OR   L
 4339 2B14 2A 6E 2C         LD   HL,(__x80_rt_b+2)
 4340 2B17 B4               OR   H
 4341 2B18 B5               OR   L
 4342 2B19 CA BC 2B         JP   Z,.s_zero
 4343 2B1C 21 6C 2C         LD   HL,__x80_rt_b
 4344 2B1F 11 68 2C         LD   DE,__x80_rt_r
 4345 2B22 06 04            LD   B,4
 4346 2B24              .s_not:
 4347 2B24 7E               LD   A,(HL)
 4348 2B25 2F               CPL
 4349 2B26 12               LD   (DE),A
 4350 2B27 23               INC  HL
 4351 2B28 13               INC  DE
 4352 2B29 05               DEC  B
 4353 2B2A C2 24 2B         JP   NZ,.s_not
 4354 2B2D 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 2B2F              .s_skip:                    ; remainder zero still and the quotient's bits 0
 4356 2B2F 3A 73 2C         LD   A,(__x80_rt_a+3)
 4357 2B32 B7               OR   A
 4358 2B33 C2 4D 2B         JP   NZ,.s_go
 4359 2B36 2A 71 2C         LD   HL,(__x80_rt_a+1)
 4360 2B39 22 72 2C         LD   (__x80_rt_a+2),HL
 4361 2B3C 3A 70 2C         LD   A,(__x80_rt_a)
 4362 2B3F 32 71 2C         LD   (__x80_rt_a+1),A
 4363 2B42 AF               XOR  A
 4364 2B43 32 70 2C         LD   (__x80_rt_a),A
 4365 2B46 78               LD   A,B
 4366 2B47 D6 08            SUB  8
 4367 2B49 47               LD   B,A
 4368 2B4A C2 2F 2B         JP   NZ,.s_skip
 4369 2B4D              .s_go:
 4370 2B4D 21 00 00         LD   HL,0
 4371 2B50 54               LD   D,H
 4372 2B51 5D               LD   E,L
 4373 2B52 78               LD   A,B
 4374 2B53 B7               OR   A
 4375 2B54 CA B4 2B         JP   Z,.s_done          ; a dividend of zero
 4376 2B57              .s_loop:
 4377 2B57 F5               PUSH AF
 4378 2B58 3A 70 2C         LD   A,(__x80_rt_a)     ; the dividend's top bit out, a 0 in for the quotient's bit
 4379 2B5B 87               ADD  A,A
 4380 2B5C 32 70 2C         LD   (__x80_rt_a),A
 4381 2B5F 3A 71 2C         LD   A,(__x80_rt_a+1)
 4382 2B62 17               RLA
 4383 2B63 32 71 2C         LD   (__x80_rt_a+1),A
 4384 2B66 3A 72 2C         LD   A,(__x80_rt_a+2)
 4385 2B69 17               RLA
 4386 2B6A 32 72 2C         LD   (__x80_rt_a+2),A
 4387 2B6D 3A 73 2C         LD   A,(__x80_rt_a+3)
 4388 2B70 17               RLA
 4389 2B71 32 73 2C         LD   (__x80_rt_a+3),A
 4390 2B74 7D               LD   A,L                ; and into the remainder, the carry its thirty-third bit
 4391 2B75 17               RLA
 4392 2B76 6F               LD   L,A
 4393 2B77 7C               LD   A,H
 4394 2B78 17               RLA
 4395 2B79 67               LD   H,A
 4396 2B7A 7B               LD   A,E
 4397 2B7B 17               RLA
 4398 2B7C 5F               LD   E,A
 4399 2B7D 7A               LD   A,D
 4400 2B7E 17               RLA
 4401 2B7F 57               LD   D,A
 4402 2B80 01 68 2C         LD   BC,__x80_rt_r
 4403 2B83 DA 98 2B         JP   C,.s_take          ; above the divisor whatever the rest
 4404 2B86 37               SCF                     ; R + ~d + 1: the carry if R is not below d
 4405 2B87 0A               LD   A,(BC)
 4406 2B88 8D               ADC  A,L
 4407 2B89 03               INC  BC
 4408 2B8A 0A               LD   A,(BC)
 4409 2B8B 8C               ADC  A,H
 4410 2B8C 03               INC  BC
 4411 2B8D 0A               LD   A,(BC)
 4412 2B8E 8B               ADC  A,E
 4413 2B8F 03               INC  BC
 4414 2B90 0A               LD   A,(BC)
 4415 2B91 8A               ADC  A,D
 4416 2B92 D2 AF 2B         JP   NC,.s_next
 4417 2B95 01 68 2C         LD   BC,__x80_rt_r
 4418 2B98              .s_take:
 4419 2B98 37               SCF                     ; d taken off, and a 1
 4420 2B99 0A               LD   A,(BC)
 4421 2B9A 8D               ADC  A,L
 4422 2B9B 6F               LD   L,A
 4423 2B9C 03               INC  BC
 4424 2B9D 0A               LD   A,(BC)
 4425 2B9E 8C               ADC  A,H
 4426 2B9F 67               LD   H,A
 4427 2BA0 03               INC  BC
 4428 2BA1 0A               LD   A,(BC)
 4429 2BA2 8B               ADC  A,E
 4430 2BA3 5F               LD   E,A
 4431 2BA4 03               INC  BC
 4432 2BA5 0A               LD   A,(BC)
 4433 2BA6 8A               ADC  A,D
 4434 2BA7 57               LD   D,A
 4435 2BA8 3A 70 2C         LD   A,(__x80_rt_a)
 4436 2BAB 3C               INC  A
 4437 2BAC 32 70 2C         LD   (__x80_rt_a),A
 4438 2BAF              .s_next:
 4439 2BAF F1               POP  AF
 4440 2BB0 3D               DEC  A
 4441 2BB1 C2 57 2B         JP   NZ,.s_loop
 4442 2BB4              .s_done:
 4443 2BB4 22 68 2C         LD   (__x80_rt_r),HL
 4444 2BB7 EB               EX   DE,HL
 4445 2BB8 22 6A 2C         LD   (__x80_rt_r+2),HL
 4446 2BBB C9               RET
 4447 2BBC              .s_zero:
 4448 2BBC 2A 70 2C         LD   HL,(__x80_rt_a)    ; as below: all ones, and the dividend left over
 4449 2BBF 22 68 2C         LD   (__x80_rt_r),HL
 4450 2BC2 2A 72 2C         LD   HL,(__x80_rt_a+2)
 4451 2BC5 22 6A 2C         LD   (__x80_rt_r+2),HL
 4452 2BC8 21 FF FF         LD   HL,0FFFFH
 4453 2BCB 22 70 2C         LD   (__x80_rt_a),HL
 4454 2BCE 22 72 2C         LD   (__x80_rt_a+2),HL
 4455 2BD1 C9               RET
