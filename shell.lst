 5731 2BEA ~            ; __x80_mul16_lead, where the byte widened, FFh above it, took __x80_mul16's sixteen (ivagor,
 5732 2BEA ~            ; zx-pk.ru). -128 is 80h either way. Ahead of __x80_mul16, whose -O2 form falls into
 5733 2BEA ~            ; __x80_mul16_byte -- in between, it made every multiplication go through this.
 5734 2BEA ~            __x80_mul16_sbyte:
 5735 2BEA ~                OR   A
 5736 2BEA ~                JP   P,.positive
 5737 2BEA ~                CPL
 5738 2BEA ~                INC  A
 5739 2BEA ~                LD   L,A
