 5286 2BAE                  IFUSED __x80_sdiv16
 5287 2BAE ~
 5288 2BAE ~            ; ---------------------------------------------------------------------------
 5289 2BAE ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 2BAE ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 2BAE ~            ; the sign put back afterwards.
 5292 2BAE ~            ; ---------------------------------------------------------------------------
 5293 2BAE ~            __x80_sdiv16:
 5294 2BAE ~                LD   A,H            ; the quotient is negative when the signs differ
 5295 2BAE ~                XOR  D
 5296 2BAE ~                AND  80H
 5297 2BAE ~                PUSH AF
 5298 2BAE ~                CALL __x80_abs_hl
 5299 2BAE ~                CALL __x80_abs_de
 5300 2BAE ~                CALL __x80_udiv16
 5301 2BAE ~                POP  AF
 5302 2BAE ~                OR   A
 5303 2BAE ~                RET  Z
 5304 2BAE ~                JP   __x80_neg_hl
 5305 2BAE                  ENDIF
