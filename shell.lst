 4235 2AC4 ~            __x80_lurem:
 4236 2AC4 ~                CALL __x80_div_args
 4237 2AC4 ~                CALL __x80_divide
 4238 2AC4 ~                JP   __x80_remainder
 4239 2AC4                  ENDIF
