 8553 2C46 ~                ENDIF
 8554 2C46 ~                JP   _putchar
 8555 2C46                  ENDIF
 8556 2C46                  IFUSED __x80_pw_mode
 8557 2C46 ~            __x80_bss_off = __x80_bss_off + 1
 8558 2C46 ~            __x80_pw_mode EQU __x80_bss_top - __x80_bss_off   ; sprintf's buffer is where the characters go
 8559 2C46                  ENDIF
