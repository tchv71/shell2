 8470 2C68 ~            __x80_qa EQU __x80_bss_top - __x80_bss_off      ; the first operand, the product's multiplicand, the quotient
 8471 2C68                  ENDIF
 8472 2C68
 8473 2C68                  IFUSED __x80_qb
 8474 2C68 ~            __x80_bss_off = __x80_bss_off + 8
 8475 2C68 ~            __x80_qb EQU __x80_bss_top - __x80_bss_off      ; the second operand
 8476 2C68                  ENDIF
 8477 2C68
 8478 2C68                  IFUSED __x80_qr
 8479 2C68 ~            __x80_bss_off = __x80_bss_off + 8
 8480 2C68 ~            __x80_qr EQU __x80_bss_top - __x80_bss_off      ; the product, the remainder
 8481 2C68                  ENDIF
 8482 2C68
 8483 2C68                  IFUSED __x80_qn
 8484 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8485 2C68 ~            __x80_qn EQU __x80_bss_top - __x80_bss_off      ; the loop counter
 8486 2C68                  ENDIF
 8487 2C68
 8488 2C68                  IFUSED __x80_qst
 8489 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8490 2C68 ~            __x80_qst EQU __x80_bss_top - __x80_bss_off      ; a product's sticky bit
 8491 2C68                  ENDIF
 8492 2C68
 8493 2C68                  IFUSED __x80_qsign
 8494 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8495 2C68 ~            __x80_qsign EQU __x80_bss_top - __x80_bss_off      ; the sign the result should end up with
