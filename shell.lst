 5597 2BEB ~                ADD  HL,DE          ; bit 7
 5598 2BEB ~                JP   NC,.a6
 5599 2BEB ~            .s6:
 5600 2BEB ~                ADC  A,A
 5601 2BEB ~                ADD  HL,HL
 5602 2BEB ~                ADD  HL,DE
 5603 2BEB ~                JP   NC,.a5
 5604 2BEB ~            .s5:
 5605 2BEB ~                ADC  A,A
 5606 2BEB ~                ADD  HL,HL
 5607 2BEB ~                ADD  HL,DE
 5608 2BEB ~                JP   NC,.a4
 5609 2BEB ~            .s4:
 5610 2BEB ~                ADC  A,A
 5611 2BEB ~                ADD  HL,HL
 5612 2BEB ~                ADD  HL,DE
 5613 2BEB ~                JP   NC,.a3
 5614 2BEB ~            .s3:
 5615 2BEB ~                ADC  A,A
 5616 2BEB ~                ADD  HL,HL
 5617 2BEB ~                ADD  HL,DE
 5618 2BEB ~                JP   NC,.a2
 5619 2BEB ~            .s2:
 5620 2BEB ~                ADC  A,A
 5621 2BEB ~                ADD  HL,HL
 5622 2BEB ~                ADD  HL,DE
 5623 2BEB ~                JP   NC,.a1
 5624 2BEB ~            .s1:
 5625 2BEB ~                ADC  A,A
 5626 2BEB ~                ADD  HL,HL
 5627 2BEB ~                ADD  HL,DE
 5628 2BEB ~                JP   NC,.a0
 5629 2BEB ~            .s0:
 5630 2BEB ~                ADC  A,A
 5631 2BEB ~                ADD  HL,HL
 5632 2BEB ~                ADD  HL,DE
 5633 2BEB ~                JP   NC,.ae
 5634 2BEB ~            .se:
 5635 2BEB ~                ADC  A,A
 5636 2BEB ~                ADD  HL,HL          ; the remainder, times 128, into H
 5637 2BEB ~                RET
 5638 2BEB ~            .a6:
 5639 2BEB ~                ADC  A,A
 5640 2BEB ~                ADD  HL,HL
 5641 2BEB ~                ADD  HL,BC
 5642 2BEB ~                JP   C,.s5
 5643 2BEB ~            .a5:
 5644 2BEB ~                ADC  A,A
 5645 2BEB ~                ADD  HL,HL
 5646 2BEB ~                ADD  HL,BC
 5647 2BEB ~                JP   C,.s4
 5648 2BEB ~            .a4:
 5649 2BEB ~                ADC  A,A
 5650 2BEB ~                ADD  HL,HL
 5651 2BEB ~                ADD  HL,BC
 5652 2BEB ~                JP   C,.s3
 5653 2BEB ~            .a3:
 5654 2BEB ~                ADC  A,A
 5655 2BEB ~                ADD  HL,HL
 5656 2BEB ~                ADD  HL,BC
 5657 2BEB ~                JP   C,.s2
 5658 2BEB ~            .a2:
 5659 2BEB ~                ADC  A,A
 5660 2BEB ~                ADD  HL,HL
 5661 2BEB ~                ADD  HL,BC
 5662 2BEB ~                JP   C,.s1
 5663 2BEB ~            .a1:
 5664 2BEB ~                ADC  A,A
 5665 2BEB ~                ADD  HL,HL
 5666 2BEB ~                ADD  HL,BC
 5667 2BEB ~                JP   C,.s0
 5668 2BEB ~            .a0:
 5669 2BEB ~                ADC  A,A
 5670 2BEB ~                ADD  HL,HL
 5671 2BEB ~                ADD  HL,BC
 5672 2BEB ~                JP   C,.se
 5673 2BEB ~            .ae:
 5674 2BEB ~                ADC  A,A
 5675 2BEB ~                ADD  HL,BC          ; below zero: the divisor back, then into H
 5676 2BEB ~                ADD  HL,HL
 5677 2BEB ~                RET
 5678 2BEB ~
