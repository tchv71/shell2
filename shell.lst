 1427 2ABB
 1428 2ABB              ; ---------------------------------------------------------------------------
 1429 2ABB              ; binary32: float arithmetic, comparison and conversions to and from long.
 1430 2ABB              ;
 1431 2ABB              ; The compiler calls these for every float operation: a float is its bits, an operand like a
 1432 2ABB              ; long -- a in HL (low word) and DE (high word), b in BC (low) and on the stack above the return
 1433 2ABB              ; address (high), left there for the caller to take off -- and the result in HL:DE, a comparison's
 1434 2ABB              ; in A. The algorithms are those of the compiler's C reference implementation of IEEE 754, and the
 1435 2ABB              ; results agree with it bit for bit: one rounding, to the nearest with ties to even; subnormals;
 1436 2ABB              ; infinities; and NaNs that come back quieted, the first operand's when both are, as on the
 1437 2ABB              ; x86.
 1438 2ABB              ;
 1439 2ABB              ; A finite number in the middle of an operation is a sign (in fps), an exponent in BC and a
 1440 2ABB              ; significand of thirty-two bits in DEHL, D the top byte, its leading one at bit 31: twenty-four
 1441 2ABB              ; bits of the result and eight below them, which decide the rounding -- the round bit is bit 7,
 1442 2ABB              ; and whatever was shifted out below bit 0 is kept as a one in bit 0, the sticky bit. Its value is
 1443 2ABB              ; DEHL / 2^31 * 2^(BC - 127), so BC is the biased exponent the result has before rounding.
 1444 2ABB              ; __x80_fp_rpack makes the float of that. The operands wait in fpa and fpb, the bytes as in
 1445 2ABB              ; memory, low first.
 1446 2ABB              ;
 1447 2ABB              ; Not reentrant: an interrupt handler doing float arithmetic while the main program is inside one
 1448 2ABB              ; of these would corrupt it, as with the division of longs.
 1449 2ABB              ; ---------------------------------------------------------------------------
 1450 2ABB
 1451 2ABB                  IFUSED __x80_fsub
 1452 2ABB ~            __x80_fsub:
 1453 2ABB ~                LD   A,80H              ; b's sign flipped: the addition, which follows its first byte
 1454 2ABB ~                JP   __x80_fadd+1
 1455 2ABB                  ENDIF
 1456 2ABB
 1457 2ABB                  IFUSED __x80_fadd
 1458 2ABB ~            ; ---------------------------------------------------------------------------
 1459 2ABB ~            ; DE:HL = a + b. With |a| >= |b| -- swapped if not -- the result has a's sign, and b's
 1460 2ABB ~            ; significand, shifted down to a's exponent, is added to a's or taken from it. A subnormal is
 1461 2ABB ~            ; taken as exponent 1 without the leading one, and comes the same way; a NaN, an infinity and a
 1462 2ABB ~            ; zero b are dealt with before.
 1463 2ABB ~            ; ---------------------------------------------------------------------------
 1464 2ABB ~            __x80_fadd:
 1465 2ABB ~                XOR  A                  ; one byte: __x80_fsub comes in after it
 1466 2ABB ~                LD   (__x80_fpx),A      ; what b's sign is flipped by
 1467 2ABB ~                IFDEF X80_OPT_SIZE
 1468 2ABB ~                CALL __x80_fp_load2
 1469 2ABB ~                ELSE
 1470 2ABB ~                ; Two normal numbers, the common case, without the general way's stores and swap: the low words
 1471 2ABB ~                ; to fpa and fpb, the high words kept in DE and HL, where the exponents and the signs are read;
 1472 2ABB ~                ; the larger's significand left in fpa -- b's put there when b is the larger -- and the
 1473 2ABB ~                ; smaller's in DEHL for the shift. Anything else goes the general way below, everything stored
 1474 2ABB ~                ; as __x80_fp_load2 would have. Some 750 T-states where that took 1290 (ivagor, zx-pk.ru).
 1475 2ABB ~                LD   (__x80_fpa),HL
 1476 2ABB ~                LD   H,B
 1477 2ABB ~                LD   L,C
 1478 2ABB ~                LD   (__x80_fpb),HL
 1479 2ABB ~                LD   HL,2
 1480 2ABB ~                ADD  HL,SP
 1481 2ABB ~                LD   A,(HL)
 1482 2ABB ~                INC  HL
 1483 2ABB ~                LD   H,(HL)
 1484 2ABB ~                LD   L,A                ; b's high word
 1485 2ABB ~                LD   A,E
 1486 2ABB ~                ADD  A,A
 1487 2ABB ~                LD   A,D
 1488 2ABB ~                ADC  A,A
 1489 2ABB ~                LD   C,A                ; a's exponent field
 1490 2ABB ~                INC  A
 1491 2ABB ~                CP   2
 1492 2ABB ~                JP   C,.slow            ; 0 or 255
 1493 2ABB ~                LD   A,L
 1494 2ABB ~                ADD  A,A
 1495 2ABB ~                LD   A,H
 1496 2ABB ~                ADC  A,A
 1497 2ABB ~                LD   B,A                ; b's
 1498 2ABB ~                INC  A
 1499 2ABB ~                CP   2
 1500 2ABB ~                JP   C,.slow
 1501 2ABB ~                LD   A,(__x80_fpx)
 1502 2ABB ~                XOR  H
 1503 2ABB ~                LD   H,A                ; b's sign as it is added
 1504 2ABB ~                XOR  D
 1505 2ABB ~                LD   (__x80_fpx),A      ; bit 7: the signs differ, the magnitudes are subtracted
 1506 2ABB ~                LD   A,C
 1507 2ABB ~                CP   B
 1508 2ABB ~                JP   C,.fast_b
 1509 2ABB ~                JP   NZ,.fast_a
 1510 2ABB ~                LD   A,E                ; the same exponent: the significands decide
 1511 2ABB ~                CP   L
 1512 2ABB ~                JP   C,.fast_b
 1513 2ABB ~                JP   NZ,.fast_a
 1514 2ABB ~                PUSH HL
 1515 2ABB ~                LD   HL,__x80_fpb+1
 1516 2ABB ~                LD   A,(__x80_fpa+1)
 1517 2ABB ~                CP   (HL)
 1518 2ABB ~                JP   NZ,.fast_cmp
 1519 2ABB ~                DEC  HL
 1520 2ABB ~                LD   A,(__x80_fpa)
 1521 2ABB ~                CP   (HL)
 1522 2ABB ~            .fast_cmp:
 1523 2ABB ~                POP  HL
 1524 2ABB ~                JP   C,.fast_b
 1525 2ABB ~            .fast_a:
 1526 2ABB ~                ; |a| >= |b|: the result's sign a's, a's leading one put in, b's significand into DEHL
 1527 2ABB ~                LD   A,D
 1528 2ABB ~                AND  80H
 1529 2ABB ~                LD   (__x80_fps),A
 1530 2ABB ~                LD   A,E
 1531 2ABB ~                OR   80H
 1532 2ABB ~                LD   (__x80_fpa+2),A
 1533 2ABB ~                LD   A,L
 1534 2ABB ~                OR   80H
 1535 2ABB ~                LD   D,A
 1536 2ABB ~                LD   HL,(__x80_fpb)
 1537 2ABB ~                LD   E,H
 1538 2ABB ~                LD   H,L
 1539 2ABB ~                LD   L,0
 1540 2ABB ~                LD   A,C
 1541 2ABB ~                SUB  B                  ; how far b is below a
 1542 2ABB ~                JP   .shift
 1543 2ABB ~            .fast_b:
 1544 2ABB ~                ; |b| > |a|: b's sign, b's significand where a's was, a's into DEHL, b's exponent
 1545 2ABB ~                LD   A,H
 1546 2ABB ~                AND  80H
 1547 2ABB ~                LD   (__x80_fps),A
 1548 2ABB ~                LD   A,L
 1549 2ABB ~                OR   80H
 1550 2ABB ~                LD   (__x80_fpa+2),A
 1551 2ABB ~                LD   A,E
 1552 2ABB ~                OR   80H
 1553 2ABB ~                LD   D,A
 1554 2ABB ~                LD   A,B
 1555 2ABB ~                SUB  C                  ; how far a is below b (the flags kept to .shift)
 1556 2ABB ~                LD   C,B
 1557 2ABB ~                LD   HL,(__x80_fpa)
 1558 2ABB ~                LD   E,H
 1559 2ABB ~                LD   B,L                ; a's byte 0, kept
 1560 2ABB ~                LD   HL,(__x80_fpb)
 1561 2ABB ~                LD   (__x80_fpa),HL     ; b's low word where a's was
 1562 2ABB ~                LD   H,B
 1563 2ABB ~                LD   L,0
 1564 2ABB ~                JP   .shift
 1565 2ABB ~            .slow:
 1566 2ABB ~                LD   (__x80_fpb+2),HL   ; as __x80_fp_load2 leaves them
 1567 2ABB ~                EX   DE,HL
 1568 2ABB ~                LD   (__x80_fpa+2),HL
