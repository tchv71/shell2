 8413 2C44                  ENDIF
 8414 2C44
 8415 2C44                  IFUSED __x80_sp_save
 8416 2C44 ~            __x80_bss_off = __x80_bss_off + 2
 8417 2C44 ~            __x80_sp_save EQU __x80_bss_top - __x80_bss_off  ; -mstack-copy: SP, while it is the pointer
 8418 2C44                  ENDIF
 8419 2C44
 8420 2C44              ; Working space, for double.
