 8239 2C66
 8240 2C66                  IFUSED __x80_call_hl
 8241 2C66 ~            ; ---------------------------------------------------------------------------
 8242 2C66 ~            ; Calls the address in HL, for a call through a pointer that gives HL to no
 8243 2C66 ~            ; argument: CALL here and JP (HL), the callee's RET coming back to the caller.
 8244 2C66 ~            ; Five T-states against __x80_call_bc's twenty-one, and the address is most
 8245 2C66 ~            ; often in HL already. A call in the last place, CALL / RET, is a jump here, and
 8246 2C66 ~            ; the compiler writes JP (HL) itself (emit.c) -- not in an interrupt's code,
 8247 2C66 ~            ; whose copy of this turns the address into the function's copy first
 8248 2C66 ~            ; (marinovsoft, zx-pk.ru).
 8249 2C66 ~            ; ---------------------------------------------------------------------------
 8250 2C66 ~            __x80_call_hl:
 8251 2C66 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8252 2C66 ~                JP   (HL)
 8253 2C66                  ENDIF
 8254 2C66
 8255 2C66                  IFUSED __x80_call_bc
 8256 2C66
 8257 2C66              ; ---------------------------------------------------------------------------
 8258 2C66              ; Calls the address in BC. The processor has no indirect CALL, and this is the
 8259 2C66              ; cheapest stand-in that clobbers nothing: PUSH BC puts the target on the stack
 8260 2C66              ; above the return address the caller's CALL pushed, RET jumps to it, and the
 8261 2C66              ; callee's own RET then finds the caller's address underneath and comes back.
 8262 2C66              ;
 8263 2C66              ; BC because the convention offers the pairs to arguments in the order HL, DE,
 8264 2C66              ; BC, so this is the one least likely to be wanted for something else. JP (HL)
 8265 2C66              ; would be five T-states rather than twenty-one, but HL is the first pair an
 8266 2C66              ; argument gets.
 8267 2C66              ; ---------------------------------------------------------------------------
 8268 2C66              __x80_call_bc:
 8269 2C66              ;@irq    PUSH HL             ; an interrupt's copy: to the function's copy (__x80_xlat)
 8270 2C66              ;@irq    LD   H,B
 8271 2C66              ;@irq    LD   L,C
 8272 2C66              ;@irq    CALL __x80_xlat
 8273 2C66              ;@irq    LD   B,H
 8274 2C66              ;@irq    LD   C,L
 8275 2C66              ;@irq    POP  HL
 8276 2C66 C5               PUSH BC
 8277 2C67 C9               RET
 8278 2C68                  ENDIF
 8279 2C68
 8280 2C68                  IFUSED __x80_call_mem
 8281 2C68 ~            ; ---------------------------------------------------------------------------
 8282 2C68 ~            ; Calls the address in __x80_call_target, for a call through a pointer whose
 8283 2C68 ~            ; arguments fill HL, DE and BC: the address could go in no register. EX (SP),HL
 8284 2C68 ~            ; puts it on the stack and gives HL back, and RET jumps to it with the caller's
 8285 2C68 ~            ; return address underneath. Forty-three T-states.
 8286 2C68 ~            ; ---------------------------------------------------------------------------
 8287 2C68 ~            __x80_call_mem:
 8288 2C68 ~                PUSH HL
 8289 2C68 ~                LD   HL,(__x80_call_target)
 8290 2C68 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8291 2C68 ~                EX   (SP),HL
 8292 2C68 ~                RET
 8293 2C68                  ENDIF
 8294 2C68
 8295 2C68                  IFUSED _setjmp
 8296 2C68 ~            ; ---------------------------------------------------------------------------
 8297 2C68 ~            ; setjmp(env), env in HL (lib/include/setjmp.h): the return address, and the
 8298 2C68 ~            ; stack pointer as it will be once this returns. Every register is the caller's
 8299 2C68 ~            ; to save, so those two words are all there is.
 8300 2C68 ~            ; ---------------------------------------------------------------------------
 8301 2C68 ~            _setjmp:
 8302 2C68 ~                POP  DE             ; the return address
 8303 2C68 ~                PUSH DE
 8304 2C68 ~                LD   (HL),E
 8305 2C68 ~                INC  HL
 8306 2C68 ~                LD   (HL),D
 8307 2C68 ~                INC  HL
 8308 2C68 ~                EX   DE,HL          ; DE -> the second word
 8309 2C68 ~                LD   HL,2
 8310 2C68 ~                ADD  HL,SP          ; the caller's SP after the return
 8311 2C68 ~                EX   DE,HL
 8312 2C68 ~                LD   (HL),E
 8313 2C68 ~                INC  HL
 8314 2C68 ~                LD   (HL),D
 8315 2C68 ~                LD   HL,0
 8316 2C68 ~                RET
 8317 2C68                  ENDIF
 8318 2C68
 8319 2C68                  IFUSED _longjmp
 8320 2C68 ~            ; ---------------------------------------------------------------------------
 8321 2C68 ~            ; longjmp(env, val), env in HL and val in DE: back to where setjmp returned,
 8322 2C68 ~            ; returning val there -- or 1, if val is 0.
 8323 2C68 ~            ; ---------------------------------------------------------------------------
 8324 2C68 ~            _longjmp:
 8325 2C68 ~                LD   A,D
 8326 2C68 ~                OR   E
 8327 2C68 ~                JP   NZ,.value
 8328 2C68 ~                INC  DE
 8329 2C68 ~            .value:
 8330 2C68 ~                LD   C,(HL)
 8331 2C68 ~                INC  HL
 8332 2C68 ~                LD   B,(HL)         ; BC = where to go
 8333 2C68 ~                INC  HL
 8334 2C68 ~                LD   A,(HL)
 8335 2C68 ~                INC  HL
 8336 2C68 ~                LD   H,(HL)
 8337 2C68 ~                LD   L,A
 8338 2C68 ~                LD   SP,HL          ; the stack as setjmp's caller had it
 8339 2C68 ~                EX   DE,HL          ; the value, in HL
 8340 2C68 ~                PUSH BC
 8341 2C68 ~                RET
 8342 2C68                  ENDIF
 8343 2C68
 8344 2C68                  IFUSED __x80_sp
 8345 2C68 ~            ; ---------------------------------------------------------------------------
 8346 2C68 ~            ; The stack pointer, in HL: where the C library's heap has to stop. Its own
 8347 2C68 ~            ; return address is on the stack, so the caller sees two bytes less than it had.
 8348 2C68 ~            ; ---------------------------------------------------------------------------
 8349 2C68 ~            __x80_sp:
 8350 2C68 ~                LD   HL,0
 8351 2C68 ~                ADD  HL,SP
 8352 2C68 ~                RET
 8353 2C68                  ENDIF
 8354 2C68
 8355 2C68              ;@shared
 8356 2C68                  IFNDEF X80_EXIT_DEFINED
 8357 2C68                  IFUSED __x80_exit
 8358 2C68 ~            ; ---------------------------------------------------------------------------
 8359 2C68 ~            ; How a program ends when it calls exit, _Exit or abort, the status in HL. On
 8360 2C68 ~            ; the machine there is nobody to tell, so it halts; a test platform defines
 8361 2C68 ~            ; __x80_exit itself, before this file, with DEFINE X80_EXIT_DEFINED -- IFNDEF
 8362 2C68 ~            ; tests DEFINEs, not labels -- and reports the status instead
 8363 2C68 ~            ; (lib/crt/test_start.asm).
 8364 2C68 ~            ; ---------------------------------------------------------------------------
 8365 2C68 ~            __x80_exit:
 8366 2C68 ~                JP   __x80_halt
 8367 2C68                  ENDIF
 8368 2C68                  ENDIF
 8369 2C68
 8370 2C68                  IFUSED __x80_halt
 8371 2C68 ~            ; ---------------------------------------------------------------------------
 8372 2C68 ~            ; The end of a program that stops itself: exit, abort. HALT, and HALT again if
 8373 2C68 ~            ; an interrupt wakes it -- there is nothing to return to.
 8374 2C68 ~            ; ---------------------------------------------------------------------------
 8375 2C68 ~            __x80_halt:
 8376 2C68 ~                HALT
 8377 2C68 ~                JP   __x80_halt
 8378 2C68                  ENDIF
 8379 2C68              ;@end
 8380 2C68
 8381 2C68                  IFUSED __x80_rt_a
 8382 2C68              ; ---------------------------------------------------------------------------
 8383 2C68              ; Working space, for division. Like every object that starts as zeros, not in the image: an
 8384 2C68              ; address below __x80_bss_top that the startup code clears.
 8385 2C68              ; ---------------------------------------------------------------------------
 8386 2C68              __x80_bss_off = __x80_bss_off + 4
 8387 2C68              __x80_rt_a EQU __x80_bss_top - __x80_bss_off      ; the dividend, then the quotient
 8388 2C68                  ENDIF
 8389 2C68
 8390 2C68                  IFUSED __x80_rt_b
 8391 2C68              __x80_bss_off = __x80_bss_off + 4
 8392 2C68              __x80_rt_b EQU __x80_bss_top - __x80_bss_off      ; the divisor
 8393 2C68                  ENDIF
 8394 2C68
 8395 2C68                  IFUSED __x80_rt_r
 8396 2C68              __x80_bss_off = __x80_bss_off + 4
 8397 2C68              __x80_rt_r EQU __x80_bss_top - __x80_bss_off      ; the remainder
 8398 2C68                  ENDIF
 8399 2C68
 8400 2C68                  IFUSED __x80_rt_sign
 8401 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8402 2C68 ~            __x80_rt_sign EQU __x80_bss_top - __x80_bss_off      ; the sign the result should end up with
 8403 2C68                  ENDIF
 8404 2C68
 8405 2C68                  IFUSED __x80_rt_lo
 8406 2C68 ~            __x80_bss_off = __x80_bss_off + 2
 8407 2C68 ~            __x80_rt_lo EQU __x80_bss_top - __x80_bss_off      ; the low word of a product, while the high one is summed
 8408 2C68                  ENDIF
 8409 2C68
 8410 2C68                  IFUSED __x80_call_target
 8411 2C68 ~            __x80_bss_off = __x80_bss_off + 2
 8412 2C68 ~            __x80_call_target EQU __x80_bss_top - __x80_bss_off  ; the address __x80_call_mem calls
 8413 2C68                  ENDIF
 8414 2C68
 8415 2C68                  IFUSED __x80_sp_save
 8416 2C68 ~            __x80_bss_off = __x80_bss_off + 2
 8417 2C68 ~            __x80_sp_save EQU __x80_bss_top - __x80_bss_off  ; -mstack-copy: SP, while it is the pointer
 8418 2C68                  ENDIF
 8419 2C68
 8420 2C68              ; Working space, for double.
 8421 2C68                  IFUSED __x80_dsg
 8422 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8423 2C68 ~            __x80_dsg EQU __x80_bss_top - __x80_bss_off      ; the result's sign, in bit 7
 8424 2C68                  ENDIF
 8425 2C68
 8426 2C68                  IFUSED __x80_dx
 8427 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8428 2C68 ~            __x80_dx EQU __x80_bss_top - __x80_bss_off      ; a flip of b's sign, then a subtraction
 8429 2C68                  ENDIF
 8430 2C68
 8431 2C68                  IFUSED __x80_dexp
 8432 2C68 ~            __x80_bss_off = __x80_bss_off + 2
 8433 2C68 ~            __x80_dexp EQU __x80_bss_top - __x80_bss_off      ; an exponent
 8434 2C68                  ENDIF
 8435 2C68
 8436 2C68              ; Working space, for float.
 8437 2C68                  IFUSED __x80_fpa
 8438 2C68 ~            __x80_bss_off = __x80_bss_off + 4
 8439 2C68 ~            __x80_fpa EQU __x80_bss_top - __x80_bss_off      ; the first operand, then its significand
 8440 2C68                  ENDIF
 8441 2C68
 8442 2C68                  IFUSED __x80_fpb
 8443 2C68 ~            __x80_bss_off = __x80_bss_off + 4
 8444 2C68 ~            __x80_fpb EQU __x80_bss_top - __x80_bss_off      ; the second operand, then its significand
 8445 2C68                  ENDIF
 8446 2C68
 8447 2C68                  IFUSED __x80_fpp
 8448 2C68 ~            __x80_bss_off = __x80_bss_off + 6
 8449 2C68 ~            __x80_fpp EQU __x80_bss_top - __x80_bss_off      ; a product of significands, forty-eight bits
 8450 2C68                  ENDIF
 8451 2C68
 8452 2C68                  IFUSED __x80_fps
 8453 2C68 ~            __x80_bss_off = __x80_bss_off + 1
 8454 2C68 ~            __x80_fps EQU __x80_bss_top - __x80_bss_off      ; the result's sign, in bit 7
 8455 2C68                  ENDIF
 8456 2C68
 8457 2C68                  IFUSED __x80_fpx
