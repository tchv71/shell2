 5288 2BB0 ~            ; ---------------------------------------------------------------------------
 5289 2BB0 ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 2BB0 ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 2BB0 ~            ; the sign put back afterwards.
 5292 2BB0 ~            ; ---------------------------------------------------------------------------
 5293 2BB0 ~            __x80_sdiv16:
