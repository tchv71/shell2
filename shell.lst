 8510 2C46              ; printf's floating-point conversions (lib/libc/stdio.c) are reached through this
 8511 2C46              ; word: the address of __x80_format_double when the program passes a floating
 8512 2C46              ; value to a function with `...` -- the compiler then names __x80_float_varargs
 8513 2C46              ; in an EQU, which is what IFUSED counts -- and zero otherwise, so that a program
 8514 2C46              ; printing only integers does not carry them.
 8515 2C46              ;@shared
 8516 2C46              __x80_float_varargs EQU 0
 8517 2C46              ;@end
 8518 2C46
 8519 2C46                  IFUSED __x80_printf_float
 8520 2C46 ~            __x80_printf_float:
 8521 2C46 ~                IFUSED __x80_float_varargs
 8522 2C46 ~                DEFW __x80_format_double
 8523 2C46 ~                ELSE
 8524 2C46 ~                DEFW 0
 8525 2C46 ~                ENDIF
 8526 2C46                  ENDIF
 8527 2C46
 8528 2C46              ; And the same for printf's 64-bit integers, %lld and its kind: __x80_format_ll when the program
 8529 2C46              ; passes a 64-bit integer to a function with `...` (__x80_ll_varargs), zero otherwise.
 8530 2C46              ;@shared
 8531 2C46              __x80_ll_varargs EQU 0
 8532 2C46              ;@end
 8533 2C46
 8534 2C46                  IFUSED __x80_printf_ll
