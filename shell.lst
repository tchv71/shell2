  428 2ABB ~                INC  DE
  429 2ABB ~                LD   A,(DE)
  430 2ABB ~                SBC  A,(HL)
  431 2ABB ~                LD   (DE),A
  432 2ABB ~                INC  HL
  433 2ABB ~                INC  DE
  434 2ABB ~                LD   A,(DE)
  435 2ABB ~                SBC  A,(HL)
  436 2ABB ~                LD   (DE),A
  437 2ABB ~                INC  HL
  438 2ABB ~                INC  DE
  439 2ABB ~                LD   A,(DE)
  440 2ABB ~                SBC  A,(HL)
  441 2ABB ~                LD   (DE),A
  442 2ABB ~                INC  HL
  443 2ABB ~                INC  DE
  444 2ABB ~                LD   A,(DE)
  445 2ABB ~                SBC  A,(HL)
  446 2ABB ~                LD   (DE),A
  447 2ABB ~                INC  HL
  448 2ABB ~                INC  DE
  449 2ABB ~                LD   A,(DE)
