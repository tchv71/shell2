 5924 2C1A ~                LD   A,L
 5925 2C1A ~            .loop:
 5926 2C1A ~                ADD  A,A
 5927 2C1A ~                DEC  E
 5928 2C1A ~                JP   NZ,.loop
 5929 2C1A ~                LD   L,A
 5930 2C1A ~                RET
 5931 2C1A                  ENDIF
