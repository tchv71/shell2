 6392 2C3E ~                EX   DE,HL              ; DE the destination, at d + n - g
 6393 2C3E ~                LD   HL,(__x80_sp_save)
 6394 2C3E ~                LD   SP,HL
 6395 2C3E ~                POP  HL                 ; d
 6396 2C3E ~                POP  BC                 ; g
 6397 2C3E ~                PUSH HL
 6398 2C3E ~                LD   H,B
 6399 2C3E ~                LD   L,C
 6400 2C3E ~                ADD  HL,DE              ; the source, at d + n
 6401 2C3E ~                EX   DE,HL
 6402 2C3E ~                CALL __x80_mcpyn_pairs  ; the last g bytes
 6403 2C3E ~                POP  HL                 ; d
 6404 2C3E ~                RET
 6405 2C3E ~            .plain:
 6406 2C3E ~                POP  HL                 ; d
 6407 2C3E ~                JP   __x80_mcpyn_pairs
