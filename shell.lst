 4219 2ABB              ; ---------------------------------------------------------------------------
 4220 2ABB              ; Division and remainder, unsigned and signed.
 4221 2ABB              ;
 4222 2ABB              ; Over memory: the dividend in rt_a, which then holds the quotient, the divisor in rt_b, the
 4223 2ABB              ; remainder in rt_r (__x80_divide). A byte of the quotient at a time: by __x80_dpass8 and
 4224 2ABB              ; __x80_dpass16 for a divisor below 32768, by passes with a 24- or 32-bit remainder for a larger. C truncates the quotient towards zero and gives the remainder the sign of the dividend, so the
 4225 2ABB              ; signed forms are the unsigned division of the magnitudes with the sign put back afterwards.
 4226 2ABB              ; ---------------------------------------------------------------------------
 4227 2ABB              __x80_ludiv:
 4228 2ABB CD C4 2A         CALL __x80_div_args
 4229 2ABE CD EC 2A         CALL __x80_divide
 4230 2AC1 C3 DC 2A         JP   __x80_quotient
 4231 2AC4                  ENDIF
