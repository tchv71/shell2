 5878 2C1B                  IFUSED __x80_mul16_lead
 5879 2C1B ~            ; HL = BC * A, with HL = BC on entry: what __x80_mul16 takes for a byte, and what the compiler calls
 5880 2C1B ~            ; for a word by a byte widened (isel.c, select_muldiv). The multiplier's zeros before its top one
 5881 2C1B ~            ; are passed over, the top one is HL as it came, and the steps for the bits after it are
 5882 2C1B ~            ; __x80_mul16_byte's from there; no one in it at all leaves A zero, and the product is zero.
 5883 2C1B ~            ; -O3 only (__x80_mul16); otherwise the eight steps from zero.
 5884 2C1B ~            __x80_mul16_lead:
 5885 2C1B ~                IFNDEF X80_OPT_SPEED
 5886 2C1B ~                LD   HL,0
 5887 2C1B ~                JP   __x80_mul16_byte
 5888 2C1B ~                ELSE
 5889 2C1B ~                ADD  A,A
 5890 2C1B ~                JP   C,__x80_mul16_b7
 5891 2C1B ~                ADD  A,A
 5892 2C1B ~                JP   C,__x80_mul16_b6
 5893 2C1B ~                ADD  A,A
 5894 2C1B ~                JP   C,__x80_mul16_b5
 5895 2C1B ~                ADD  A,A
 5896 2C1B ~                JP   C,__x80_mul16_b4
 5897 2C1B ~                ADD  A,A
 5898 2C1B ~                JP   C,__x80_mul16_b3
 5899 2C1B ~                ADD  A,A
 5900 2C1B ~                JP   C,__x80_mul16_b2
 5901 2C1B ~                ADD  A,A
 5902 2C1B ~                JP   C,__x80_mul16_b1
 5903 2C1B ~                RET  M                  ; the last bit the top one: HL = BC
 5904 2C1B ~                LD   HL,0               ; no one at all
 5905 2C1B ~                RET
 5906 2C1B ~                ENDIF
 5907 2C1B ~                ASSERT __x80_mul16_byte ; which has the steps
 5908 2C1B                  ENDIF
 5909 2C1B
 5910 2C1B              ; ---------------------------------------------------------------------------
 5911 2C1B              ; L = L shifted by E, the three shifts of a byte, for a count the compiler knows
 5912 2C1B              ; is below eight -- `128 >> (x & 7)` made a byte (ivagor, zx-pk.ru), which was
 5913 2C1B              ; the word shifted by __x80_ashr16. The byte is in L as the word's low byte was,
 5914 2C1B              ; so that A stays free around the call; A and E are spent, BC, D and H are not.
 5915 2C1B              ; A count of zero is tested first, `XOR A / OR E / RET Z`, and the loop's test is
 5916 2C1B              ; at its end: a byte and 17 T-states less than counting down from one more, and 19
 5917 2C1B              ; T-states for no shift at all (ivagor, zx-pk.ru).
 5918 2C1B              ; ---------------------------------------------------------------------------
 5919 2C1B                  IFUSED __x80_shl8
 5920 2C1B ~            __x80_shl8:
 5921 2C1B ~                XOR  A
 5922 2C1B ~                OR   E
 5923 2C1B ~                RET  Z
 5924 2C1B ~                LD   A,L
 5925 2C1B ~            .loop:
 5926 2C1B ~                ADD  A,A
 5927 2C1B ~                DEC  E
 5928 2C1B ~                JP   NZ,.loop
 5929 2C1B ~                LD   L,A
 5930 2C1B ~                RET
 5931 2C1B                  ENDIF
