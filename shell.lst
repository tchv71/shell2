 4148 2ADE ~                RLA                     ; B's bit into the carry, to come in at the top
 4149 2ADE ~                LD   A,D
 4150 2ADE ~                RRA
 4151 2ADE ~                LD   D,A
 4152 2ADE ~                CALL __x80_rr3
 4153 2ADE ~                DEC  C
 4154 2ADE ~                JP   NZ,.right
 4155 2ADE ~                RET
 4156 2ADE ~            .left:
