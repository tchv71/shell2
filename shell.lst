 1713 2ABB ~            .shr:
 1714 2ABB ~                IFDEF X80_OPT_SIZE
 1715 2ABB ~                PUSH BC
 1716 2ABB ~                CALL __x80_fp_shr
 1717 2ABB ~                POP  BC
 1718 2ABB ~                ELSE
