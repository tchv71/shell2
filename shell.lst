 8370 2C46                  IFUSED __x80_halt
 8371 2C46 ~            ; ---------------------------------------------------------------------------
 8372 2C46 ~            ; The end of a program that stops itself: exit, abort. HALT, and HALT again if
 8373 2C46 ~            ; an interrupt wakes it -- there is nothing to return to.
 8374 2C46 ~            ; ---------------------------------------------------------------------------
 8375 2C46 ~            __x80_halt:
 8376 2C46 ~                HALT
 8377 2C46 ~                JP   __x80_halt
 8378 2C46                  ENDIF
 8379 2C46              ;@end
