 6774 2C43
 6775 2C43              ; ---------------------------------------------------------------------------
 6776 2C43              ; HL = destination, DE = source: __x80_mcpy_N copies N bytes, N from 1 to 32:
 6777 2C43              ; a block whose size the compiler knows, a struct assigned, in a CALL of three
 6778 2C43              ; bytes where LD BC,N and a CALL of __x80_memcpy were six (ivagor, zx-pk.ru).
 6779 2C43              ; Writes A, C, DE and HL; leaves B alone.
 6780 2C43              ;
 6781 2C43              ; Two ways of doing it, and the shorter for the sizes the program uses is the
 6782 2C43              ; one assembled -- the program's own calls are the same either way:
 6783 2C43              ;
 6784 2C43              ; (a) One tail of steps unrolled, entered at the step for the count: 24
 6785 2C43              ;     T-states a byte, 4 * M - 1 bytes for the largest size M up to 16;
 6786 2C43              ;     the sizes above that by (b).
 6787 2C43              ; (b) One loop counting in C, 39 T-states a byte against 47 in __x80_memcpy's,
 6788 2C43              ;     and an entry for each size: `LD C,N` and a byte 3AH -- LD A,(nn), which
 6789 2C43              ;     takes the next entry's LD C,N for its address and so passes over it --
 6790 2C43              ;     the smallest size's entry falling into the loop. 8 + 3 * sizes bytes.
 6791 2C43              ;
 6792 2C43              ; -O3 takes (a) whatever it costs. The sizes used are counted first, every
 6793 2C43              ; entry under IFUSED; then the arithmetic; then the code, laid out so that
 6794 2C43              ; every way through it ends in a RET: what the compiler reads of this file
 6795 2C43              ; to know the registers a routine writes follows the code to its RET.
 6796 2C43              ; ---------------------------------------------------------------------------
 6797 2C43              __x80_mcpy_d = 0                    ; the sizes used
 6798 2C43              __x80_mcpy_db = 0                   ; of them above 16
 6799 2C43              __x80_mcpy_m = 0                    ; the largest up to 16
 6800 2C43              __x80_mcpy_lo = 0                   ; the smallest
 6801 2C43              __x80_mcpy_lb = 0                   ; the smallest above 16
