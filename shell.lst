 1597 2ABB ~                LD   A,(__x80_fpa+2)
 1598 2ABB ~                CP   (HL)
 1599 2ABB ~                JP   NZ,.compared
 1600 2ABB ~                DEC  HL
 1601 2ABB ~                LD   A,(__x80_fpa+1)
 1602 2ABB ~                CP   (HL)
 1603 2ABB ~                JP   NZ,.compared
 1604 2ABB ~                DEC  HL
 1605 2ABB ~                LD   A,(__x80_fpa)
 1606 2ABB ~                CP   (HL)
