 3336 2ABA ~                LD   L,H
 3337 2ABA ~                LD   H,E
 3338 2ABA ~                LD   E,D
 3339 2ABA ~                LD   D,A
 3340 2ABA ~                RET
 3341 2ABA ~            __x80_fp_inf:
 3342 2ABA ~                LD   A,(__x80_fps)
 3343 2ABA ~                OR   7FH
 3344 2ABA ~                LD   D,A
 3345 2ABA ~                LD   E,80H
 3346 2ABA ~                LD   HL,0
 3347 2ABA ~                RET
