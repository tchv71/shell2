 2811 2ABB                  IFUSED __x80_fp_isnan
 2812 2ABB ~            ; Carry set if the float at HL is a NaN: the exponent all ones and the fraction not zero.
 2813 2ABB ~            __x80_fp_isnan:
 2814 2ABB ~                INC  HL
 2815 2ABB ~                INC  HL
