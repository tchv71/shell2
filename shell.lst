 8240 2C42                  IFUSED __x80_call_hl
 8241 2C42 ~            ; ---------------------------------------------------------------------------
 8242 2C42 ~            ; Calls the address in HL, for a call through a pointer that gives HL to no
 8243 2C42 ~            ; argument: CALL here and JP (HL), the callee's RET coming back to the caller.
 8244 2C42 ~            ; Five T-states against __x80_call_bc's twenty-one, and the address is most
 8245 2C42 ~            ; often in HL already. A call in the last place, CALL / RET, is a jump here, and
 8246 2C42 ~            ; the compiler writes JP (HL) itself (emit.c) -- not in an interrupt's code,
 8247 2C42 ~            ; whose copy of this turns the address into the function's copy first
 8248 2C42 ~            ; (marinovsoft, zx-pk.ru).
 8249 2C42 ~            ; ---------------------------------------------------------------------------
 8250 2C42 ~            __x80_call_hl:
 8251 2C42 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8252 2C42 ~                JP   (HL)
 8253 2C42                  ENDIF
 8254 2C42
 8255 2C42                  IFUSED __x80_call_bc
 8256 2C42
 8257 2C42              ; ---------------------------------------------------------------------------
 8258 2C42              ; Calls the address in BC. The processor has no indirect CALL, and this is the
 8259 2C42              ; cheapest stand-in that clobbers nothing: PUSH BC puts the target on the stack
 8260 2C42              ; above the return address the caller's CALL pushed, RET jumps to it, and the
 8261 2C42              ; callee's own RET then finds the caller's address underneath and comes back.
 8262 2C42              ;
 8263 2C42              ; BC because the convention offers the pairs to arguments in the order HL, DE,
 8264 2C42              ; BC, so this is the one least likely to be wanted for something else. JP (HL)
 8265 2C42              ; would be five T-states rather than twenty-one, but HL is the first pair an
 8266 2C42              ; argument gets.
 8267 2C42              ; ---------------------------------------------------------------------------
 8268 2C42              __x80_call_bc:
 8269 2C42              ;@irq    PUSH HL             ; an interrupt's copy: to the function's copy (__x80_xlat)
 8270 2C42              ;@irq    LD   H,B
 8271 2C42              ;@irq    LD   L,C
 8272 2C42              ;@irq    CALL __x80_xlat
 8273 2C42              ;@irq    LD   B,H
 8274 2C42              ;@irq    LD   C,L
 8275 2C42              ;@irq    POP  HL
 8276 2C42 C5               PUSH BC
 8277 2C43 C9               RET
 8278 2C44                  ENDIF
 8279 2C44
 8280 2C44                  IFUSED __x80_call_mem
 8281 2C44 ~            ; ---------------------------------------------------------------------------
 8282 2C44 ~            ; Calls the address in __x80_call_target, for a call through a pointer whose
 8283 2C44 ~            ; arguments fill HL, DE and BC: the address could go in no register. EX (SP),HL
 8284 2C44 ~            ; puts it on the stack and gives HL back, and RET jumps to it with the caller's
 8285 2C44 ~            ; return address underneath. Forty-three T-states.
 8286 2C44 ~            ; ---------------------------------------------------------------------------
 8287 2C44 ~            __x80_call_mem:
 8288 2C44 ~                PUSH HL
 8289 2C44 ~                LD   HL,(__x80_call_target)
 8290 2C44 ~            ;@irq    CALL __x80_xlat     ; an interrupt's copy: to the function's copy
 8291 2C44 ~                EX   (SP),HL
 8292 2C44 ~                RET
 8293 2C44                  ENDIF
 8294 2C44
 8295 2C44                  IFUSED _setjmp
 8296 2C44 ~            ; ---------------------------------------------------------------------------
 8297 2C44 ~            ; setjmp(env), env in HL (lib/include/setjmp.h): the return address, and the
 8298 2C44 ~            ; stack pointer as it will be once this returns. Every register is the caller's
 8299 2C44 ~            ; to save, so those two words are all there is.
 8300 2C44 ~            ; ---------------------------------------------------------------------------
 8301 2C44 ~            _setjmp:
 8302 2C44 ~                POP  DE             ; the return address
 8303 2C44 ~                PUSH DE
 8304 2C44 ~                LD   (HL),E
 8305 2C44 ~                INC  HL
 8306 2C44 ~                LD   (HL),D
 8307 2C44 ~                INC  HL
 8308 2C44 ~                EX   DE,HL          ; DE -> the second word
 8309 2C44 ~                LD   HL,2
 8310 2C44 ~                ADD  HL,SP          ; the caller's SP after the return
 8311 2C44 ~                EX   DE,HL
 8312 2C44 ~                LD   (HL),E
 8313 2C44 ~                INC  HL
 8314 2C44 ~                LD   (HL),D
 8315 2C44 ~                LD   HL,0
 8316 2C44 ~                RET
 8317 2C44                  ENDIF
 8318 2C44
 8319 2C44                  IFUSED _longjmp
 8320 2C44 ~            ; ---------------------------------------------------------------------------
 8321 2C44 ~            ; longjmp(env, val), env in HL and val in DE: back to where setjmp returned,
 8322 2C44 ~            ; returning val there -- or 1, if val is 0.
 8323 2C44 ~            ; ---------------------------------------------------------------------------
 8324 2C44 ~            _longjmp:
 8325 2C44 ~                LD   A,D
 8326 2C44 ~                OR   E
 8327 2C44 ~                JP   NZ,.value
 8328 2C44 ~                INC  DE
 8329 2C44 ~            .value:
 8330 2C44 ~                LD   C,(HL)
 8331 2C44 ~                INC  HL
 8332 2C44 ~                LD   B,(HL)         ; BC = where to go
 8333 2C44 ~                INC  HL
 8334 2C44 ~                LD   A,(HL)
 8335 2C44 ~                INC  HL
 8336 2C44 ~                LD   H,(HL)
 8337 2C44 ~                LD   L,A
 8338 2C44 ~                LD   SP,HL          ; the stack as setjmp's caller had it
 8339 2C44 ~                EX   DE,HL          ; the value, in HL
 8340 2C44 ~                PUSH BC
 8341 2C44 ~                RET
 8342 2C44                  ENDIF
 8343 2C44
 8344 2C44                  IFUSED __x80_sp
 8345 2C44 ~            ; ---------------------------------------------------------------------------
 8346 2C44 ~            ; The stack pointer, in HL: where the C library's heap has to stop. Its own
 8347 2C44 ~            ; return address is on the stack, so the caller sees two bytes less than it had.
 8348 2C44 ~            ; ---------------------------------------------------------------------------
 8349 2C44 ~            __x80_sp:
 8350 2C44 ~                LD   HL,0
 8351 2C44 ~                ADD  HL,SP
 8352 2C44 ~                RET
 8353 2C44                  ENDIF
 8354 2C44
 8355 2C44              ;@shared
 8356 2C44                  IFNDEF X80_EXIT_DEFINED
 8357 2C44                  IFUSED __x80_exit
 8358 2C44 ~            ; ---------------------------------------------------------------------------
 8359 2C44 ~            ; How a program ends when it calls exit, _Exit or abort, the status in HL. On
 8360 2C44 ~            ; the machine there is nobody to tell, so it halts; a test platform defines
 8361 2C44 ~            ; __x80_exit itself, before this file, with DEFINE X80_EXIT_DEFINED -- IFNDEF
 8362 2C44 ~            ; tests DEFINEs, not labels -- and reports the status instead
 8363 2C44 ~            ; (lib/crt/test_start.asm).
 8364 2C44 ~            ; ---------------------------------------------------------------------------
 8365 2C44 ~            __x80_exit:
 8366 2C44 ~                JP   __x80_halt
 8367 2C44                  ENDIF
 8368 2C44                  ENDIF
 8369 2C44
 8370 2C44                  IFUSED __x80_halt
 8371 2C44 ~            ; ---------------------------------------------------------------------------
 8372 2C44 ~            ; The end of a program that stops itself: exit, abort. HALT, and HALT again if
 8373 2C44 ~            ; an interrupt wakes it -- there is nothing to return to.
 8374 2C44 ~            ; ---------------------------------------------------------------------------
 8375 2C44 ~            __x80_halt:
 8376 2C44 ~                HALT
 8377 2C44 ~                JP   __x80_halt
 8378 2C44                  ENDIF
 8379 2C44              ;@end
 8380 2C44
 8381 2C44                  IFUSED __x80_rt_a
 8382 2C44              ; ---------------------------------------------------------------------------
 8383 2C44              ; Working space, for division. Like every object that starts as zeros, not in the image: an
 8384 2C44              ; address below __x80_bss_top that the startup code clears.
 8385 2C44              ; ---------------------------------------------------------------------------
 8386 2C44              __x80_bss_off = __x80_bss_off + 4
 8387 2C44              __x80_rt_a EQU __x80_bss_top - __x80_bss_off      ; the dividend, then the quotient
 8388 2C44                  ENDIF
 8389 2C44
 8390 2C44                  IFUSED __x80_rt_b
