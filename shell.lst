 1241 2ABB ~                RRCA
 1242 2ABB ~                RRCA
 1243 2ABB ~                RRCA
 1244 2ABB ~                AND  0FH
 1245 2ABB ~                LD   C,A
 1246 2ABB ~                LD   A,D
 1247 2ABB ~                RLCA
 1248 2ABB ~                RLCA
 1249 2ABB ~                RLCA
 1250 2ABB ~                RLCA
 1251 2ABB ~                OR   C
 1252 2ABB ~                LD   C,A                ; its top seven bits
 1253 2ABB ~                LD   A,E
