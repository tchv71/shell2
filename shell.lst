 5399 2BEC ~                LD   D,0
 5400 2BEC ~                LD   L,A
 5401 2BEC ~                LD   H,D
 5402 2BEC ~                RET
 5403 2BEC ~            .two:
 5404 2BEC ~                PUSH HL             ; the low byte, for the second pass
