 4039 2ABB ~                LD   D,B
 4040 2ABB ~                LD   E,C
 4041 2ABB ~                CALL __x80_mul16
 4042 2ABB ~                POP  DE
 4043 2ABB ~                ADD  HL,DE
 4044 2ABB ~                EX   DE,HL
 4045 2ABB ~                RET
 4046 2ABB ~            .minus:
 4047 2ABB ~                LD   A,E
 4048 2ABB ~                SUB  C
 4049 2ABB ~                LD   E,A
 4050 2ABB ~                LD   A,D
 4051 2ABB ~                SBC  A,B
 4052 2ABB ~                LD   D,A
 4053 2ABB ~                RET
