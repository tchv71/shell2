 5878 2C1A                  IFUSED __x80_mul16_lead
 5879 2C1A ~            ; HL = BC * A, with HL = BC on entry: what __x80_mul16 takes for a byte, and what the compiler calls
 5880 2C1A ~            ; for a word by a byte widened (isel.c, select_muldiv). The multiplier's zeros before its top one
 5881 2C1A ~            ; are passed over, the top one is HL as it came, and the steps for the bits after it are
 5882 2C1A ~            ; __x80_mul16_byte's from there; no one in it at all leaves A zero, and the product is zero.
 5883 2C1A ~            ; -O3 only (__x80_mul16); otherwise the eight steps from zero.
 5884 2C1A ~            __x80_mul16_lead:
 5885 2C1A ~                IFNDEF X80_OPT_SPEED
 5886 2C1A ~                LD   HL,0
 5887 2C1A ~                JP   __x80_mul16_byte
 5888 2C1A ~                ELSE
 5889 2C1A ~                ADD  A,A
 5890 2C1A ~                JP   C,__x80_mul16_b7
 5891 2C1A ~                ADD  A,A
 5892 2C1A ~                JP   C,__x80_mul16_b6
 5893 2C1A ~                ADD  A,A
 5894 2C1A ~                JP   C,__x80_mul16_b5
 5895 2C1A ~                ADD  A,A
 5896 2C1A ~                JP   C,__x80_mul16_b4
 5897 2C1A ~                ADD  A,A
 5898 2C1A ~                JP   C,__x80_mul16_b3
 5899 2C1A ~                ADD  A,A
 5900 2C1A ~                JP   C,__x80_mul16_b2
 5901 2C1A ~                ADD  A,A
 5902 2C1A ~                JP   C,__x80_mul16_b1
 5903 2C1A ~                RET  M                  ; the last bit the top one: HL = BC
 5904 2C1A ~                LD   HL,0               ; no one at all
 5905 2C1A ~                RET
 5906 2C1A ~                ENDIF
 5907 2C1A ~                ASSERT __x80_mul16_byte ; which has the steps
 5908 2C1A                  ENDIF
