 6217 2C1A ~                LD   A,E                ; s - d
 6218 2C1A ~                SUB  L
 6219 2C1A ~                LD   A,D
 6220 2C1A ~                SBC  A,H
 6221 2C1A ~                JP   NZ,.up_far
