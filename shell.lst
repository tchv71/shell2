  468 2ABB ~                OR   A
  469 2ABB ~                LD   A,(HL)
  470 2ABB ~                RLA
  471 2ABB ~                LD   (HL),A
  472 2ABB ~                INC  HL
  473 2ABB ~                LD   A,(HL)
  474 2ABB ~                RLA
  475 2ABB ~                LD   (HL),A
  476 2ABB ~                INC  HL
  477 2ABB ~                LD   A,(HL)
  478 2ABB ~                RLA
  479 2ABB ~                LD   (HL),A
  480 2ABB ~                INC  HL
  481 2ABB ~                LD   A,(HL)
  482 2ABB ~                RLA
  483 2ABB ~                LD   (HL),A
  484 2ABB ~                INC  HL
  485 2ABB ~                LD   A,(HL)
  486 2ABB ~                RLA
  487 2ABB ~                LD   (HL),A
  488 2ABB ~                INC  HL
  489 2ABB ~                LD   A,(HL)
  490 2ABB ~                RLA
  491 2ABB ~                LD   (HL),A
  492 2ABB ~                INC  HL
  493 2ABB ~                LD   A,(HL)
  494 2ABB ~                RLA
  495 2ABB ~                LD   (HL),A
  496 2ABB ~                INC  HL
  497 2ABB ~                LD   A,(HL)
  498 2ABB ~                RLA
  499 2ABB ~                LD   (HL),A
  500 2ABB ~                DEC  B
  501 2ABB ~                JP   NZ,.bit
