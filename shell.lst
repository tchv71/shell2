 5319 2BD8                  IFUSED __x80_udiv16
 5320 2BD8
 5321 2BD8              ; ---------------------------------------------------------------------------
 5322 2BD8              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 2BD8              ;
 5324 2BD8              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 2BD8              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 2BD8              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 2BD8              ; one of 32768 or more, a quotient of 0 or 1.
 5328 2BD8              ;
 5329 2BD8              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 2BD8              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 2BD8              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 2BD8              ; ---------------------------------------------------------------------------
 5333 2BD8              __x80_udiv16:
 5334 2BD8                  IFDEF X80_OPT_SIZE
 5335 2BD8                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 2BD8                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 2BD8                  ; bits go in, the divisor in BC, the count on the stack.
 5338 2BD8 7A               LD   A,D
 5339 2BD9 B3               OR   E
 5340 2BDA CA 07 2C         JP   Z,.s_zero
 5341 2BDD 42               LD   B,D
 5342 2BDE 4B               LD   C,E
 5343 2BDF EB               EX   DE,HL
 5344 2BE0 21 00 00         LD   HL,0
 5345 2BE3 3E 10            LD   A,16
 5346 2BE5              .s_loop:
 5347 2BE5 F5               PUSH AF
 5348 2BE6 EB               EX   DE,HL
 5349 2BE7 29               ADD  HL,HL              ; the dividend's top bit out, a 0 in for the quotient's bit
 5350 2BE8 EB               EX   DE,HL
 5351 2BE9 7D               LD   A,L                ; and into the remainder, the carry its seventeenth bit
 5352 2BEA 17               RLA
 5353 2BEB 6F               LD   L,A
 5354 2BEC 7C               LD   A,H
 5355 2BED 17               RLA
 5356 2BEE 67               LD   H,A
 5357 2BEF DA F9 2B         JP   C,.s_take
 5358 2BF2 7D               LD   A,L
 5359 2BF3 91               SUB  C
 5360 2BF4 7C               LD   A,H
 5361 2BF5 98               SBC  A,B
 5362 2BF6 DA 00 2C         JP   C,.s_next          ; below the divisor: a 0
 5363 2BF9              .s_take:
 5364 2BF9 7D               LD   A,L
 5365 2BFA 91               SUB  C
 5366 2BFB 6F               LD   L,A
 5367 2BFC 7C               LD   A,H
 5368 2BFD 98               SBC  A,B
 5369 2BFE 67               LD   H,A
 5370 2BFF 1C               INC  E
 5371 2C00              .s_next:
 5372 2C00 F1               POP  AF
 5373 2C01 3D               DEC  A
 5374 2C02 C2 E5 2B         JP   NZ,.s_loop
 5375 2C05 EB               EX   DE,HL
 5376 2C06 C9               RET
 5377 2C07              .s_zero:
 5378 2C07 21 FF FF         LD   HL,0FFFFH
 5379 2C0A 11 00 00         LD   DE,0
 5380 2C0D C9               RET
 5381 2C0E                  ELSE
 5382 2C0E ~                LD   A,D
 5383 2C0E ~                OR   A
 5384 2C0E ~                JP   NZ,.wide
 5385 2C0E ~                OR   E
 5386 2C0E ~                JP   Z,.by_zero
 5387 2C0E ~                LD   A,H
 5388 2C0E ~                CP   E
 5389 2C0E ~                JP   NC,.two
 5390 2C0E ~                OR   A
 5391 2C0E ~                JP   NZ,.one
 5392 2C0E ~                LD   A,L            ; below the divisor: the dividend is the remainder
 5393 2C0E ~                CP   E
 5394 2C0E ~                JP   C,.below
 5395 2C0E ~            .one:
 5396 2C0E ~                CALL __x80_dsetup8  ; the high byte below the divisor: one pass
 5397 2C0E ~                CALL __x80_dpass8
 5398 2C0E ~                LD   E,H            ; the remainder
 5399 2C0E ~                LD   D,0
 5400 2C0E ~                LD   L,A
 5401 2C0E ~                LD   H,D
 5402 2C0E ~                RET
 5403 2C0E ~            .two:
 5404 2C0E ~                PUSH HL             ; the low byte, for the second pass
 5405 2C0E ~                CALL __x80_dsetup8
 5406 2C0E ~                LD   L,H            ; the high byte alone first
 5407 2C0E ~                LD   H,0
 5408 2C0E ~                CALL __x80_dpass8   ; its quotient in A, the remainder in H
 5409 2C0E ~                LD   L,A
 5410 2C0E ~                EX   (SP),HL        ; that kept; the dividend back
