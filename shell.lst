 3555 2ADE ~                CALL __x80_q_take2
 3556 2ADE ~                CALL __x80_q_divide
 3557 2ADE ~                LD   HL,__x80_qa
 3558 2ADE ~                JP   __x80_q_give
 3559 2ADE                  ENDIF
