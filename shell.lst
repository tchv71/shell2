 2479 2ABB                  IFUSED __x80_fcmp
 2480 2ABB ~            ; ---------------------------------------------------------------------------
 2481 2ABB ~            ; A = 0 if a = b, 1 if a < b, 2 if a > b, 3 if either is a NaN. Two zeros are equal whatever
 2482 2ABB ~            ; their signs; otherwise floats of one sign are ordered as their bits are, upside down for
 2483 2ABB ~            ; negative ones.
 2484 2ABB ~            ;
 2485 2ABB ~            ; Straight from the registers and the stack while neither exponent's top seven bits are all
 2486 2ABB ~            ; ones, so neither can be a NaN; else the full path through fpa and fpb. -Os has the full path
 2487 2ABB ~            ; alone, some 70 bytes less.
 2488 2ABB ~            ; ---------------------------------------------------------------------------
 2489 2ABB ~            __x80_fcmp:
 2490 2ABB ~                IFNDEF X80_OPT_SIZE
 2491 2ABB ~                PUSH HL                 ; a's low word
 2492 2ABB ~                LD   HL,5
 2493 2ABB ~                ADD  HL,SP              ; b's top byte
 2494 2ABB ~                LD   A,(HL)
 2495 2ABB ~                ADD  A,A
 2496 2ABB ~                CP   0FEH
 2497 2ABB ~                JP   NC,.full_pop
 2498 2ABB ~                LD   A,D
 2499 2ABB ~                ADD  A,A
 2500 2ABB ~                CP   0FEH
 2501 2ABB ~                JP   NC,.full_pop
 2502 2ABB ~                LD   A,D
 2503 2ABB ~                XOR  (HL)
 2504 2ABB ~                JP   M,.fast_signs
 2505 2ABB ~                LD   A,D                ; one sign: their bits compared
 2506 2ABB ~                CP   (HL)
 2507 2ABB ~                JP   NZ,.fast_high
 2508 2ABB ~                DEC  HL
 2509 2ABB ~                LD   A,E
 2510 2ABB ~                CP   (HL)
 2511 2ABB ~                JP   NZ,.fast_high
 2512 2ABB ~                POP  HL
 2513 2ABB ~                LD   A,H
 2514 2ABB ~                CP   B
 2515 2ABB ~                JP   NZ,.fast_differ
 2516 2ABB ~                LD   A,L
 2517 2ABB ~                CP   C
 2518 2ABB ~                JP   NZ,.fast_differ
 2519 2ABB ~                XOR  A
 2520 2ABB ~                RET
 2521 2ABB ~            .fast_high:
 2522 2ABB ~                POP  HL
 2523 2ABB ~            .fast_differ:               ; the carry: a's bits below b's, so a < b if they are positive
 2524 2ABB ~                SBC  A,A
 2525 2ABB ~                XOR  D
 2526 2ABB ~                ADD  A,A
 2527 2ABB ~                LD   A,1
 2528 2ABB ~                RET  C
 2529 2ABB ~                INC  A
 2530 2ABB ~                RET
 2531 2ABB ~            .fast_signs:                ; two signs: equal if both are zeros, else the negative one less
 2532 2ABB ~                LD   A,(HL)
 2533 2ABB ~                ADD  A,A
 2534 2ABB ~                DEC  HL
 2535 2ABB ~                OR   (HL)
 2536 2ABB ~                OR   B
 2537 2ABB ~                OR   C
 2538 2ABB ~                LD   B,A
 2539 2ABB ~                LD   A,D
 2540 2ABB ~                ADD  A,A
 2541 2ABB ~                OR   B
 2542 2ABB ~                OR   E
 2543 2ABB ~                POP  HL
 2544 2ABB ~                OR   H
 2545 2ABB ~                OR   L
 2546 2ABB ~                RET  Z
 2547 2ABB ~                LD   A,D
 2548 2ABB ~                ADD  A,A
 2549 2ABB ~                LD   A,1
 2550 2ABB ~                RET  C
 2551 2ABB ~                INC  A
 2552 2ABB ~                RET
 2553 2ABB ~            .full_pop:
 2554 2ABB ~                POP  HL
 2555 2ABB ~                ENDIF
 2556 2ABB ~                CALL __x80_fp_load2
 2557 2ABB ~                LD   HL,__x80_fpa
 2558 2ABB ~                CALL __x80_fp_isnan
 2559 2ABB ~                JP   C,.unordered
 2560 2ABB ~                LD   HL,__x80_fpb
 2561 2ABB ~                CALL __x80_fp_isnan
 2562 2ABB ~                JP   C,.unordered
 2563 2ABB ~                LD   HL,__x80_fpa
 2564 2ABB ~                CALL __x80_fp_class
 2565 2ABB ~                JP   C,.bits
 2566 2ABB ~                JP   NZ,.bits
 2567 2ABB ~                LD   HL,__x80_fpb
 2568 2ABB ~                CALL __x80_fp_class
 2569 2ABB ~                JP   C,.bits
 2570 2ABB ~                RET  Z                  ; two zeros: A = 0
 2571 2ABB ~            .bits:
 2572 2ABB ~                LD   HL,__x80_fpb+3
 2573 2ABB ~                LD   DE,__x80_fpa+3
 2574 2ABB ~                LD   B,4
 2575 2ABB ~            .byte:
 2576 2ABB ~                LD   A,(DE)
 2577 2ABB ~                CP   (HL)
 2578 2ABB ~                JP   NZ,.differ
 2579 2ABB ~                DEC  HL
 2580 2ABB ~                DEC  DE
 2581 2ABB ~                DEC  B
 2582 2ABB ~                JP   NZ,.byte
 2583 2ABB ~                XOR  A
 2584 2ABB ~                RET
 2585 2ABB ~            .differ:                    ; the carry: a's bits below b's
 2586 2ABB ~                LD   A,0
 2587 2ABB ~                RLA
 2588 2ABB ~                LD   C,A
 2589 2ABB ~                LD   A,(__x80_fpa+3)
 2590 2ABB ~                LD   B,A
 2591 2ABB ~                LD   HL,__x80_fpb+3
 2592 2ABB ~                XOR  (HL)
 2593 2ABB ~                LD   A,B
 2594 2ABB ~                JP   M,.signs
 2595 2ABB ~                RLCA                    ; a's sign, and so b's, in bit 0
 2596 2ABB ~                XOR  C
 2597 2ABB ~                RRA
 2598 2ABB ~                LD   A,2
 2599 2ABB ~                RET  NC                 ; the bits ordered as the numbers: greater
 2600 2ABB ~                DEC  A
 2601 2ABB ~                RET
 2602 2ABB ~            .signs:
 2603 2ABB ~                RLCA
 2604 2ABB ~                LD   A,1
 2605 2ABB ~                RET  C                  ; a the negative one
 2606 2ABB ~                INC  A
 2607 2ABB ~                RET
 2608 2ABB ~            .unordered:
 2609 2ABB ~                LD   A,3
 2610 2ABB ~                RET
 2611 2ABB                  ENDIF
