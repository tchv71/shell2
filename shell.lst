 4311 2ADD              __x80_quotient:
 4312 2ADD 2A 50 2C         LD   HL,(__x80_rt_a+2)
 4313 2AE0 EB               EX   DE,HL
 4314 2AE1 2A 4E 2C         LD   HL,(__x80_rt_a)
 4315 2AE4 C9               RET
 4316 2AE5                  ENDIF
 4317 2AE5
 4318 2AE5                  IFUSED __x80_remainder
 4319 2AE5
 4320 2AE5              __x80_remainder:
 4321 2AE5 2A 48 2C         LD   HL,(__x80_rt_r+2)
 4322 2AE8 EB               EX   DE,HL
 4323 2AE9 2A 46 2C         LD   HL,(__x80_rt_r)
 4324 2AEC C9               RET
 4325 2AED                  ENDIF
 4326 2AED
 4327 2AED                  IFUSED __x80_divide
 4328 2AED
 4329 2AED              __x80_divide:
 4330 2AED                  IFDEF X80_OPT_SIZE
 4331 2AED                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2AED                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2AED                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2AED                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2AED                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2AED 2A 4A 2C         LD   HL,(__x80_rt_b)
 4337 2AF0 7C               LD   A,H
 4338 2AF1 B5               OR   L
 4339 2AF2 2A 4C 2C         LD   HL,(__x80_rt_b+2)
 4340 2AF5 B4               OR   H
 4341 2AF6 B5               OR   L
 4342 2AF7 CA 9A 2B         JP   Z,.s_zero
 4343 2AFA 21 4A 2C         LD   HL,__x80_rt_b
 4344 2AFD 11 46 2C         LD   DE,__x80_rt_r
 4345 2B00 06 04            LD   B,4
 4346 2B02              .s_not:
 4347 2B02 7E               LD   A,(HL)
 4348 2B03 2F               CPL
 4349 2B04 12               LD   (DE),A
 4350 2B05 23               INC  HL
 4351 2B06 13               INC  DE
 4352 2B07 05               DEC  B
 4353 2B08 C2 02 2B         JP   NZ,.s_not
 4354 2B0B 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 2B0D              .s_skip:                    ; remainder zero still and the quotient's bits 0
 4356 2B0D 3A 51 2C         LD   A,(__x80_rt_a+3)
 4357 2B10 B7               OR   A
 4358 2B11 C2 2B 2B         JP   NZ,.s_go
 4359 2B14 2A 4F 2C         LD   HL,(__x80_rt_a+1)
 4360 2B17 22 50 2C         LD   (__x80_rt_a+2),HL
 4361 2B1A 3A 4E 2C         LD   A,(__x80_rt_a)
 4362 2B1D 32 4F 2C         LD   (__x80_rt_a+1),A
 4363 2B20 AF               XOR  A
 4364 2B21 32 4E 2C         LD   (__x80_rt_a),A
 4365 2B24 78               LD   A,B
 4366 2B25 D6 08            SUB  8
 4367 2B27 47               LD   B,A
 4368 2B28 C2 0D 2B         JP   NZ,.s_skip
 4369 2B2B              .s_go:
 4370 2B2B 21 00 00         LD   HL,0
 4371 2B2E 54               LD   D,H
 4372 2B2F 5D               LD   E,L
 4373 2B30 78               LD   A,B
 4374 2B31 B7               OR   A
 4375 2B32 CA 92 2B         JP   Z,.s_done          ; a dividend of zero
 4376 2B35              .s_loop:
 4377 2B35 F5               PUSH AF
 4378 2B36 3A 4E 2C         LD   A,(__x80_rt_a)     ; the dividend's top bit out, a 0 in for the quotient's bit
 4379 2B39 87               ADD  A,A
 4380 2B3A 32 4E 2C         LD   (__x80_rt_a),A
 4381 2B3D 3A 4F 2C         LD   A,(__x80_rt_a+1)
 4382 2B40 17               RLA
 4383 2B41 32 4F 2C         LD   (__x80_rt_a+1),A
 4384 2B44 3A 50 2C         LD   A,(__x80_rt_a+2)
 4385 2B47 17               RLA
 4386 2B48 32 50 2C         LD   (__x80_rt_a+2),A
 4387 2B4B 3A 51 2C         LD   A,(__x80_rt_a+3)
 4388 2B4E 17               RLA
 4389 2B4F 32 51 2C         LD   (__x80_rt_a+3),A
 4390 2B52 7D               LD   A,L                ; and into the remainder, the carry its thirty-third bit
 4391 2B53 17               RLA
 4392 2B54 6F               LD   L,A
 4393 2B55 7C               LD   A,H
 4394 2B56 17               RLA
 4395 2B57 67               LD   H,A
 4396 2B58 7B               LD   A,E
 4397 2B59 17               RLA
 4398 2B5A 5F               LD   E,A
 4399 2B5B 7A               LD   A,D
 4400 2B5C 17               RLA
 4401 2B5D 57               LD   D,A
 4402 2B5E 01 46 2C         LD   BC,__x80_rt_r
 4403 2B61 DA 76 2B         JP   C,.s_take          ; above the divisor whatever the rest
 4404 2B64 37               SCF                     ; R + ~d + 1: the carry if R is not below d
 4405 2B65 0A               LD   A,(BC)
 4406 2B66 8D               ADC  A,L
 4407 2B67 03               INC  BC
 4408 2B68 0A               LD   A,(BC)
 4409 2B69 8C               ADC  A,H
 4410 2B6A 03               INC  BC
 4411 2B6B 0A               LD   A,(BC)
 4412 2B6C 8B               ADC  A,E
 4413 2B6D 03               INC  BC
 4414 2B6E 0A               LD   A,(BC)
 4415 2B6F 8A               ADC  A,D
 4416 2B70 D2 8D 2B         JP   NC,.s_next
 4417 2B73 01 46 2C         LD   BC,__x80_rt_r
 4418 2B76              .s_take:
 4419 2B76 37               SCF                     ; d taken off, and a 1
 4420 2B77 0A               LD   A,(BC)
 4421 2B78 8D               ADC  A,L
 4422 2B79 6F               LD   L,A
 4423 2B7A 03               INC  BC
 4424 2B7B 0A               LD   A,(BC)
 4425 2B7C 8C               ADC  A,H
 4426 2B7D 67               LD   H,A
 4427 2B7E 03               INC  BC
 4428 2B7F 0A               LD   A,(BC)
 4429 2B80 8B               ADC  A,E
 4430 2B81 5F               LD   E,A
 4431 2B82 03               INC  BC
 4432 2B83 0A               LD   A,(BC)
 4433 2B84 8A               ADC  A,D
 4434 2B85 57               LD   D,A
 4435 2B86 3A 4E 2C         LD   A,(__x80_rt_a)
 4436 2B89 3C               INC  A
 4437 2B8A 32 4E 2C         LD   (__x80_rt_a),A
 4438 2B8D              .s_next:
 4439 2B8D F1               POP  AF
 4440 2B8E 3D               DEC  A
 4441 2B8F C2 35 2B         JP   NZ,.s_loop
 4442 2B92              .s_done:
 4443 2B92 22 46 2C         LD   (__x80_rt_r),HL
 4444 2B95 EB               EX   DE,HL
 4445 2B96 22 48 2C         LD   (__x80_rt_r+2),HL
 4446 2B99 C9               RET
 4447 2B9A              .s_zero:
 4448 2B9A 2A 4E 2C         LD   HL,(__x80_rt_a)    ; as below: all ones, and the dividend left over
 4449 2B9D 22 46 2C         LD   (__x80_rt_r),HL
 4450 2BA0 2A 50 2C         LD   HL,(__x80_rt_a+2)
 4451 2BA3 22 48 2C         LD   (__x80_rt_r+2),HL
 4452 2BA6 21 FF FF         LD   HL,0FFFFH
 4453 2BA9 22 4E 2C         LD   (__x80_rt_a),HL
 4454 2BAC 22 50 2C         LD   (__x80_rt_a+2),HL
 4455 2BAF C9               RET
