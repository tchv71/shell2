 5309 2BD2              ; ---------------------------------------------------------------------------
 5310 2BD2              ; HL = HL % DE, unsigned.
 5311 2BD2              ; ---------------------------------------------------------------------------
 5312 2BD2              __x80_urem16:
 5313 2BD2 CD D8 2B         CALL __x80_udiv16
