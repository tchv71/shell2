  910 2ABB ~            ; ---------------------------------------------------------------------------
  911 2ABB ~            ; qa = the significand in qa, its leading one at bit 63, truncated to an integer, given HL = its
  912 2ABB ~            ; exponent less the bias and A the first one too large -- 63 for long long, 64 for unsigned long
