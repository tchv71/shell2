 1608 2ABB ~                JP   NC,.in_order
 1609 2ABB ~            .swap:
 1610 2ABB ~                LD   HL,(__x80_fpa)
 1611 2ABB ~                EX   DE,HL
 1612 2ABB ~                LD   HL,(__x80_fpb)
