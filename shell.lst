 5964 2C1A                  IFUSED __x80_shl16
 5965 2C1A ~
 5966 2C1A ~            ; ---------------------------------------------------------------------------
 5967 2C1A ~            ; HL = HL shifted by E, the three shifts. A count of sixteen or more is undefined
 5968 2C1A ~            ; in C (6.5.7p3), and what happens here for one from 16 to 255 is that the value
 5969 2C1A ~            ; ends up zero (or all sign bits), which is the same answer the constant case
 5970 2C1A ~            ; gives. D, the count's high byte, is not read: a count that needs it is one of
 5971 2C1A ~            ; those, and testing it would cost every call (ivagor, zx-pk.ru). The count is tested with
 5972 2C1A ~            ; XOR A / OR E rather than LD A,E / OR A: a T-state less on the 8080, four on the
 5973 2C1A ~            ; Vector, which rounds every instruction up to four.
 5974 2C1A ~            ;
 5975 2C1A ~            ; Called only when the count is not known at translation time -- the optimising
 5976 2C1A ~            ; selector expands a constant shift inline, which for the one and two the
 5977 2C1A ~            ; language's own idioms produce is a single instruction. So the cost that matters
 5978 2C1A ~            ; here is the per-bit cost, not the call overhead.
 5979 2C1A ~            ; ---------------------------------------------------------------------------
 5980 2C1A ~            __x80_shl16:
 5981 2C1A ~                XOR  A
 5982 2C1A ~                OR   E
 5983 2C1A ~                RET  Z
 5984 2C1A ~                CP   8
 5985 2C1A ~                JP   NC,.bytes
 5986 2C1A ~            .loop:
 5987 2C1A ~                ADD  HL,HL
 5988 2C1A ~                DEC  A
 5989 2C1A ~                JP   NZ,.loop
 5990 2C1A ~                RET
 5991 2C1A ~            ; Eight or more: the low byte up a whole byte, then the rest of the count on it alone.
 5992 2C1A ~            .bytes:
 5993 2C1A ~                LD   H,L
 5994 2C1A ~                LD   L,0
 5995 2C1A ~                SUB  8
 5996 2C1A ~                RET  Z
 5997 2C1A ~                CP   8
 5998 2C1A ~                JP   NC,.zero
 5999 2C1A ~                LD   B,A
 6000 2C1A ~                LD   A,H
 6001 2C1A ~            .byte:
 6002 2C1A ~                ADD  A,A
 6003 2C1A ~                DEC  B
 6004 2C1A ~                JP   NZ,.byte
 6005 2C1A ~                LD   H,A
 6006 2C1A ~                RET
 6007 2C1A ~            .zero:
 6008 2C1A ~                LD   H,L
 6009 2C1A ~                RET
 6010 2C1A                  ENDIF
