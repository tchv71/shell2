 3309 2ABA ~                LD   A,L
 3310 2ABA ~                CP   80H
 3311 2ABA ~                JP   C,.pack            ; below half way
 3312 2ABA ~                JP   NZ,.up             ; above
 3313 2ABA ~                LD   A,H                ; half way: to even
 3314 2ABA ~                RRA
 3315 2ABA ~                JP   NC,.pack
 3316 2ABA ~            .up:
 3317 2ABA ~                INC  H
 3318 2ABA ~                JP   NZ,.pack
 3319 2ABA ~                INC  E
 3320 2ABA ~                JP   NZ,.pack
 3321 2ABA ~                INC  D
 3322 2ABA ~                JP   NZ,.pack
 3323 2ABA ~                LD   D,80H              ; 2.0: 1.0 at the next exponent
 3324 2ABA ~                INC  C
 3325 2ABA ~            .pack:
 3326 2ABA ~                LD   A,C
 3327 2ABA ~                OR   A
 3328 2ABA ~                RRA
 3329 2ABA ~                LD   B,A                ; the exponent less one, halved: the top byte's seven bits
 3330 2ABA ~                SBC  A,A
 3331 2ABA ~                AND  80H                ; and the bit it lost, at the top of the significand's byte
