 2819 2ABB ~                ADD  A,2                ; the carry: the exponent's top seven bits all ones
 2820 2ABB ~                RET  NC
 2821 2ABB ~                DEC  HL
 2822 2ABB ~                LD   A,(HL)
 2823 2ABB ~                ADD  A,A                ; the carry: its last bit
 2824 2ABB ~                RET  NC
 2825 2ABB ~                DEC  HL
 2826 2ABB ~                OR   (HL)
 2827 2ABB ~                DEC  HL
 2828 2ABB ~                OR   (HL)
