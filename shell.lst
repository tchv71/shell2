 3519 2ADE              ; ---------------------------------------------------------------------------
 3520 2ADE              ; Sixty-four bits: [HL] = [HL] op [DE], or [HL] shifted by the count in DE.
 3521 2ADE              ;
 3522 2ADE              ; The operands are eight bytes each, which no set of registers on this machine can hold, so these
 3523 2ADE              ; take them by address -- the legaliser writes them into the caller's frame -- and work on copies
 3524 2ADE              ; in static memory, a byte at a time. Simple and slow: the point for now is that long long works.
 3525 2ADE              ; Multiplication is shift-and-add over sixty-four bits, division a restoring loop, sixty-four
 3526 2ADE              ; times.
 3527 2ADE              ; ---------------------------------------------------------------------------
 3528 2ADE                  IFUSED __x80_qmul
 3529 2ADE ~            __x80_qmul:
 3530 2ADE ~                CALL __x80_q_take2
 3531 2ADE ~                LD   HL,__x80_qr
 3532 2ADE ~                CALL __x80_q_zero
 3533 2ADE ~                LD   A,64
 3534 2ADE ~                LD   (__x80_qn),A
 3535 2ADE ~            .loop:
 3536 2ADE ~                LD   HL,__x80_qb+7      ; the multiplier's low bit out
 3537 2ADE ~                CALL __x80_q_shr
 3538 2ADE ~                JP   NC,.skip
 3539 2ADE ~                LD   HL,__x80_qr        ; and the multiplicand added where it was set
 3540 2ADE ~                LD   DE,__x80_qa
 3541 2ADE ~                CALL __x80_q_add
 3542 2ADE ~            .skip:
 3543 2ADE ~                LD   HL,__x80_qa
 3544 2ADE ~                CALL __x80_q_shl
 3545 2ADE ~                LD   A,(__x80_qn)
 3546 2ADE ~                DEC  A
 3547 2ADE ~                LD   (__x80_qn),A
 3548 2ADE ~                JP   NZ,.loop
 3549 2ADE ~                LD   HL,__x80_qr
 3550 2ADE ~                JP   __x80_q_give
 3551 2ADE                  ENDIF
 3552 2ADE
 3553 2ADE                  IFUSED __x80_qudiv
