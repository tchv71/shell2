 3989 2ABB ~                EX   DE,HL
 3990 2ABB ~                LD   (__x80_rt_a+2),HL  ; aH
 3991 2ABB ~                LD   H,B
 3992 2ABB ~                LD   L,C
 3993 2ABB ~                LD   (__x80_rt_b),HL    ; bL
 3994 2ABB ~                LD   HL,2
 3995 2ABB ~                ADD  HL,SP
 3996 2ABB ~                LD   A,(HL)
 3997 2ABB ~                INC  HL
 3998 2ABB ~                LD   H,(HL)
 3999 2ABB ~                LD   L,A
 4000 2ABB ~                LD   (__x80_rt_b+2),HL  ; bH
 4001 2ABB ~                LD   HL,(__x80_rt_a)
 4002 2ABB ~                EX   DE,HL              ; DE = aL, BC = bL
 4003 2ABB ~                LD   A,E                ; the smaller the multiplier: its leading zeros are the cheap steps
 4004 2ABB ~                SUB  C
 4005 2ABB ~                LD   A,D
 4006 2ABB ~                SBC  A,B
 4007 2ABB ~                JP   C,.low
 4008 2ABB ~                LD   H,B
 4009 2ABB ~                LD   L,C
 4010 2ABB ~                LD   B,D
 4011 2ABB ~                LD   C,E
 4012 2ABB ~                EX   DE,HL
 4013 2ABB ~            .low:
 4014 2ABB ~                CALL __x80_mulw         ; DE:HL = aL * bL
 4015 2ABB ~                LD   (__x80_rt_lo),HL
 4016 2ABB ~                LD   HL,(__x80_rt_b)
 4017 2ABB ~                LD   B,H
 4018 2ABB ~                LD   C,L
 4019 2ABB ~                LD   HL,(__x80_rt_a+2)
 4020 2ABB ~                CALL .cross             ; + aH * bL
 4021 2ABB ~                LD   HL,(__x80_rt_a)
 4022 2ABB ~                LD   B,H
 4023 2ABB ~                LD   C,L
 4024 2ABB ~                LD   HL,(__x80_rt_b+2)
 4025 2ABB ~                CALL .cross             ; + aL * bH
 4026 2ABB ~                LD   HL,(__x80_rt_lo)
 4027 2ABB ~                RET
