 4120 2ABA                  IFUSED __x80_shr32
 4121 2ABA ~
 4122 2ABA ~            ; ---------------------------------------------------------------------------
 4123 2ABA ~            ; DE:HL shifted right by C, 1 to 31, with B -- 00h or the sign's FFh -- coming in at the top: both
 4124 2ABA ~            ; right shifts of a long. Eight places at a time by moving the bytes, B the new top one, worked out
 4125 2ABA ~            ; once rather than at each byte. What is left, 1 to 7 places: 1 to 3 a bit a step, the top bit
 4126 2ABA ~            ; from B's; 4 to 7 as 8 - n steps to the left with B as a fifth byte above D, and the bytes moved
 4127 2ABA ~            ; down by one -- 67 T-states a step against 107 to the right (ivagor's way for a word,
 4128 2ABA ~            ; zx-pk.ru #77, and his two ways in for the sign, #92: here one way in, the sign held in B).
 4129 2ABA ~            ; ---------------------------------------------------------------------------
 4130 2ABA ~            __x80_shr32:
 4131 2ABA ~            .bytes:
 4132 2ABA ~                LD   A,C
 4133 2ABA ~                SUB  8
 4134 2ABA ~                JP   C,.bits
 4135 2ABA ~                LD   C,A
 4136 2ABA ~            .move:
 4137 2ABA ~                LD   L,H
 4138 2ABA ~                LD   H,E
 4139 2ABA ~                LD   E,D
 4140 2ABA ~                LD   D,B
 4141 2ABA ~                JP   NZ,.bytes          ; the flags of the SUB, or of .left's last DEC C
 4142 2ABA ~                RET
 4143 2ABA ~            .bits:
 4144 2ABA ~                CP   0FCh               ; A is the count less 8: 4 to 7 places are FCh to FFh
 4145 2ABA ~                JP   NC,.left
 4146 2ABA ~            .right:
 4147 2ABA ~                LD   A,B
 4148 2ABA ~                RLA                     ; B's bit into the carry, to come in at the top
 4149 2ABA ~                LD   A,D
 4150 2ABA ~                RRA
 4151 2ABA ~                LD   D,A
 4152 2ABA ~                CALL __x80_rr3
 4153 2ABA ~                DEC  C
 4154 2ABA ~                JP   NZ,.right
 4155 2ABA ~                RET
 4156 2ABA ~            .left:
 4157 2ABA ~                LD   A,8
 4158 2ABA ~                SUB  C
 4159 2ABA ~                LD   C,A                ; 1 to 4 steps
 4160 2ABA ~            .left_loop:
 4161 2ABA ~                ADD  HL,HL
 4162 2ABA ~                LD   A,E
 4163 2ABA ~                RLA
 4164 2ABA ~                LD   E,A
 4165 2ABA ~                LD   A,D
 4166 2ABA ~                RLA
 4167 2ABA ~                LD   D,A
 4168 2ABA ~                LD   A,B
 4169 2ABA ~                RLA
 4170 2ABA ~                LD   B,A
 4171 2ABA ~                DEC  C
 4172 2ABA ~                JP   NZ,.left_loop
 4173 2ABA ~                JP   .move              ; Z: the bytes down by one, and back
 4174 2ABA                  ENDIF
