 3961 2ABB ~            ; ---------------------------------------------------------------------------
 3962 2ABB ~            ; DE:HL = HL * DE, both unsigned sixteen-bit: what `(uint32_t)a * b` is when neither was wider,
 3963 2ABB ~            ; which the legaliser sees and calls this for rather than __x80_lmul -- one sixteen-by-sixteen
 3964 2ABB ~            ; multiplication, no halves to test. DE is the multiplier, which is faster below 256.
 3965 2ABB ~            ; ---------------------------------------------------------------------------
 3966 2ABB ~            __x80_lmulw:
 3967 2ABB ~                LD   B,H
