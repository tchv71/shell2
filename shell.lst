 5017 2BB0 ~                LD   E,A
 5018 2BB0 ~                LD   A,D
 5019 2BB0 ~                ADC  A,0                ; the fourth
 5020 2BB0 ~                LD   D,A
 5021 2BB0 ~                POP  HL
