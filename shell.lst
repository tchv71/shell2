 6169 2C1C
 6170 2C1C              ; ---------------------------------------------------------------------------
 6171 2C1C              ; memcpy, memset and memmove of a length the program has only when it runs
 6172 2C1C              ; (lib/libc/string.c): HL = destination, DE = source (E the byte for memset),
 6173 2C1C              ; BC = the length; HL comes back as it went in, and A, BC, DE and the flags are
 6174 2C1C              ; written. Two bytes a trip, as __x80_mcpyp_even below (SIA, zx-pk.ru), the
 6175 2C1C              ; trips worked out here: one less than them is (n - 1) / 2 for an odd n and an
 6176 2C1C              ; even one alike, and the bit shifted out says which -- an odd n goes in at the
 6177 2C1C              ; second byte of the first pair. That halved, C its low byte and B its high one
 6178 2C1C              ; and each one more is what DEC C / JP NZ inside DEC B / JP NZ counts down. 0 is
 6179 2C1C              ; nothing at all, 65535 32768 trips. 31.5 T-states a byte for a copy and 19.5
 6180 2C1C              ; for a fill, against 39 and 27 for the loops in C they replace. -Os: a byte a
 6181 2C1C              ; trip, the length as the two counters straight away -- as fast as those loops
 6182 2C1C              ; were, and some ten bytes shorter each.
 6183 2C1C              ; ---------------------------------------------------------------------------
 6184 2C1C              ; memmove: forwards by __x80_mcpyn when the destination is below the source,
 6185 2C1C              ; else from the last byte down. Ahead of __x80_mcpyn, so that its IFUSED has seen
 6186 2C1C              ; the jump to it.
 6187 2C1C              ;
 6188 2C1C              ; -mstack-copy: a long one through SP too, when the two are far enough apart that
 6189 2C1C              ; what an interrupt pushes cannot reach a byte still wanted (SIA, zx-pk.ru). Above
 6190 2C1C              ; the source by X80_SP_RESERVE + 16 or more, from the end down as memcpy goes,
 6191 2C1C              ; __x80_mcpys: an interrupt writes into the destination below SP, not yet written
 6192 2C1C              ; and above every byte of the source still to be read; and the first bytes, which
 6193 2C1C              ; it copies upwards at the end, are below what the source gave for the rest. Below
 6194 2C1C              ; it by X80_SP_RESERVE or more, upwards by __x80_mmoves, below.
 6195 2C1C                  IFUSED __x80_mmoven
 6196 2C1C ~            __x80_mmoven:
 6197 2C1C ~                LD   A,L
 6198 2C1C ~                SUB  E
 6199 2C1C ~                LD   A,H
 6200 2C1C ~                SBC  A,D
 6201 2C1C ~                IFDEF X80_STACK_COPY
 6202 2C1C ~                JP   C,.up
 6203 2C1C ~                JP   NZ,.far            ; the high byte of d - s
 6204 2C1C ~                LD   A,L
 6205 2C1C ~                SUB  E
 6206 2C1C ~                CP   X80_SP_RESERVE + 16
 6207 2C1C ~                JP   C,.near
 6208 2C1C ~            .far:
 6209 2C1C ~                LD   A,B
 6210 2C1C ~                OR   A
 6211 2C1C ~                JP   NZ,__x80_mcpys
 6212 2C1C ~                LD   A,C
 6213 2C1C ~                CP   X80_SP_RESERVE + 32
 6214 2C1C ~                JP   NC,__x80_mcpys
 6215 2C1C ~                JP   .near
 6216 2C1C ~            .up:
 6217 2C1C ~                LD   A,E                ; s - d
 6218 2C1C ~                SUB  L
 6219 2C1C ~                LD   A,D
 6220 2C1C ~                SBC  A,H
 6221 2C1C ~                JP   NZ,.up_far
 6222 2C1C ~                LD   A,E
 6223 2C1C ~                SUB  L
 6224 2C1C ~                CP   X80_SP_RESERVE
 6225 2C1C ~                JP   C,__x80_mcpyn_pairs
 6226 2C1C ~            .up_far:
 6227 2C1C ~                LD   A,B
 6228 2C1C ~                OR   A
 6229 2C1C ~                JP   NZ,__x80_mmoves
 6230 2C1C ~                LD   A,C
 6231 2C1C ~                CP   X80_SP_RESERVE + 32
 6232 2C1C ~                JP   NC,__x80_mmoves
 6233 2C1C ~                JP   __x80_mcpyn_pairs
 6234 2C1C ~            .near:
 6235 2C1C ~                ELSE
 6236 2C1C ~                JP   C,__x80_mcpyn_pairs ; below: forwards; the same place, down as well as any
 6237 2C1C ~                ENDIF
 6238 2C1C ~                LD   A,B
 6239 2C1C ~                OR   C
 6240 2C1C ~                RET  Z
 6241 2C1C ~                PUSH HL
 6242 2C1C ~                ADD  HL,BC
 6243 2C1C ~                DEC  HL
 6244 2C1C ~                EX   DE,HL
 6245 2C1C ~                ADD  HL,BC
 6246 2C1C ~                DEC  HL
 6247 2C1C ~                EX   DE,HL              ; HL and DE at the last bytes
 6248 2C1C ~                DEC  BC
 6249 2C1C ~                IFDEF X80_OPT_SIZE
 6250 2C1C ~                INC  B
 6251 2C1C ~                INC  C
 6252 2C1C ~            .byte:
 6253 2C1C ~                LD   A,(DE)
 6254 2C1C ~                LD   (HL),A
 6255 2C1C ~                DEC  DE
 6256 2C1C ~                DEC  HL
 6257 2C1C ~                DEC  C
 6258 2C1C ~                JP   NZ,.byte
 6259 2C1C ~                DEC  B
 6260 2C1C ~                JP   NZ,.byte
 6261 2C1C ~                POP  HL
 6262 2C1C ~                RET
 6263 2C1C ~                ELSE
 6264 2C1C ~                LD   A,B
 6265 2C1C ~                OR   A                  ; the carry clear: ADD HL,BC may have set it
 6266 2C1C ~                RRA
 6267 2C1C ~                LD   B,A
 6268 2C1C ~                LD   A,C
 6269 2C1C ~                RRA
 6270 2C1C ~                LD   C,A
 6271 2C1C ~                INC  C
 6272 2C1C ~                INC  B
 6273 2C1C ~                JP   NC,.one
 6274 2C1C ~            .two:
 6275 2C1C ~                LD   A,(DE)
 6276 2C1C ~                LD   (HL),A
 6277 2C1C ~                DEC  DE
 6278 2C1C ~                DEC  HL
 6279 2C1C ~            .one:
 6280 2C1C ~                LD   A,(DE)
 6281 2C1C ~                LD   (HL),A
 6282 2C1C ~                DEC  DE
 6283 2C1C ~                DEC  HL
 6284 2C1C ~                DEC  C
 6285 2C1C ~                JP   NZ,.two
 6286 2C1C ~                DEC  B
 6287 2C1C ~                JP   NZ,.two
 6288 2C1C ~                POP  HL
 6289 2C1C ~                RET
 6290 2C1C ~                ENDIF
 6291 2C1C                  ENDIF
 6292 2C1C
 6293 2C1C                  IFDEF X80_STACK_COPY
 6294 2C1C ~                IFUSED __x80_mmoves
 6295 2C1C ~            ; -mstack-copy, memmove upwards: the destination d below the source s by g = s - d, X80_SP_RESERVE
 6296 2C1C ~            ; or more, n at least X80_SP_RESERVE + 32. The first X80_SP_RESERVE to + 15 bytes the ordinary way;
 6297 2C1C ~            ; then SP the source's pointer, up from where they ended, HL the destination's, two bytes a POP --
 6298 2C1C ~            ; 34 T-states a pair, sixteen bytes a trip -- as far as the destination's end, d + n; then the last
 6299 2C1C ~            ; g bytes the ordinary way. Below SP is then always source already read that is destination not
 6300 2C1C ~            ; yet written: what an interrupt pushes lands there and is written over. Past d + n the source is
 6301 2C1C ~            ; the caller's still, and no interrupt may write it (ivagor, zx-pk.ru): there SP does not go. With
 6302 2C1C ~            ; fewer than X80_SP_RESERVE + 32 bytes up to there, all of it the ordinary way; apart, as memcpy.
 6303 2C1C ~            __x80_mmoves:
 6304 2C1C ~                PUSH HL                 ; d, given back
 6305 2C1C ~                ADD  HL,BC
 6306 2C1C ~                LD   A,L
 6307 2C1C ~                SUB  E
 6308 2C1C ~                LD   L,A
 6309 2C1C ~                LD   A,H
 6310 2C1C ~                SBC  A,D
 6311 2C1C ~                LD   H,A                ; d + n - s = n - g, the bytes up to the destination's end
 6312 2C1C ~                JP   C,.apart           ; apart: memcpy's way
 6313 2C1C ~                JP   NZ,.long
 6314 2C1C ~                LD   A,L
 6315 2C1C ~                CP   X80_SP_RESERVE + 32
 6316 2C1C ~                JP   C,.plain
 6317 2C1C ~            .long:
 6318 2C1C ~                LD   B,H
 6319 2C1C ~                LD   C,L                ; n - g
 6320 2C1C ~                POP  HL
 6321 2C1C ~                PUSH HL                 ; d
 6322 2C1C ~                LD   A,E
 6323 2C1C ~                SUB  L
 6324 2C1C ~                LD   L,A
 6325 2C1C ~                LD   A,D
 6326 2C1C ~                SBC  A,H
 6327 2C1C ~                LD   H,A                ; g
 6328 2C1C ~                EX   (SP),HL            ; g kept, HL = d
 6329 2C1C ~                PUSH HL                 ; d on it
 6330 2C1C ~                CALL __x80_sp_trips     ; BC the trips, A the first bytes
 6331 2C1C ~                PUSH BC
 6332 2C1C ~                LD   C,A
 6333 2C1C ~                LD   B,0
 6334 2C1C ~                PUSH BC
 6335 2C1C ~                CALL __x80_mcpyn_pairs  ; the first bytes: HL = d again, DE = s past them
 6336 2C1C ~                POP  BC
 6337 2C1C ~                ADD  HL,BC              ; the destination past them
 6338 2C1C ~                POP  BC
 6339 2C1C ~                EX   DE,HL              ; HL the source, DE the destination
 6340 2C1C ~                PUSH HL
 6341 2C1C ~                LD   HL,2
 6342 2C1C ~                ADD  HL,SP
 6343 2C1C ~                LD   (__x80_sp_save),HL ; SP with d and g on it
 6344 2C1C ~                POP  HL
 6345 2C1C ~                LD   SP,HL
 6346 2C1C ~                EX   DE,HL
 6347 2C1C ~            .up:
 6348 2C1C ~                POP  DE
 6349 2C1C ~                LD   (HL),E
 6350 2C1C ~                INC  HL
 6351 2C1C ~                LD   (HL),D
 6352 2C1C ~                INC  HL
 6353 2C1C ~                POP  DE
 6354 2C1C ~                LD   (HL),E
 6355 2C1C ~                INC  HL
 6356 2C1C ~                LD   (HL),D
 6357 2C1C ~                INC  HL
 6358 2C1C ~                POP  DE
 6359 2C1C ~                LD   (HL),E
 6360 2C1C ~                INC  HL
 6361 2C1C ~                LD   (HL),D
 6362 2C1C ~                INC  HL
 6363 2C1C ~                POP  DE
 6364 2C1C ~                LD   (HL),E
 6365 2C1C ~                INC  HL
 6366 2C1C ~                LD   (HL),D
 6367 2C1C ~                INC  HL
 6368 2C1C ~                POP  DE
 6369 2C1C ~                LD   (HL),E
 6370 2C1C ~                INC  HL
 6371 2C1C ~                LD   (HL),D
 6372 2C1C ~                INC  HL
 6373 2C1C ~                POP  DE
 6374 2C1C ~                LD   (HL),E
 6375 2C1C ~                INC  HL
 6376 2C1C ~                LD   (HL),D
 6377 2C1C ~                INC  HL
 6378 2C1C ~                POP  DE
 6379 2C1C ~                LD   (HL),E
 6380 2C1C ~                INC  HL
 6381 2C1C ~                LD   (HL),D
 6382 2C1C ~                INC  HL
 6383 2C1C ~                POP  DE
 6384 2C1C ~                LD   (HL),E
 6385 2C1C ~                INC  HL
 6386 2C1C ~                LD   (HL),D
 6387 2C1C ~                INC  HL
 6388 2C1C ~                DEC  C
 6389 2C1C ~                JP   NZ,.up
 6390 2C1C ~                DEC  B
 6391 2C1C ~                JP   NZ,.up
 6392 2C1C ~                EX   DE,HL              ; DE the destination, at d + n - g
 6393 2C1C ~                LD   HL,(__x80_sp_save)
 6394 2C1C ~                LD   SP,HL
 6395 2C1C ~                POP  HL                 ; d
 6396 2C1C ~                POP  BC                 ; g
 6397 2C1C ~                PUSH HL
 6398 2C1C ~                LD   H,B
 6399 2C1C ~                LD   L,C
 6400 2C1C ~                ADD  HL,DE              ; the source, at d + n
 6401 2C1C ~                EX   DE,HL
 6402 2C1C ~                CALL __x80_mcpyn_pairs  ; the last g bytes
 6403 2C1C ~                POP  HL                 ; d
 6404 2C1C ~                RET
 6405 2C1C ~            .plain:
 6406 2C1C ~                POP  HL                 ; d
 6407 2C1C ~                JP   __x80_mcpyn_pairs
 6408 2C1C ~            .apart:
 6409 2C1C ~                ; The areas apart: no byte of the source is written, and memcpy's copy through SP, which
 6410 2C1C ~                ; writes by it and reads the ordinary way, does as well here (SIA, zx-pk.ru).
 6411 2C1C ~                POP  HL                 ; d
 6412 2C1C ~                JP   __x80_mcpys
 6413 2C1C ~                ENDIF
 6414 2C1C                  ENDIF
