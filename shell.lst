 4982 2BAE ~            ; ---------------------------------------------------------------------------
 4983 2BAE ~            ; DE:HL = DE * BC, unsigned, the whole thirty-two-bit product. BC is left alone.
 4984 2BAE ~            ;
 4985 2BAE ~            ; Two products of a byte and a word, __x80_mul8w_d's with D zero for them: E * BC, and D * BC a
 4986 2BAE ~            ; byte further up, added together -- some 700 T-states for two full words, against about 1300 for the loop this replaced,
 4987 2BAE ~            ; which shifted the multiplier and the product's high half through DE a bit at a time. A multiplier
 4988 2BAE ~            ; below 256, which is what float's multiplication passes three times out of four, is the one
 4989 2BAE ~            ; product, some 300 T-states.
 4990 2BAE ~            ; ---------------------------------------------------------------------------
 4991 2BAE ~            __x80_mulw:
 4992 2BAE ~                XOR  A
 4993 2BAE ~                OR   D
 4994 2BAE ~                JP   NZ,.full
 4995 2BAE ~                LD   A,E
 4996 2BAE ~                CALL __x80_mul8w_d      ; A:HL = E * BC, with the zero D
 4997 2BAE ~                LD   E,A                ; D is zero still
 4998 2BAE ~                RET
 4999 2BAE ~            .full:
 5000 2BAE ~                LD   A,E
 5001 2BAE ~                LD   E,D                ; the high byte waits in E,
 5002 2BAE ~                LD   D,0                ; and D is the zero __x80_mul8w_d wants
 5003 2BAE ~                CALL __x80_mul8w_d      ; A:HL = low byte * BC; DE is left alone
 5004 2BAE ~                PUSH HL                 ; the low product's low word
 5005 2BAE ~                LD   L,A
 5006 2BAE ~                LD   A,E
 5007 2BAE ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 2BAE ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 2BAE ~                LD   D,A
 5010 2BAE ~                LD   A,L
 5011 2BAE ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 2BAE ~                ADD  A,H
 5013 2BAE ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 2BAE ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 2BAE ~                LD   A,E
 5016 2BAE ~                ADC  A,H                ; the third: EX and LD leave the carry
 5017 2BAE ~                LD   E,A
 5018 2BAE ~                LD   A,D
 5019 2BAE ~                ADC  A,0                ; the fourth
 5020 2BAE ~                LD   D,A
 5021 2BAE ~                POP  HL
 5022 2BAE ~                RET
 5023 2BAE                  ENDIF
