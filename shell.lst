 5319 2BB4                  IFUSED __x80_udiv16
 5320 2BB4
 5321 2BB4              ; ---------------------------------------------------------------------------
 5322 2BB4              ; HL = HL / DE, DE = HL % DE, both unsigned.
 5323 2BB4              ;
 5324 2BB4              ; A byte of the quotient at a time, by __x80_dpass8 or __x80_dpass16. A divisor below 256 -- nearly
 5325 2BB4              ; every divisor a program has -- takes one pass when the dividend's high byte is below it, two
 5326 2BB4              ; when it is not; one of 256..32767 leaves a quotient below 256, one pass and the low byte added;
 5327 2BB4              ; one of 32768 or more, a quotient of 0 or 1.
 5328 2BB4              ;
 5329 2BB4              ; A division by zero is undefined in C, and the compiler does not fold it precisely so
 5330 2BB4              ; that the program faults rather than being given a made-up answer. There is nothing to
 5331 2BB4              ; fault with here, so it produces all ones, which is at least conspicuous.
 5332 2BB4              ; ---------------------------------------------------------------------------
 5333 2BB4              __x80_udiv16:
 5334 2BB4                  IFDEF X80_OPT_SIZE
 5335 2BB4                  ; -Os: sixteen steps, restoring -- some 55 bytes where the passes are 300, and some 2 400
 5336 2BB4                  ; T-states a division. The remainder in HL, the dividend in DE shifted out as the quotient's
 5337 2BB4                  ; bits go in, the divisor in BC, the count on the stack.
 5338 2BB4 7A               LD   A,D
 5339 2BB5 B3               OR   E
 5340 2BB6 CA E3 2B         JP   Z,.s_zero
 5341 2BB9 42               LD   B,D
 5342 2BBA 4B               LD   C,E
 5343 2BBB EB               EX   DE,HL
 5344 2BBC 21 00 00         LD   HL,0
 5345 2BBF 3E 10            LD   A,16
 5346 2BC1              .s_loop:
 5347 2BC1 F5               PUSH AF
 5348 2BC2 EB               EX   DE,HL
 5349 2BC3 29               ADD  HL,HL              ; the dividend's top bit out, a 0 in for the quotient's bit
 5350 2BC4 EB               EX   DE,HL
 5351 2BC5 7D               LD   A,L                ; and into the remainder, the carry its seventeenth bit
 5352 2BC6 17               RLA
 5353 2BC7 6F               LD   L,A
 5354 2BC8 7C               LD   A,H
 5355 2BC9 17               RLA
 5356 2BCA 67               LD   H,A
 5357 2BCB DA D5 2B         JP   C,.s_take
 5358 2BCE 7D               LD   A,L
 5359 2BCF 91               SUB  C
 5360 2BD0 7C               LD   A,H
 5361 2BD1 98               SBC  A,B
 5362 2BD2 DA DC 2B         JP   C,.s_next          ; below the divisor: a 0
 5363 2BD5              .s_take:
 5364 2BD5 7D               LD   A,L
 5365 2BD6 91               SUB  C
 5366 2BD7 6F               LD   L,A
 5367 2BD8 7C               LD   A,H
 5368 2BD9 98               SBC  A,B
 5369 2BDA 67               LD   H,A
 5370 2BDB 1C               INC  E
 5371 2BDC              .s_next:
 5372 2BDC F1               POP  AF
 5373 2BDD 3D               DEC  A
 5374 2BDE C2 C1 2B         JP   NZ,.s_loop
 5375 2BE1 EB               EX   DE,HL
 5376 2BE2 C9               RET
 5377 2BE3              .s_zero:
 5378 2BE3 21 FF FF         LD   HL,0FFFFH
 5379 2BE6 11 00 00         LD   DE,0
 5380 2BE9 C9               RET
 5381 2BEA                  ELSE
