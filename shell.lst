 3553 2ABB                  IFUSED __x80_qudiv
 3554 2ABB ~            __x80_qudiv:
 3555 2ABB ~                CALL __x80_q_take2
 3556 2ABB ~                CALL __x80_q_divide
 3557 2ABB ~                LD   HL,__x80_qa
 3558 2ABB ~                JP   __x80_q_give
 3559 2ABB                  ENDIF
 3560 2ABB
 3561 2ABB                  IFUSED __x80_qurem
 3562 2ABB ~            __x80_qurem:
