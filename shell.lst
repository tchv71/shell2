 5481 2BEB                  ENDIF
 5482 2BEB
 5483 2BEB                  IFUSED __x80_dpass16
 5484 2BEB ~
 5485 2BEB ~            ; ---------------------------------------------------------------------------
 5486 2BEB ~            ; A byte of a quotient: blackmirror's division (zx-pk.ru, "Vychislenie chisla Pi na
 5487 2BEB ~            ; assemblere", 2016), as ivagor made it the 8080's.
 5488 2BEB ~            ;
 5489 2BEB ~            ; Non-restoring, and unrolled: the remainder doubled each step and the divisor added to it or
 5490 2BEB ~            ; taken from it -- added while the remainder is below zero, taken while it is not -- so that it
 5491 2BEB ~            ; stays within one divisor of zero, and the step's carry is the quotient's bit. The two cases are
 5492 2BEB ~            ; two chains of code, and a step goes from one to the other on its carry: no test of a sign, no
 5493 2BEB ~            ; restoring of a remainder that went below zero. Each step is ADC A,A / ADD HL,HL / ADD HL,rp / JP
 5494 2BEB ~            ; -- 34 T-states a bit, where a restoring step with the remainder in memory or on the stack was
 5495 2BEB ~            ; three or four times that. The carry, not the sign, tells which way the remainder went, which is
 5496 2BEB ~            ; what lets the divisor be anything below 32768: the doubled remainder may need seventeen bits,
 5497 2BEB ~            ; but the carry is the seventeenth.
 5498 2BEB ~            ;
 5499 2BEB ~            ; __x80_dpass16: a divisor B of 256..32767 in BC, -B in DE, and in HL a remainder R below B as
 5500 2BEB ~            ; the passes keep it, R - B. Returns the byte of R * 256 / B in A, and in HL (R * 256 % B) - B,
 5501 2BEB ~            ; to which the caller adds the next byte of the dividend: when that carries, the remainder has
 5502 2BEB ~            ; reached B again -- one more in the quotient, and B taken off once more.
 5503 2BEB ~            ; ---------------------------------------------------------------------------
 5504 2BEB ~            __x80_dpass16:
 5505 2BEB ~                ADD  HL,HL          ; bit 7, the remainder below zero
 5506 2BEB ~                ADD  HL,BC
 5507 2BEB ~                JP   C,.s6
 5508 2BEB ~            .a6:
 5509 2BEB ~                ADC  A,A
 5510 2BEB ~                ADD  HL,HL
 5511 2BEB ~                ADD  HL,BC
 5512 2BEB ~                JP   C,.s5
 5513 2BEB ~            .a5:
 5514 2BEB ~                ADC  A,A
 5515 2BEB ~                ADD  HL,HL
 5516 2BEB ~                ADD  HL,BC
 5517 2BEB ~                JP   C,.s4
 5518 2BEB ~            .a4:
 5519 2BEB ~                ADC  A,A
 5520 2BEB ~                ADD  HL,HL
 5521 2BEB ~                ADD  HL,BC
 5522 2BEB ~                JP   C,.s3
 5523 2BEB ~            .a3:
 5524 2BEB ~                ADC  A,A
 5525 2BEB ~                ADD  HL,HL
 5526 2BEB ~                ADD  HL,BC
 5527 2BEB ~                JP   C,.s2
 5528 2BEB ~            .a2:
 5529 2BEB ~                ADC  A,A
 5530 2BEB ~                ADD  HL,HL
 5531 2BEB ~                ADD  HL,BC
 5532 2BEB ~                JP   C,.s1
 5533 2BEB ~            .a1:
 5534 2BEB ~                ADC  A,A
 5535 2BEB ~                ADD  HL,HL
 5536 2BEB ~                ADD  HL,BC
 5537 2BEB ~                JP   C,.s0
 5538 2BEB ~            .a0:
 5539 2BEB ~                ADC  A,A
 5540 2BEB ~                ADD  HL,HL
 5541 2BEB ~                ADD  HL,BC
 5542 2BEB ~                JP   C,.se
 5543 2BEB ~            .ae:
 5544 2BEB ~                ADC  A,A            ; the last bit; the remainder already below zero
 5545 2BEB ~                RET
 5546 2BEB ~            .s6:
 5547 2BEB ~                ADC  A,A
 5548 2BEB ~                ADD  HL,HL
 5549 2BEB ~                ADD  HL,DE
 5550 2BEB ~                JP   NC,.a5
 5551 2BEB ~            .s5:
 5552 2BEB ~                ADC  A,A
 5553 2BEB ~                ADD  HL,HL
 5554 2BEB ~                ADD  HL,DE
 5555 2BEB ~                JP   NC,.a4
 5556 2BEB ~            .s4:
 5557 2BEB ~                ADC  A,A
 5558 2BEB ~                ADD  HL,HL
 5559 2BEB ~                ADD  HL,DE
 5560 2BEB ~                JP   NC,.a3
 5561 2BEB ~            .s3:
 5562 2BEB ~                ADC  A,A
 5563 2BEB ~                ADD  HL,HL
 5564 2BEB ~                ADD  HL,DE
 5565 2BEB ~                JP   NC,.a2
 5566 2BEB ~            .s2:
 5567 2BEB ~                ADC  A,A
 5568 2BEB ~                ADD  HL,HL
 5569 2BEB ~                ADD  HL,DE
 5570 2BEB ~                JP   NC,.a1
 5571 2BEB ~            .s1:
 5572 2BEB ~                ADC  A,A
 5573 2BEB ~                ADD  HL,HL
 5574 2BEB ~                ADD  HL,DE
 5575 2BEB ~                JP   NC,.a0
 5576 2BEB ~            .s0:
 5577 2BEB ~                ADC  A,A
 5578 2BEB ~                ADD  HL,HL
 5579 2BEB ~                ADD  HL,DE
 5580 2BEB ~                JP   NC,.ae
 5581 2BEB ~            .se:
 5582 2BEB ~                ADC  A,A            ; the last bit; the remainder made R - B, as the passes keep it
 5583 2BEB ~                ADD  HL,DE
 5584 2BEB ~                RET
 5585 2BEB                  ENDIF
