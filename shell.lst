 1614 2ABB ~                EX   DE,HL
 1615 2ABB ~                LD   (__x80_fpb),HL
 1616 2ABB ~                LD   HL,(__x80_fpa+2)
 1617 2ABB ~                EX   DE,HL
 1618 2ABB ~                LD   HL,(__x80_fpb+2)
 1619 2ABB ~                LD   (__x80_fpa+2),HL
 1620 2ABB ~                EX   DE,HL
 1621 2ABB ~                LD   (__x80_fpb+2),HL
 1622 2ABB ~                LD   A,C
 1623 2ABB ~                LD   C,B
 1624 2ABB ~                LD   B,A
 1625 2ABB ~            .in_order:
 1626 2ABB ~                LD   A,(__x80_fpa+3)
