 8561 2C46              ; The Вектор-06Ц's frame hook, vc_on_frame, which its board support package's interrupt handler
 8562 2C46              ; calls (lib/bsp/vector06c.c): nothing, unless the program defines its own. The compiler marks
 8563 2C46              ; every definition it writes with DEFINE __X80_DEF_name -- the way the C library gives way to the
 8564 2C46              ; program -- and this file is assembled after the program, so the mark has been seen. Here and not
 8565 2C46              ; in the Вектор's startup code because that is assembled first, before the mark.
 8566 2C46              ;@shared
 8567 2C46                  IFUSED _vc_on_frame
 8568 2C46 ~                IFNDEF __X80_DEF_vc_on_frame
 8569 2C46 ~            _vc_on_frame:
 8570 2C46 ~                RET
 8571 2C46 ~                ENDIF
 8572 2C46                  ENDIF
 8573 2C46              ;@end
