 2029 2ABB ~                CALL __x80_mul8w        ; a2 * b1b0: bytes 4 to 2
 2030 2ABB ~                ADD  HL,DE
 2031 2ABB ~                ADC  A,0
 2032 2ABB ~                EX   DE,HL              ; bytes 3 and 2
 2033 2ABB ~                LD   (__x80_fpp+4),A    ; byte 4 so far
 2034 2ABB ~            .by_a:
 2035 2ABB ~                LD   HL,(__x80_fpa)
 2036 2ABB ~                LD   A,H
 2037 2ABB ~                OR   L
 2038 2ABB ~                LD   B,H
