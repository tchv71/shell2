 4457 2BD2 ~                ; A divisor below 32768 -- ten for a number being printed, a modulus, a count -- is a byte of
 4458 2BD2 ~                ; the quotient at a time (__x80_dpass8, __x80_dpass16), the dividend's bytes from the top: some
 4459 2BD2 ~                ; 1 300 T-states for a byte divisor, 1 100 for a word, where shifting the four bytes through
 4460 2BD2 ~                ; memory a bit at a time was several thousand.
 4461 2BD2 ~                LD   HL,(__x80_rt_b+2)
 4462 2BD2 ~                LD   A,H
 4463 2BD2 ~                OR   L
 4464 2BD2 ~                JP   NZ,.general
