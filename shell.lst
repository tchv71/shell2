 8575 2C46              ; A call through a pointer in an interrupt's code: a pointer is always the
 8576 2C46              ; program's function, and the copy of __x80_call_hl, __x80_call_bc or __x80_call_mem turns it into the
 8577 2C46              ; function's copy for interrupts before it calls. Each module that has functions whose address is
 8578 2C46              ; taken, and copies of them, writes a segment of pairs -- DEFW the function, its copy -- ended by
 8579 2C46              ; a zero word and preceded by the segment before it, __x80_xlat_head as it was; the last one is
 8580 2C46              ; __x80_xlat_last. Kept only when something calls through a pointer in an interrupt, and so
 8581 2C46              ; names __x80_xlat. HL the address, and the copy's back in it, or the address as it was -- a
 8582 2C46              ; function written in assembly, which has none; every other register kept.
 8583 2C46              ;@shared
 8584 2C46                  IFUSED __x80_xlat
 8585 2C46 ~            __x80_xlat:
 8586 2C46 ~                PUSH AF
 8587 2C46 ~                PUSH BC
 8588 2C46 ~                PUSH DE
 8589 2C46 ~                EX   DE,HL              ; DE the address
 8590 2C46 ~                LD   HL,__x80_xlat_last
 8591 2C46 ~            .segment:
 8592 2C46 ~                LD   A,H
 8593 2C46 ~                OR   L
 8594 2C46 ~                JP   Z,.done
 8595 2C46 ~                LD   C,(HL)
 8596 2C46 ~                INC  HL
 8597 2C46 ~                LD   B,(HL)             ; BC the segment before
 8598 2C46 ~                INC  HL
 8599 2C46 ~            .entry:
 8600 2C46 ~                LD   A,(HL)
 8601 2C46 ~                INC  HL
 8602 2C46 ~                OR   (HL)
 8603 2C46 ~                JP   Z,.end             ; the zero word
 8604 2C46 ~                DEC  HL
 8605 2C46 ~                LD   A,(HL)
 8606 2C46 ~                CP   E
 8607 2C46 ~                INC  HL
 8608 2C46 ~                JP   NZ,.skip
 8609 2C46 ~                LD   A,(HL)
 8610 2C46 ~                CP   D
 8611 2C46 ~                JP   Z,.found
 8612 2C46 ~            .skip:
 8613 2C46 ~                INC  HL
 8614 2C46 ~                INC  HL
 8615 2C46 ~                INC  HL
 8616 2C46 ~                JP   .entry
 8617 2C46 ~            .found:
 8618 2C46 ~                INC  HL
 8619 2C46 ~                LD   E,(HL)
 8620 2C46 ~                INC  HL
 8621 2C46 ~                LD   D,(HL)             ; DE the copy
 8622 2C46 ~                JP   .done
 8623 2C46 ~            .end:
 8624 2C46 ~                LD   H,B
 8625 2C46 ~                LD   L,C
 8626 2C46 ~                JP   .segment
 8627 2C46 ~            .done:
 8628 2C46 ~                EX   DE,HL
 8629 2C46 ~                POP  DE
 8630 2C46 ~                POP  BC
 8631 2C46 ~                POP  AF
 8632 2C46 ~                RET
 8633 2C46                  ENDIF
 8634 2C46              ;@end
 8635 2C46
 8636 2C46              ; The library's critical sections (lib/libc/critical.h), in a program whose interrupt handlers call
 8637 2C46              ; the library: __x80_busy counts the sections the program is in, and an interrupt's entry that
 8638 2C46              ; finds it set leaves its address in __x80_pending and returns at once. The end of the outermost
 8639 2C46              ; section calls __x80_run_deferred, which runs that entry as the interrupt would have: interrupts
 8640 2C46              ; off, and on again after -- they were on, or it would not have come, and the program has been in
 8641 2C46              ; the library since. Every register kept.
 8642 2C46              ;@shared
 8643 2C46                  IFUSED __x80_busy
 8644 2C46 ~            __x80_bss_off = __x80_bss_off + 1
 8645 2C46 ~            __x80_busy EQU __x80_bss_top - __x80_bss_off
 8646 2C46                  ENDIF
 8647 2C46                  IFUSED __x80_pending
 8648 2C46 ~            __x80_bss_off = __x80_bss_off + 2
 8649 2C46 ~            __x80_pending EQU __x80_bss_top - __x80_bss_off
 8650 2C46                  ENDIF
 8651 2C46                  IFUSED __x80_run_deferred
 8652 2C46 ~            __x80_run_deferred:
 8653 2C46 ~                PUSH AF
 8654 2C46 ~                PUSH HL
 8655 2C46 ~                LD   HL,(__x80_pending)
 8656 2C46 ~                LD   A,H
 8657 2C46 ~                OR   L
 8658 2C46 ~                JP   Z,.done
 8659 2C46 ~                PUSH BC
 8660 2C46 ~                PUSH DE
 8661 2C46 ~                PUSH HL
 8662 2C46 ~                LD   HL,0
 8663 2C46 ~                LD   (__x80_pending),HL
 8664 2C46 ~                POP  HL
 8665 2C46 ~                DI
 8666 2C46 ~                CALL .go
 8667 2C46 ~                EI
 8668 2C46 ~                POP  DE
 8669 2C46 ~                POP  BC
 8670 2C46 ~            .done:
 8671 2C46 ~                POP  HL
 8672 2C46 ~                POP  AF
 8673 2C46 ~                RET
 8674 2C46 ~            .go:
 8675 2C46 ~                JP   (HL)
 8676 2C46                  ENDIF
 8677 2C46              ;@end
 8678 2C46
 8679 2C46              ; The end of everything assembled, and so of the image: the C library's heap starts here. And
 8680 2C46              ; how much the objects the program starts with zeroed take: they are not in the image but at the
 8681 2C46              ; top of memory, each file handing out addresses down from __x80_bss_top as it defines them
 8682 2C46              ; and the startup code clears them and puts the stack below them. Last in the
 8683 2C46              ; file, and this file last on the assembler's command line.
 8684 2C46              ;@shared
 8685 2C46                  IFUSED __x80_xlat
 8686 2C46 ~            __x80_xlat_last EQU __x80_xlat_head
 8687 2C46                  ENDIF
 8688 2C46              __x80_bss_size EQU __x80_bss_off
 8689 2C46                  ; --target=bin --no-startup (lib/crt/bin_start.asm): no startup to clear them, so they are
 8690 2C46                  ; zeros in the image, here at its end, and __x80_bss_top is the end of these.
 8691 2C46                  IFDEF X80_BSS_IN_IMAGE
 8692 2C46              __x80_bss_image:
 8693 2C46                  IF __x80_bss_size
 8694 2C46 00 00 00...      DEFS __x80_bss_size
 8695 2FB0                  ENDIF
 8696 2FB0                  ENDIF
 8697 2FB0                  IFUSED __x80_heap
 8698 2FB0 ~            __x80_heap:
 8699 2FB0                  ENDIF
 8700 2FB0              ;@end
 8701 2FB0
# file closed: runtime.asm
# file opened: runtime32.asm
    1 2FB0              ; runtime32.asm -- empty. The thirty-two-bit routines are in runtime.asm, with the sixteen-bit
    2 2FB0              ; ones they call, so that the assembler can leave out whatever a program does not use; see the
    3 2FB0              ; comment at the top of that file. Kept so that command lines naming it still work.
    4 2FB0
# file closed: runtime32.asm
