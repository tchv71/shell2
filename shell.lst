 1927 2ABC ~                ADC  A,A
 1928 2ABC ~                LD   C,A                ; a's exponent field
 1929 2ABC ~                INC  A
 1930 2ABC ~                CP   2
 1931 2ABC ~                JP   C,.slow            ; 0 or 255
 1932 2ABC ~                LD   A,L
 1933 2ABC ~                ADD  A,A
 1934 2ABC ~                LD   A,H
 1935 2ABC ~                ADC  A,A
 1936 2ABC ~                LD   B,A                ; b's
 1937 2ABC ~                INC  A
 1938 2ABC ~                CP   2
 1939 2ABC ~                JP   C,.slow
 1940 2ABC ~                LD   A,D
 1941 2ABC ~                XOR  H
 1942 2ABC ~                AND  80H
 1943 2ABC ~                LD   (__x80_fps),A      ; the signs'
 1944 2ABC ~                LD   A,E
 1945 2ABC ~                OR   80H
 1946 2ABC ~                LD   (__x80_fpa+2),A
 1947 2ABC ~                LD   A,L
 1948 2ABC ~                OR   80H
