 5590 2BEA ~            ; __x80_dpass8: the same for a divisor d of 1..255, held as B = d * 128 in BC, -B in DE
 5591 2BEA ~            ; (__x80_dsetup8). HL is a remainder below d times 256 plus the next byte of the dividend; returns
 5592 2BEA ~            ; the byte of HL / d in A, and the remainder in H, with L zero -- where the next byte goes. The
