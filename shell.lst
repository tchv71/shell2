 3273 2ABA                  IFUSED __x80_fp_rpack
 3274 2ABA ~            ; ---------------------------------------------------------------------------
 3275 2ABA ~            ; DE:HL = the float of fps, BC and DEHL (not zero): normalised, rounded to nearest, ties to
 3276 2ABA ~            ; even, packed -- infinite if too large, subnormal or zero if too small.
 3277 2ABA ~            ;
 3278 2ABA ~            ; The packing adds the significand, its leading one included, to the exponent less one shifted
 3279 2ABA ~            ; into place: a rounding that carries out of the significand, and a subnormal that rounds up to
 3280 2ABA ~            ; the smallest normal, put themselves into the exponent that way.
 3281 2ABA ~            ; ---------------------------------------------------------------------------
 3282 2ABA ~            __x80_fp_rpack:
