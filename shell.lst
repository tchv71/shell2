 3273 2ADE                  IFUSED __x80_fp_rpack
 3274 2ADE ~            ; ---------------------------------------------------------------------------
 3275 2ADE ~            ; DE:HL = the float of fps, BC and DEHL (not zero): normalised, rounded to nearest, ties to
 3276 2ADE ~            ; even, packed -- infinite if too large, subnormal or zero if too small.
 3277 2ADE ~            ;
 3278 2ADE ~            ; The packing adds the significand, its leading one included, to the exponent less one shifted
 3279 2ADE ~            ; into place: a rounding that carries out of the significand, and a subnormal that rounds up to
 3280 2ADE ~            ; the smallest normal, put themselves into the exponent that way.
 3281 2ADE ~            ; ---------------------------------------------------------------------------
 3282 2ADE ~            __x80_fp_rpack:
 3283 2ADE ~                CALL __x80_fp_norm
 3284 2ADE ~                XOR  A
 3285 2ADE ~                OR   B
 3286 2ADE ~                JP   M,.tiny
 3287 2ADE ~                JP   NZ,__x80_fp_inf
 3288 2ADE ~                LD   A,C
 3289 2ADE ~                CP   0FFH
 3290 2ADE ~                JP   Z,__x80_fp_inf
 3291 2ADE ~                OR   A
 3292 2ADE ~                JP   Z,.tiny
 3293 2ADE ~                DEC  C
 3294 2ADE ~                JP   .round
 3295 2ADE ~            .tiny:
 3296 2ADE ~                ; below the normal range: 1 - BC places down, the exponent field 0
 3297 2ADE ~                LD   A,1
 3298 2ADE ~                SUB  C
 3299 2ADE ~                LD   C,A
 3300 2ADE ~                LD   A,0
 3301 2ADE ~                SBC  A,B
 3302 2ADE ~                JP   NZ,__x80_fp_zero
 3303 2ADE ~                LD   A,C
 3304 2ADE ~                CP   32
 3305 2ADE ~                JP   NC,__x80_fp_zero
 3306 2ADE ~                CALL __x80_fp_shr
 3307 2ADE ~                LD   C,0
 3308 2ADE ~            .round:
 3309 2ADE ~                LD   A,L
 3310 2ADE ~                CP   80H
 3311 2ADE ~                JP   C,.pack            ; below half way
 3312 2ADE ~                JP   NZ,.up             ; above
 3313 2ADE ~                LD   A,H                ; half way: to even
 3314 2ADE ~                RRA
 3315 2ADE ~                JP   NC,.pack
 3316 2ADE ~            .up:
 3317 2ADE ~                INC  H
 3318 2ADE ~                JP   NZ,.pack
 3319 2ADE ~                INC  E
 3320 2ADE ~                JP   NZ,.pack
 3321 2ADE ~                INC  D
 3322 2ADE ~                JP   NZ,.pack
 3323 2ADE ~                LD   D,80H              ; 2.0: 1.0 at the next exponent
 3324 2ADE ~                INC  C
 3325 2ADE ~            .pack:
 3326 2ADE ~                LD   A,C
 3327 2ADE ~                OR   A
 3328 2ADE ~                RRA
 3329 2ADE ~                LD   B,A                ; the exponent less one, halved: the top byte's seven bits
 3330 2ADE ~                SBC  A,A
 3331 2ADE ~                AND  80H                ; and the bit it lost, at the top of the significand's byte
 3332 2ADE ~                ADD  A,D
 3333 2ADE ~                LD   D,A
 3334 2ADE ~                LD   A,(__x80_fps)
 3335 2ADE ~                ADC  A,B                ; the sign, the seven bits and what the significand carried
 3336 2ADE ~                LD   L,H
 3337 2ADE ~                LD   H,E
 3338 2ADE ~                LD   E,D
 3339 2ADE ~                LD   D,A
 3340 2ADE ~                RET
 3341 2ADE ~            __x80_fp_inf:
 3342 2ADE ~                LD   A,(__x80_fps)
 3343 2ADE ~                OR   7FH
 3344 2ADE ~                LD   D,A
 3345 2ADE ~                LD   E,80H
 3346 2ADE ~                LD   HL,0
 3347 2ADE ~                RET
 3348 2ADE ~            __x80_fp_zero:
 3349 2ADE ~                LD   A,(__x80_fps)
 3350 2ADE ~                LD   D,A
 3351 2ADE ~                LD   E,0
 3352 2ADE ~                LD   HL,0
 3353 2ADE ~                RET
