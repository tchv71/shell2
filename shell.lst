 2148 2ABB
 2149 2ABB                  IFUSED __x80_fdiv
 2150 2ABB ~            ; ---------------------------------------------------------------------------
 2151 2ABB ~            ; DE:HL = a / b. Restoring division of the significands, a bit at a time: with a's at least b's
 2152 2ABB ~            ; -- doubled, and the exponent one less, if not -- the quotient is in [1, 2), its leading one at
 2153 2ABB ~            ; bit 31 of the thirty-two bits rpack takes. The remainder is in E H L with its twenty-fifth bit,
 2154 2ABB ~            ; after the shift, in the carry; the divisor's top byte in D and its low word negated in BC, so
 2155 2ABB ~            ; that taking it off is ADD HL,BC and SBC A,D on the carry turned round. A low word of zero would
 2156 2ABB ~            ; leave no carry, so then D is one less and the low word taken as 65536. The top bytes alike, the
 2157 2ABB ~            ; same ADD on a copy of HL tells the rest. The quotient's bits go in at the bottom of fpx,
 2158 2ABB ~            ; inverted, behind a 1 that comes out at the top when there are eight; each full byte is pushed.
 2159 2ABB ~            ; Three bytes, the twenty-four bits of the result; then the round bit, bit 7, and below it only
 2160 2ABB ~            ; whether anything remains, at bit 0 -- the seven bits between were computed for nothing.
 2161 2ABB ~            ; ---------------------------------------------------------------------------
 2162 2ABB ~            __x80_fdiv:
 2163 2ABB ~                IFDEF X80_OPT_SIZE
 2164 2ABB ~                CALL __x80_fp_load2
 2165 2ABB ~                CALL __x80_fp_fast2     ; two normal numbers: straight to the division
 2166 2ABB ~                JP   NC,.normal
 2167 2ABB ~                ELSE
 2168 2ABB ~                ; Two normal numbers, as __x80_fmul takes them: the low words to fpa and fpb, the high words
 2169 2ABB ~                ; read where they come, a's leading one put in, the divisor's top byte in D and the exponent
 2170 2ABB ~                ; made in registers. Anything else goes the general way, everything stored as
 2171 2ABB ~                ; __x80_fp_load2 would have.
 2172 2ABB ~                LD   (__x80_fpa),HL
 2173 2ABB ~                LD   H,B
 2174 2ABB ~                LD   L,C
 2175 2ABB ~                LD   (__x80_fpb),HL
 2176 2ABB ~                LD   HL,2
 2177 2ABB ~                ADD  HL,SP
 2178 2ABB ~                LD   A,(HL)
 2179 2ABB ~                INC  HL
 2180 2ABB ~                LD   H,(HL)
 2181 2ABB ~                LD   L,A                ; b's high word
 2182 2ABB ~                LD   A,E
 2183 2ABB ~                ADD  A,A
 2184 2ABB ~                LD   A,D
 2185 2ABB ~                ADC  A,A
 2186 2ABB ~                LD   C,A                ; a's exponent field
 2187 2ABB ~                INC  A
 2188 2ABB ~                CP   2
 2189 2ABB ~                JP   C,.slow            ; 0 or 255
 2190 2ABB ~                LD   A,L
 2191 2ABB ~                ADD  A,A
 2192 2ABB ~                LD   A,H
 2193 2ABB ~                ADC  A,A
 2194 2ABB ~                LD   B,A                ; b's
 2195 2ABB ~                INC  A
 2196 2ABB ~                CP   2
 2197 2ABB ~                JP   C,.slow
 2198 2ABB ~                LD   A,D
 2199 2ABB ~                XOR  H
 2200 2ABB ~                AND  80H
 2201 2ABB ~                LD   (__x80_fps),A      ; the signs'
 2202 2ABB ~                LD   A,E
 2203 2ABB ~                OR   80H
 2204 2ABB ~                LD   (__x80_fpa+2),A
 2205 2ABB ~                LD   A,L
 2206 2ABB ~                OR   80H
 2207 2ABB ~                LD   D,A                ; the divisor's top byte
 2208 2ABB ~                LD   A,C
 2209 2ABB ~                SUB  B
 2210 2ABB ~                LD   L,A
 2211 2ABB ~                SBC  A,A
 2212 2ABB ~                LD   H,A                ; a's exponent less b's
 2213 2ABB ~                LD   BC,127
 2214 2ABB ~                ADD  HL,BC
 2215 2ABB ~                JP   .exponent
 2216 2ABB ~            .slow:
 2217 2ABB ~                LD   (__x80_fpb+2),HL   ; as __x80_fp_load2 leaves them
 2218 2ABB ~                EX   DE,HL
 2219 2ABB ~                LD   (__x80_fpa+2),HL
 2220 2ABB ~                ENDIF
