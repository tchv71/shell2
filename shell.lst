 3989 2ABA ~                EX   DE,HL
 3990 2ABA ~                LD   (__x80_rt_a+2),HL  ; aH
 3991 2ABA ~                LD   H,B
 3992 2ABA ~                LD   L,C
 3993 2ABA ~                LD   (__x80_rt_b),HL    ; bL
 3994 2ABA ~                LD   HL,2
 3995 2ABA ~                ADD  HL,SP
 3996 2ABA ~                LD   A,(HL)
 3997 2ABA ~                INC  HL
 3998 2ABA ~                LD   H,(HL)
 3999 2ABA ~                LD   L,A
 4000 2ABA ~                LD   (__x80_rt_b+2),HL  ; bH
 4001 2ABA ~                LD   HL,(__x80_rt_a)
 4002 2ABA ~                EX   DE,HL              ; DE = aL, BC = bL
 4003 2ABA ~                LD   A,E                ; the smaller the multiplier: its leading zeros are the cheap steps
 4004 2ABA ~                SUB  C
 4005 2ABA ~                LD   A,D
 4006 2ABA ~                SBC  A,B
 4007 2ABA ~                JP   C,.low
 4008 2ABA ~                LD   H,B
 4009 2ABA ~                LD   L,C
 4010 2ABA ~                LD   B,D
 4011 2ABA ~                LD   C,E
 4012 2ABA ~                EX   DE,HL
 4013 2ABA ~            .low:
 4014 2ABA ~                CALL __x80_mulw         ; DE:HL = aL * bL
 4015 2ABA ~                LD   (__x80_rt_lo),HL
 4016 2ABA ~                LD   HL,(__x80_rt_b)
 4017 2ABA ~                LD   B,H
 4018 2ABA ~                LD   C,L
 4019 2ABA ~                LD   HL,(__x80_rt_a+2)
 4020 2ABA ~                CALL .cross             ; + aH * bL
 4021 2ABA ~                LD   HL,(__x80_rt_a)
 4022 2ABA ~                LD   B,H
 4023 2ABA ~                LD   C,L
 4024 2ABA ~                LD   HL,(__x80_rt_b+2)
 4025 2ABA ~                CALL .cross             ; + aL * bH
 4026 2ABA ~                LD   HL,(__x80_rt_lo)
 4027 2ABA ~                RET
 4028 2ABA ~            ; DE += HL * BC, the low sixteen bits: nothing for a zero HL, the high half of a long that holds
 4029 2ABA ~            ; an unsigned int's worth; a subtraction for FFFFh, one that holds a negative int's.
 4030 2ABA ~            .cross:
 4031 2ABA ~                LD   A,H
 4032 2ABA ~                OR   L
 4033 2ABA ~                RET  Z
 4034 2ABA ~                LD   A,H
 4035 2ABA ~                AND  L
 4036 2ABA ~                INC  A
 4037 2ABA ~                JP   Z,.minus
 4038 2ABA ~                PUSH DE
 4039 2ABA ~                LD   D,B
 4040 2ABA ~                LD   E,C
 4041 2ABA ~                CALL __x80_mul16
 4042 2ABA ~                POP  DE
 4043 2ABA ~                ADD  HL,DE
 4044 2ABA ~                EX   DE,HL
 4045 2ABA ~                RET
 4046 2ABA ~            .minus:
 4047 2ABA ~                LD   A,E
 4048 2ABA ~                SUB  C
 4049 2ABA ~                LD   E,A
 4050 2ABA ~                LD   A,D
 4051 2ABA ~                SBC  A,B
 4052 2ABA ~                LD   D,A
 4053 2ABA ~                RET
 4054 2ABA                  ENDIF
