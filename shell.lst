 5150 2BAE ~            ; ---------------------------------------------------------------------------
 5151 2BAE ~            ; A:HL = A * BC as __x80_mul8w, for a caller whose D is zero: a one adds BC and the carry by `ADD
 5152 2BAE ~            ; HL,BC / ADC A,D`, 3 T-states and a byte less than ADC A,0. BC and DE are left alone. In a
 5153 2BAE ~            ; program that multiplies floats too, __x80_mul8w is there already, for __x80_fmul, whose words
 5154 2BAE ~            ; are all taken: then it is that one, rather than both.
 5155 2BAE ~            ; ---------------------------------------------------------------------------
 5156 2BAE ~                IFUSED __x80_fmul
