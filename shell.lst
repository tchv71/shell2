 3573 2ABA ~                LD   C,A
 3574 2ABA ~                LD   A,(__x80_qb+7)
 3575 2ABA ~                XOR  C
 3576 2ABA ~                CALL __x80_q_signed
 3577 2ABA ~                LD   HL,__x80_qa
 3578 2ABA ~                CALL Z,__x80_q_negate
 3579 2ABA ~                LD   HL,__x80_qa
 3580 2ABA ~                JP   __x80_q_give
 3581 2ABA                  ENDIF
