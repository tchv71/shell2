 4265 2AC4                  IFUSED __x80_div_args
 4266 2AC4
 4267 2AC4              ; rt_a = DE:HL, rt_b = [SP+4]:BC -- the stack argument is two return addresses up.
 4268 2AC4              __x80_div_args:
 4269 2AC4 22 4D 2C         LD   (__x80_rt_a),HL
 4270 2AC7 EB               EX   DE,HL
 4271 2AC8 22 4F 2C         LD   (__x80_rt_a+2),HL
 4272 2ACB 60               LD   H,B
 4273 2ACC 69               LD   L,C
 4274 2ACD 22 49 2C         LD   (__x80_rt_b),HL
 4275 2AD0 21 04 00         LD   HL,4
 4276 2AD3 39               ADD  HL,SP
 4277 2AD4 7E               LD   A,(HL)
 4278 2AD5 23               INC  HL
 4279 2AD6 66               LD   H,(HL)
 4280 2AD7 6F               LD   L,A
 4281 2AD8 22 4B 2C         LD   (__x80_rt_b+2),HL
 4282 2ADB C9               RET
 4283 2ADC                  ENDIF
