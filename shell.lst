 4285 2ADC                  IFUSED __x80_signed_divide
 4286 2ADC ~
 4287 2ADC ~            ; Divides the magnitudes, with the sign the result should have in bit 7 of A on entry; returns
 4288 2ADC ~            ; with Z clear when the result is to stay as it is and Z set when it is to be negated.
 4289 2ADC ~            __x80_signed_divide:
