 5288 2BD2 ~            ; ---------------------------------------------------------------------------
 5289 2BD2 ~            ; The signed forms. C says the quotient truncates towards zero and that the remainder
 5290 2BD2 ~            ; has the sign of the dividend, so both are the unsigned division of the magnitudes with
 5291 2BD2 ~            ; the sign put back afterwards.
 5292 2BD2 ~            ; ---------------------------------------------------------------------------
 5293 2BD2 ~            __x80_sdiv16:
 5294 2BD2 ~                LD   A,H            ; the quotient is negative when the signs differ
 5295 2BD2 ~                XOR  D
 5296 2BD2 ~                AND  80H
 5297 2BD2 ~                PUSH AF
 5298 2BD2 ~                CALL __x80_abs_hl
 5299 2BD2 ~                CALL __x80_abs_de
 5300 2BD2 ~                CALL __x80_udiv16
 5301 2BD2 ~                POP  AF
 5302 2BD2 ~                OR   A
 5303 2BD2 ~                RET  Z
 5304 2BD2 ~                JP   __x80_neg_hl
 5305 2BD2                  ENDIF
