  371 2ABB ~                PUSH DE
  372 2ABB ~                LD   HL,__x80_qb
  373 2ABB ~                CALL __x80_d_unpack
  374 2ABB ~                POP  HL
  375 2ABB ~                LD   A,L
  376 2ABB ~                SUB  E
  377 2ABB ~                LD   L,A
  378 2ABB ~                LD   A,H
  379 2ABB ~                SBC  A,D
  380 2ABB ~                LD   H,A
  381 2ABB ~                LD   DE,1023
  382 2ABB ~                ADD  HL,DE
  383 2ABB ~                PUSH HL                 ; the exponent
  384 2ABB ~                LD   HL,__x80_qr
  385 2ABB ~                CALL __x80_q_zero
  386 2ABB ~                LD   A,7
  387 2ABB ~                LD   (__x80_qn),A       ; the quotient's bytes
  388 2ABB ~                LD   HL,__x80_qa+7
  389 2ABB ~                LD   DE,__x80_qb+7
  390 2ABB ~                LD   B,8
  391 2ABB ~                CALL __x80_d_cmp
  392 2ABB ~                JP   NC,.first
  393 2ABB ~                POP  HL
  394 2ABB ~                DEC  HL
  395 2ABB ~                PUSH HL
  396 2ABB ~                LD   HL,__x80_qa
  397 2ABB ~                CALL __x80_q_shl
  398 2ABB ~            .first:
  399 2ABB ~                LD   HL,__x80_qr+7      ; where the next quotient byte goes
