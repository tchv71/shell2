 4329 2AEC              __x80_divide:
 4330 2AEC                  IFDEF X80_OPT_SIZE
 4331 2AEC                  ; -Os: thirty-two steps, restoring, a bit of the quotient each, for every divisor -- some 160
 4332 2AEC                  ; bytes where the passes below are a thousand, and some 11 000 T-states a division, less for
 4333 2AEC                  ; each zero byte at the top of the dividend, which is skipped whole. The
 4334 2AEC                  ; remainder is in DE:HL; the dividend is shifted out of rt_a as the quotient's bits go in at
 4335 2AEC                  ; its bottom; ~d is in rt_r, added with the carry set to take d off.
 4336 2AEC 2A 49 2C         LD   HL,(__x80_rt_b)
 4337 2AEF 7C               LD   A,H
 4338 2AF0 B5               OR   L
 4339 2AF1 2A 4B 2C         LD   HL,(__x80_rt_b+2)
 4340 2AF4 B4               OR   H
 4341 2AF5 B5               OR   L
 4342 2AF6 CA 99 2B         JP   Z,.s_zero
 4343 2AF9 21 49 2C         LD   HL,__x80_rt_b
 4344 2AFC 11 45 2C         LD   DE,__x80_rt_r
 4345 2AFF 06 04            LD   B,4
 4346 2B01              .s_not:
 4347 2B01 7E               LD   A,(HL)
 4348 2B02 2F               CPL
 4349 2B03 12               LD   (DE),A
 4350 2B04 23               INC  HL
 4351 2B05 13               INC  DE
 4352 2B06 05               DEC  B
 4353 2B07 C2 01 2B         JP   NZ,.s_not
 4354 2B0A 06 20            LD   B,32               ; the dividend's top bytes while they are zero: a byte at once, the
 4355 2B0C              .s_skip:                    ; remainder zero still and the quotient's bits 0
 4356 2B0C 3A 50 2C         LD   A,(__x80_rt_a+3)
 4357 2B0F B7               OR   A
 4358 2B10 C2 2A 2B         JP   NZ,.s_go
 4359 2B13 2A 4E 2C         LD   HL,(__x80_rt_a+1)
 4360 2B16 22 4F 2C         LD   (__x80_rt_a+2),HL
 4361 2B19 3A 4D 2C         LD   A,(__x80_rt_a)
 4362 2B1C 32 4E 2C         LD   (__x80_rt_a+1),A
 4363 2B1F AF               XOR  A
 4364 2B20 32 4D 2C         LD   (__x80_rt_a),A
 4365 2B23 78               LD   A,B
 4366 2B24 D6 08            SUB  8
 4367 2B26 47               LD   B,A
 4368 2B27 C2 0C 2B         JP   NZ,.s_skip
 4369 2B2A              .s_go:
 4370 2B2A 21 00 00         LD   HL,0
 4371 2B2D 54               LD   D,H
 4372 2B2E 5D               LD   E,L
 4373 2B2F 78               LD   A,B
 4374 2B30 B7               OR   A
 4375 2B31 CA 91 2B         JP   Z,.s_done          ; a dividend of zero
 4376 2B34              .s_loop:
 4377 2B34 F5               PUSH AF
 4378 2B35 3A 4D 2C         LD   A,(__x80_rt_a)     ; the dividend's top bit out, a 0 in for the quotient's bit
 4379 2B38 87               ADD  A,A
 4380 2B39 32 4D 2C         LD   (__x80_rt_a),A
 4381 2B3C 3A 4E 2C         LD   A,(__x80_rt_a+1)
 4382 2B3F 17               RLA
 4383 2B40 32 4E 2C         LD   (__x80_rt_a+1),A
 4384 2B43 3A 4F 2C         LD   A,(__x80_rt_a+2)
 4385 2B46 17               RLA
 4386 2B47 32 4F 2C         LD   (__x80_rt_a+2),A
 4387 2B4A 3A 50 2C         LD   A,(__x80_rt_a+3)
 4388 2B4D 17               RLA
 4389 2B4E 32 50 2C         LD   (__x80_rt_a+3),A
 4390 2B51 7D               LD   A,L                ; and into the remainder, the carry its thirty-third bit
 4391 2B52 17               RLA
 4392 2B53 6F               LD   L,A
 4393 2B54 7C               LD   A,H
 4394 2B55 17               RLA
 4395 2B56 67               LD   H,A
 4396 2B57 7B               LD   A,E
 4397 2B58 17               RLA
 4398 2B59 5F               LD   E,A
 4399 2B5A 7A               LD   A,D
 4400 2B5B 17               RLA
 4401 2B5C 57               LD   D,A
 4402 2B5D 01 45 2C         LD   BC,__x80_rt_r
 4403 2B60 DA 75 2B         JP   C,.s_take          ; above the divisor whatever the rest
 4404 2B63 37               SCF                     ; R + ~d + 1: the carry if R is not below d
 4405 2B64 0A               LD   A,(BC)
 4406 2B65 8D               ADC  A,L
 4407 2B66 03               INC  BC
 4408 2B67 0A               LD   A,(BC)
 4409 2B68 8C               ADC  A,H
 4410 2B69 03               INC  BC
 4411 2B6A 0A               LD   A,(BC)
 4412 2B6B 8B               ADC  A,E
 4413 2B6C 03               INC  BC
 4414 2B6D 0A               LD   A,(BC)
 4415 2B6E 8A               ADC  A,D
 4416 2B6F D2 8C 2B         JP   NC,.s_next
 4417 2B72 01 45 2C         LD   BC,__x80_rt_r
 4418 2B75              .s_take:
 4419 2B75 37               SCF                     ; d taken off, and a 1
 4420 2B76 0A               LD   A,(BC)
 4421 2B77 8D               ADC  A,L
 4422 2B78 6F               LD   L,A
 4423 2B79 03               INC  BC
 4424 2B7A 0A               LD   A,(BC)
 4425 2B7B 8C               ADC  A,H
 4426 2B7C 67               LD   H,A
 4427 2B7D 03               INC  BC
 4428 2B7E 0A               LD   A,(BC)
 4429 2B7F 8B               ADC  A,E
 4430 2B80 5F               LD   E,A
 4431 2B81 03               INC  BC
 4432 2B82 0A               LD   A,(BC)
 4433 2B83 8A               ADC  A,D
 4434 2B84 57               LD   D,A
 4435 2B85 3A 4D 2C         LD   A,(__x80_rt_a)
 4436 2B88 3C               INC  A
 4437 2B89 32 4D 2C         LD   (__x80_rt_a),A
 4438 2B8C              .s_next:
 4439 2B8C F1               POP  AF
 4440 2B8D 3D               DEC  A
 4441 2B8E C2 34 2B         JP   NZ,.s_loop
 4442 2B91              .s_done:
 4443 2B91 22 45 2C         LD   (__x80_rt_r),HL
 4444 2B94 EB               EX   DE,HL
 4445 2B95 22 47 2C         LD   (__x80_rt_r+2),HL
 4446 2B98 C9               RET
 4447 2B99              .s_zero:
 4448 2B99 2A 4D 2C         LD   HL,(__x80_rt_a)    ; as below: all ones, and the dividend left over
 4449 2B9C 22 45 2C         LD   (__x80_rt_r),HL
 4450 2B9F 2A 4F 2C         LD   HL,(__x80_rt_a+2)
 4451 2BA2 22 47 2C         LD   (__x80_rt_r+2),HL
 4452 2BA5 21 FF FF         LD   HL,0FFFFH
 4453 2BA8 22 4D 2C         LD   (__x80_rt_a),HL
 4454 2BAB 22 4F 2C         LD   (__x80_rt_a+2),HL
 4455 2BAE C9               RET
