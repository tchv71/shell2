 5742 2BEA ~                LD   C,A
 5743 2BEA ~                SBC  A,A
 5744 2BEA ~                SUB  B
 5745 2BEA ~                LD   B,A                ; BC = -BC
 5746 2BEA ~                LD   A,L
 5747 2BEA ~            .positive:
 5748 2BEA ~                LD   H,B
 5749 2BEA ~                LD   L,C
 5750 2BEA ~                JP   __x80_mul16_lead
 5751 2BEA                  ENDIF
 5752 2BEA
 5753 2BEA                  IFUSED __x80_mul16
 5754 2BEA              ; ---------------------------------------------------------------------------
 5755 2BEA              ; HL = HL * DE, sixteen bits, wrapping.
 5756 2BEA              ;
 5757 2BEA              ; Most significant bit first: for each bit of the multiplier the product doubles, and the
 5758 2BEA              ; multiplicand is added where the bit is set. The multiplier goes through A a byte at a time,
 5759 2BEA              ; eight steps unrolled -- ADD HL,HL / ADD A,A / JP NC / ADD HL,BC, twenty-four T-states a bit
 5760 2BEA              ; and ten more for a set one.
 5761 2BEA              ;
 5762 2BEA              ; A multiplier whose high byte is zero skips half of that, and that is the common case by far:
 5763 2BEA              ; an index times the size of an element, a value times a small factor. When it is the
 5764 2BEA              ; multiplicand that is small, the two are exchanged, since the product is the same. About 250
 5765 2BEA              ; T-states then, and about 500 for two full words, against some 1700 for the loop this replaced,
 5766 2BEA              ; which went a bit at a time from the bottom and shifted both operands through A.
 5767 2BEA              ;
 5768 2BEA              ; The multiplier's leading zeros cost nothing but a test each (ivagor, zx-pk.ru): its byte goes
 5769 2BEA              ; out of A a bit at a time, ADD A,A / JP C, 14 T-states, until its top one comes, and that one is
 5770 2BEA              ; the multiplicand itself, already in HL -- the steps after it are entered there
 5771 2BEA              ; (__x80_mul16_lead). A multiplier of 3 is two steps, not eight. With -O3 only: some 25 bytes
 5772 2BEA              ; more, and nearly every program has the multiplication, few spend much time in it; -O2 and -Os
 5773 2BEA              ; keep the eight steps from zero.
 5774 2BEA              ;
 5775 2BEA              ; Constant multipliers mostly do not come here: the compiler expands them into doublings and
 5776 2BEA              ; additions.
 5777 2BEA              ; ---------------------------------------------------------------------------
 5778 2BEA              __x80_mul16:
 5779 2BEA AF               XOR  A
 5780 2BEB B2               OR   D
 5781 2BEC CA F5 2B         JP   Z,.small       ; the multiplier fits in a byte
 5782 2BEF AF               XOR  A
 5783 2BF0 B4               OR   H
 5784 2BF1 C2 FE 2B         JP   NZ,.full
 5785 2BF4 EB               EX   DE,HL          ; the multiplicand does: make it the multiplier
 5786 2BF5              .small:
 5787 2BF5 44               LD   B,H
 5788 2BF6 4D               LD   C,L            ; BC = multiplicand
 5789 2BF7                  IFNDEF X80_OPT_SPEED
 5790 2BF7 21 00 00         LD   HL,0
 5791 2BFA 7B               LD   A,E
 5792 2BFB C3 08 2C         JP   __x80_mul16_byte
 5793 2BFE              .full:
 5794 2BFE 44               LD   B,H
 5795 2BFF 4D               LD   C,L
 5796 2C00 21 00 00         LD   HL,0
 5797 2C03 7A               LD   A,D
 5798 2C04 CD 08 2C         CALL __x80_mul16_byte
 5799 2C07 7B               LD   A,E
 5800 2C08                  ELSE
 5801 2C08 ~                LD   A,E
 5802 2C08 ~                JP   __x80_mul16_lead   ; HL = BC already
 5803 2C08 ~            .full:
 5804 2C08 ~                LD   B,H
 5805 2C08 ~                LD   C,L
 5806 2C08 ~                LD   A,D
 5807 2C08 ~                CALL __x80_mul16_lead   ; HL = BC * the high byte, which is not zero
 5808 2C08 ~                LD   A,E
 5809 2C08 ~                JP   __x80_mul16_byte   ; HL * 256 + BC * the low byte
 5810 2C08                  ENDIF
 5811 2C08                  ENDIF
 5812 2C08
 5813 2C08                  IFUSED __x80_mul16_byte
 5814 2C08              ; HL = HL * 256 + BC * A: eight steps of the above, for the byte in A. What __x80_mul16 falls into,
 5815 2C08              ; and what the compiler calls itself for a word by a byte widened (isel.c, select_muldiv).
 5816 2C08              __x80_mul16_byte:
 5817 2C08                  IFDEF X80_OPT_SIZE
 5818 2C08                  ; -Os: the steps as a loop, 18 bytes for 49. The multiplier's bits go out of A with a 1 in
 5819 2C08                  ; behind them at the bottom; when that 1 comes out, A is zero and the eight are done.
 5820 2C08 37               SCF
 5821 2C09 8F               ADC  A,A
 5822 2C0A              .s_bit:
 5823 2C0A D2 14 2C         JP   NC,.s_zero
 5824 2C0D 29               ADD  HL,HL
 5825 2C0E 09               ADD  HL,BC
 5826 2C0F 87               ADD  A,A
 5827 2C10 C2 0A 2C         JP   NZ,.s_bit
 5828 2C13 C9               RET
 5829 2C14              .s_zero:
 5830 2C14 29               ADD  HL,HL
 5831 2C15 87               ADD  A,A
 5832 2C16 C2 0A 2C         JP   NZ,.s_bit
 5833 2C19 C9               RET
 5834 2C1A                  ELSE
 5835 2C1A ~                ADD  HL,HL
 5836 2C1A ~                ADD  A,A
 5837 2C1A ~                JP   NC,$+4
 5838 2C1A ~                ADD  HL,BC
 5839 2C1A ~            __x80_mul16_b7:             ; the steps for the last seven bits, where __x80_mul16_lead comes in
 5840 2C1A ~                ADD  HL,HL
 5841 2C1A ~                ADD  A,A
 5842 2C1A ~                JP   NC,$+4
 5843 2C1A ~                ADD  HL,BC
 5844 2C1A ~            __x80_mul16_b6:
 5845 2C1A ~                ADD  HL,HL
 5846 2C1A ~                ADD  A,A
 5847 2C1A ~                JP   NC,$+4
 5848 2C1A ~                ADD  HL,BC
 5849 2C1A ~            __x80_mul16_b5:
 5850 2C1A ~                ADD  HL,HL
 5851 2C1A ~                ADD  A,A
 5852 2C1A ~                JP   NC,$+4
 5853 2C1A ~                ADD  HL,BC
 5854 2C1A ~            __x80_mul16_b4:
 5855 2C1A ~                ADD  HL,HL
 5856 2C1A ~                ADD  A,A
 5857 2C1A ~                JP   NC,$+4
 5858 2C1A ~                ADD  HL,BC
 5859 2C1A ~            __x80_mul16_b3:
 5860 2C1A ~                ADD  HL,HL
 5861 2C1A ~                ADD  A,A
 5862 2C1A ~                JP   NC,$+4
 5863 2C1A ~                ADD  HL,BC
 5864 2C1A ~            __x80_mul16_b2:
 5865 2C1A ~                ADD  HL,HL
 5866 2C1A ~                ADD  A,A
 5867 2C1A ~                JP   NC,$+4
 5868 2C1A ~                ADD  HL,BC
 5869 2C1A ~            __x80_mul16_b1:
 5870 2C1A ~                ADD  HL,HL
 5871 2C1A ~                ADD  A,A
 5872 2C1A ~                RET  NC
 5873 2C1A ~                ADD  HL,BC
 5874 2C1A ~                RET
 5875 2C1A                  ENDIF
 5876 2C1A                  ENDIF
