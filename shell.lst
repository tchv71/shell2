 3519 2ABA              ; ---------------------------------------------------------------------------
 3520 2ABA              ; Sixty-four bits: [HL] = [HL] op [DE], or [HL] shifted by the count in DE.
 3521 2ABA              ;
 3522 2ABA              ; The operands are eight bytes each, which no set of registers on this machine can hold, so these
 3523 2ABA              ; take them by address -- the legaliser writes them into the caller's frame -- and work on copies
 3524 2ABA              ; in static memory, a byte at a time. Simple and slow: the point for now is that long long works.
 3525 2ABA              ; Multiplication is shift-and-add over sixty-four bits, division a restoring loop, sixty-four
 3526 2ABA              ; times.
 3527 2ABA              ; ---------------------------------------------------------------------------
 3528 2ABA                  IFUSED __x80_qmul
 3529 2ABA ~            __x80_qmul:
 3530 2ABA ~                CALL __x80_q_take2
 3531 2ABA ~                LD   HL,__x80_qr
 3532 2ABA ~                CALL __x80_q_zero
 3533 2ABA ~                LD   A,64
 3534 2ABA ~                LD   (__x80_qn),A
 3535 2ABA ~            .loop:
 3536 2ABA ~                LD   HL,__x80_qb+7      ; the multiplier's low bit out
 3537 2ABA ~                CALL __x80_q_shr
 3538 2ABA ~                JP   NC,.skip
 3539 2ABA ~                LD   HL,__x80_qr        ; and the multiplicand added where it was set
 3540 2ABA ~                LD   DE,__x80_qa
 3541 2ABA ~                CALL __x80_q_add
 3542 2ABA ~            .skip:
 3543 2ABA ~                LD   HL,__x80_qa
 3544 2ABA ~                CALL __x80_q_shl
 3545 2ABA ~                LD   A,(__x80_qn)
 3546 2ABA ~                DEC  A
 3547 2ABA ~                LD   (__x80_qn),A
 3548 2ABA ~                JP   NZ,.loop
 3549 2ABA ~                LD   HL,__x80_qr
 3550 2ABA ~                JP   __x80_q_give
 3551 2ABA                  ENDIF
 3552 2ABA
 3553 2ABA                  IFUSED __x80_qudiv
 3554 2ABA ~            __x80_qudiv:
 3555 2ABA ~                CALL __x80_q_take2
 3556 2ABA ~                CALL __x80_q_divide
 3557 2ABA ~                LD   HL,__x80_qa
 3558 2ABA ~                JP   __x80_q_give
 3559 2ABA                  ENDIF
