  359 2ABB ~                CALL __x80_d_nan2
  360 2ABB ~                CALL __x80_d_sign
  361 2ABB ~                LD   HL,__x80_qa
  362 2ABB ~                CALL __x80_d_class
  363 2ABB ~                JP   C,.a_inf
  364 2ABB ~                JP   Z,.a_zero
  365 2ABB ~                LD   HL,__x80_qb
