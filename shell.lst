 1807 2ABB ~                OR   A
 1808 2ABB ~                JP   P,__x80_fp_rpack   ; a subnormal's sum, from the general way
 1809 2ABB ~                LD   A,C
 1810 2ABB ~                INC  A
 1811 2ABB ~                JP   Z,__x80_fp_rpack   ; too large
 1812 2ABB ~                DEC  C
 1813 2ABB ~                JP   __x80_fp_rpack.round
