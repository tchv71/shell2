 3519 2ABB              ; ---------------------------------------------------------------------------
 3520 2ABB              ; Sixty-four bits: [HL] = [HL] op [DE], or [HL] shifted by the count in DE.
 3521 2ABB              ;
 3522 2ABB              ; The operands are eight bytes each, which no set of registers on this machine can hold, so these
 3523 2ABB              ; take them by address -- the legaliser writes them into the caller's frame -- and work on copies
 3524 2ABB              ; in static memory, a byte at a time. Simple and slow: the point for now is that long long works.
 3525 2ABB              ; Multiplication is shift-and-add over sixty-four bits, division a restoring loop, sixty-four
 3526 2ABB              ; times.
 3527 2ABB              ; ---------------------------------------------------------------------------
 3528 2ABB                  IFUSED __x80_qmul
 3529 2ABB ~            __x80_qmul:
 3530 2ABB ~                CALL __x80_q_take2
 3531 2ABB ~                LD   HL,__x80_qr
 3532 2ABB ~                CALL __x80_q_zero
 3533 2ABB ~                LD   A,64
 3534 2ABB ~                LD   (__x80_qn),A
 3535 2ABB ~            .loop:
 3536 2ABB ~                LD   HL,__x80_qb+7      ; the multiplier's low bit out
 3537 2ABB ~                CALL __x80_q_shr
 3538 2ABB ~                JP   NC,.skip
 3539 2ABB ~                LD   HL,__x80_qr        ; and the multiplicand added where it was set
 3540 2ABB ~                LD   DE,__x80_qa
 3541 2ABB ~                CALL __x80_q_add
 3542 2ABB ~            .skip:
 3543 2ABB ~                LD   HL,__x80_qa
 3544 2ABB ~                CALL __x80_q_shl
 3545 2ABB ~                LD   A,(__x80_qn)
 3546 2ABB ~                DEC  A
 3547 2ABB ~                LD   (__x80_qn),A
 3548 2ABB ~                JP   NZ,.loop
 3549 2ABB ~                LD   HL,__x80_qr
 3550 2ABB ~                JP   __x80_q_give
 3551 2ABB                  ENDIF
