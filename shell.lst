 6014 2C1C ~            ; The right shifts take the shortest of three ways: a byte at once for a
 6015 2C1C ~            ; count of eight or more, and then the one byte that is left; the low byte alone when the high one
 6016 2C1C ~            ; is zero; and for a count of four to seven, a shift left by eight less the count through A, whose
 6017 2C1C ~            ; top two bytes are the answer -- ADD HL,HL / RLA, 29 T-states a step against 46 to the right.
 6018 2C1C ~            ; The long counts are tested first: they are what a decoder's bit reader shifts by, and where
 6019 2C1C ~            ; the time goes.
 6020 2C1C ~            __x80_lshr16:
 6021 2C1C ~                XOR  A
 6022 2C1C ~                OR   E
 6023 2C1C ~                RET  Z
 6024 2C1C ~                CP   8
 6025 2C1C ~                JP   NC,.bytes
 6026 2C1C ~                LD   B,A
 6027 2C1C ~                INC  H                  ; the high byte zero: A kept (ivagor, zx-pk.ru)
 6028 2C1C ~                DEC  H
 6029 2C1C ~                JP   Z,.low
 6030 2C1C ~                CP   4
 6031 2C1C ~                JP   NC,.left
 6032 2C1C ~            .loop:
 6033 2C1C ~                XOR  A
 6034 2C1C ~                OR   H                  ; and the carry clear, so a zero comes in at the top
 6035 2C1C ~                RRA
 6036 2C1C ~                LD   H,A
 6037 2C1C ~                LD   A,L
 6038 2C1C ~                RRA
 6039 2C1C ~                LD   L,A
 6040 2C1C ~                DEC  B
 6041 2C1C ~                JP   NZ,.loop
 6042 2C1C ~                RET
 6043 2C1C ~            .left:
 6044 2C1C ~                LD   A,8
 6045 2C1C ~                SUB  B
 6046 2C1C ~                LD   B,A
 6047 2C1C ~                XOR  A
 6048 2C1C ~            .left_loop:
 6049 2C1C ~                ADD  HL,HL
 6050 2C1C ~                RLA
 6051 2C1C ~                DEC  B
 6052 2C1C ~                JP   NZ,.left_loop
 6053 2C1C ~                LD   L,H
 6054 2C1C ~                LD   H,A
 6055 2C1C ~                RET
 6056 2C1C ~            .bytes:
 6057 2C1C ~                LD   L,H
 6058 2C1C ~                LD   H,0
 6059 2C1C ~                SUB  8
 6060 2C1C ~                RET  Z
 6061 2C1C ~                CP   8
 6062 2C1C ~                JP   NC,.zero
 6063 2C1C ~                LD   B,A
 6064 2C1C ~            .low:
 6065 2C1C ~                LD   A,L
 6066 2C1C ~            .byte:
 6067 2C1C ~                OR   A
 6068 2C1C ~                RRA
 6069 2C1C ~                DEC  B
 6070 2C1C ~                JP   NZ,.byte
 6071 2C1C ~                LD   L,A
 6072 2C1C ~                RET
 6073 2C1C ~            .zero:
 6074 2C1C ~                LD   L,H
 6075 2C1C ~                RET
