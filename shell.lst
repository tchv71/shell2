 5412 2C0E ~                POP  HL
 5413 2C0E ~                PUSH HL
 5414 2C0E ~                LD   L,A            ; the remainder and the low byte
 5415 2C0E ~                CALL __x80_dpass8
 5416 2C0E ~                LD   E,H
 5417 2C0E ~                LD   D,0
 5418 2C0E ~                POP  HL
 5419 2C0E ~                LD   H,L            ; the high byte of the quotient
 5420 2C0E ~                LD   L,A
 5421 2C0E ~                RET
 5422 2C0E ~            .below:
 5423 2C0E ~                LD   E,L
 5424 2C0E ~                LD   HL,0
