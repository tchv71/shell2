 4980 2BAF                  IFUSED __x80_mulw
 4981 2BAF ~
 4982 2BAF ~            ; ---------------------------------------------------------------------------
 4983 2BAF ~            ; DE:HL = DE * BC, unsigned, the whole thirty-two-bit product. BC is left alone.
 4984 2BAF ~            ;
 4985 2BAF ~            ; Two products of a byte and a word, __x80_mul8w_d's with D zero for them: E * BC, and D * BC a
 4986 2BAF ~            ; byte further up, added together -- some 700 T-states for two full words, against about 1300 for the loop this replaced,
 4987 2BAF ~            ; which shifted the multiplier and the product's high half through DE a bit at a time. A multiplier
 4988 2BAF ~            ; below 256, which is what float's multiplication passes three times out of four, is the one
 4989 2BAF ~            ; product, some 300 T-states.
 4990 2BAF ~            ; ---------------------------------------------------------------------------
 4991 2BAF ~            __x80_mulw:
 4992 2BAF ~                XOR  A
 4993 2BAF ~                OR   D
 4994 2BAF ~                JP   NZ,.full
 4995 2BAF ~                LD   A,E
 4996 2BAF ~                CALL __x80_mul8w_d      ; A:HL = E * BC, with the zero D
 4997 2BAF ~                LD   E,A                ; D is zero still
 4998 2BAF ~                RET
 4999 2BAF ~            .full:
 5000 2BAF ~                LD   A,E
 5001 2BAF ~                LD   E,D                ; the high byte waits in E,
 5002 2BAF ~                LD   D,0                ; and D is the zero __x80_mul8w_d wants
 5003 2BAF ~                CALL __x80_mul8w_d      ; A:HL = low byte * BC; DE is left alone
 5004 2BAF ~                PUSH HL                 ; the low product's low word
 5005 2BAF ~                LD   L,A
 5006 2BAF ~                LD   A,E
 5007 2BAF ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 2BAF ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 2BAF ~                LD   D,A
 5010 2BAF ~                LD   A,L
 5011 2BAF ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 2BAF ~                ADD  A,H
 5013 2BAF ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 2BAF ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 2BAF ~                LD   A,E
 5016 2BAF ~                ADC  A,H                ; the third: EX and LD leave the carry
 5017 2BAF ~                LD   E,A
 5018 2BAF ~                LD   A,D
 5019 2BAF ~                ADC  A,0                ; the fourth
 5020 2BAF ~                LD   D,A
 5021 2BAF ~                POP  HL
 5022 2BAF ~                RET
 5023 2BAF                  ENDIF
