 6695 2C43              ; ---------------------------------------------------------------------------
 6696 2C43              ; A copy or a zeroing of a known size above __x80_mcpy_N's 32, two bytes a trip (SIA, zx-pk.ru):
 6697 2C43              ; HL = destination, DE = source; BC the trips, the pairs of bytes, as two counters one inside
 6698 2C43              ; the other -- C the low byte (0 for 256), B the high one and one more where C is not 0 -- which
 6699 2C43              ; the compiler works out (isel.c, select_block_move), and an odd count entered at the second
 6700 2C43              ; byte of the first pair. 31.5 T-states a byte for a copy, against 47 a byte for __x80_memcpy's
 6701 2C43              ; word counted down; 19.5 for a zeroing, against 38. __x80_mcpyp_* write A, BC, DE and HL;
 6702 2C43              ; __x80_mzerop_* A, BC and HL.
 6703 2C43              ; ---------------------------------------------------------------------------
 6704 2C43              __x80_mcpyp_any = 0
 6705 2C43                  IFUSED __x80_mcpyp_even
