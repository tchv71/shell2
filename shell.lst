 6078 2C1A                  IFUSED __x80_ashr16
 6079 2C1A ~
 6080 2C1A ~            ; As the logical shift, the sign coming in at the top: a whole byte of it for eight or more, and
 6081 2C1A ~            ; for four to seven the shift left starts with the sign's byte in A.
 6082 2C1A ~            __x80_ashr16:
 6083 2C1A ~                XOR  A
 6084 2C1A ~                OR   E
 6085 2C1A ~                RET  Z
 6086 2C1A ~                LD   B,A
 6087 2C1A ~                CP   8
 6088 2C1A ~                JP   NC,.bytes
 6089 2C1A ~                CP   4
 6090 2C1A ~                JP   NC,.left
 6091 2C1A ~            .loop:
 6092 2C1A ~                LD   A,H
 6093 2C1A ~                RLCA                    ; the sign into the carry
 6094 2C1A ~                RRCA                    ; H as it was, a T-state less than LD A,H again
 6095 2C1A ~                RRA                     ; and the sign back into the top bit, so it replaces itself
 6096 2C1A ~                LD   H,A
 6097 2C1A ~                LD   A,L
 6098 2C1A ~                RRA
 6099 2C1A ~                LD   L,A
 6100 2C1A ~                DEC  B
 6101 2C1A ~                JP   NZ,.loop
 6102 2C1A ~                RET
 6103 2C1A ~            .left:
 6104 2C1A ~                LD   A,8
 6105 2C1A ~                SUB  B
 6106 2C1A ~                LD   B,A
 6107 2C1A ~                LD   A,H
 6108 2C1A ~                RLA
 6109 2C1A ~                SBC  A,A                ; the sign's byte, 00h or FFh
 6110 2C1A ~            .left_loop:
 6111 2C1A ~                ADD  HL,HL
 6112 2C1A ~                RLA
 6113 2C1A ~                DEC  B
 6114 2C1A ~                JP   NZ,.left_loop
 6115 2C1A ~                LD   L,H
 6116 2C1A ~                LD   H,A
 6117 2C1A ~                RET
 6118 2C1A ~            .bytes:
 6119 2C1A ~                LD   L,H
 6120 2C1A ~                LD   A,H
 6121 2C1A ~                RLA
 6122 2C1A ~                SBC  A,A
 6123 2C1A ~                LD   H,A                ; the sign's byte above
 6124 2C1A ~                LD   A,B
 6125 2C1A ~                SUB  8
 6126 2C1A ~                RET  Z
 6127 2C1A ~                CP   8
 6128 2C1A ~                JP   NC,.all
 6129 2C1A ~                LD   B,A
 6130 2C1A ~                LD   A,L
 6131 2C1A ~            .byte:
 6132 2C1A ~                RLCA                    ; the byte's sign into the carry,
 6133 2C1A ~                RRCA                    ; the byte as it was,
 6134 2C1A ~                RRA                     ; and shifted with the sign: the byte stays in A, 27 T-states a step
 6135 2C1A ~                DEC  B
 6136 2C1A ~                JP   NZ,.byte
 6137 2C1A ~                LD   L,A
 6138 2C1A ~                RET
 6139 2C1A ~            .all:
 6140 2C1A ~                LD   L,H
 6141 2C1A ~                RET
 6142 2C1A                  ENDIF
