 4219 2ABC              ; ---------------------------------------------------------------------------
 4220 2ABC              ; Division and remainder, unsigned and signed.
 4221 2ABC              ;
 4222 2ABC              ; Over memory: the dividend in rt_a, which then holds the quotient, the divisor in rt_b, the
 4223 2ABC              ; remainder in rt_r (__x80_divide). A byte of the quotient at a time: by __x80_dpass8 and
 4224 2ABC              ; __x80_dpass16 for a divisor below 32768, by passes with a 24- or 32-bit remainder for a larger. C truncates the quotient towards zero and gives the remainder the sign of the dividend, so the
 4225 2ABC              ; signed forms are the unsigned division of the magnitudes with the sign put back afterwards.
 4226 2ABC              ; ---------------------------------------------------------------------------
 4227 2ABC              __x80_ludiv:
 4228 2ABC CD C5 2A         CALL __x80_div_args
 4229 2ABF CD ED 2A         CALL __x80_divide
 4230 2AC2 C3 DD 2A         JP   __x80_quotient
 4231 2AC5                  ENDIF
 4232 2AC5
 4233 2AC5                  IFUSED __x80_lurem
 4234 2AC5 ~
 4235 2AC5 ~            __x80_lurem:
 4236 2AC5 ~                CALL __x80_div_args
 4237 2AC5 ~                CALL __x80_divide
 4238 2AC5 ~                JP   __x80_remainder
 4239 2AC5                  ENDIF
 4240 2AC5
 4241 2AC5                  IFUSED __x80_lsdiv
 4242 2AC5 ~
 4243 2AC5 ~            __x80_lsdiv:
 4244 2AC5 ~                CALL __x80_div_args
 4245 2AC5 ~                LD   A,(__x80_rt_a+3)   ; the quotient is negative when the signs differ
 4246 2AC5 ~                LD   C,A
 4247 2AC5 ~                LD   A,(__x80_rt_b+3)
 4248 2AC5 ~                XOR  C
 4249 2AC5 ~                CALL __x80_signed_divide
 4250 2AC5 ~                CALL Z,__x80_negate_a
 4251 2AC5 ~                JP   __x80_quotient
 4252 2AC5                  ENDIF
 4253 2AC5
 4254 2AC5                  IFUSED __x80_lsrem
 4255 2AC5 ~
 4256 2AC5 ~            __x80_lsrem:
 4257 2AC5 ~                CALL __x80_div_args
 4258 2AC5 ~                LD   A,(__x80_rt_a+3)   ; the remainder takes the sign of the dividend
 4259 2AC5 ~                CALL __x80_signed_divide
 4260 2AC5 ~                LD   HL,__x80_rt_r
 4261 2AC5 ~                CALL Z,__x80_negate32
 4262 2AC5 ~                JP   __x80_remainder
 4263 2AC5                  ENDIF
