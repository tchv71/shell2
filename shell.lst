 1471 2ABC ~                ; to fpa and fpb, the high words kept in DE and HL, where the exponents and the signs are read;
 1472 2ABC ~                ; the larger's significand left in fpa -- b's put there when b is the larger -- and the
 1473 2ABC ~                ; smaller's in DEHL for the shift. Anything else goes the general way below, everything stored
 1474 2ABC ~                ; as __x80_fp_load2 would have. Some 750 T-states where that took 1290 (ivagor, zx-pk.ru).
 1475 2ABC ~                LD   (__x80_fpa),HL
 1476 2ABC ~                LD   H,B
 1477 2ABC ~                LD   L,C
 1478 2ABC ~                LD   (__x80_fpb),HL
 1479 2ABC ~                LD   HL,2
