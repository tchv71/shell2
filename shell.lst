 5393 2BEA ~                CP   E
 5394 2BEA ~                JP   C,.below
 5395 2BEA ~            .one:
 5396 2BEA ~                CALL __x80_dsetup8  ; the high byte below the divisor: one pass
 5397 2BEA ~                CALL __x80_dpass8
 5398 2BEA ~                LD   E,H            ; the remainder
 5399 2BEA ~                LD   D,0
 5400 2BEA ~                LD   L,A
 5401 2BEA ~                LD   H,D
 5402 2BEA ~                RET
 5403 2BEA ~            .two:
 5404 2BEA ~                PUSH HL             ; the low byte, for the second pass
 5405 2BEA ~                CALL __x80_dsetup8
 5406 2BEA ~                LD   L,H            ; the high byte alone first
 5407 2BEA ~                LD   H,0
 5408 2BEA ~                CALL __x80_dpass8   ; its quotient in A, the remainder in H
 5409 2BEA ~                LD   L,A
 5410 2BEA ~                EX   (SP),HL        ; that kept; the dividend back
 5411 2BEA ~                LD   A,L
 5412 2BEA ~                POP  HL
 5413 2BEA ~                PUSH HL
 5414 2BEA ~                LD   L,A            ; the remainder and the low byte
 5415 2BEA ~                CALL __x80_dpass8
 5416 2BEA ~                LD   E,H
 5417 2BEA ~                LD   D,0
 5418 2BEA ~                POP  HL
 5419 2BEA ~                LD   H,L            ; the high byte of the quotient
 5420 2BEA ~                LD   L,A
 5421 2BEA ~                RET
 5422 2BEA ~            .below:
 5423 2BEA ~                LD   E,L
 5424 2BEA ~                LD   HL,0
 5425 2BEA ~                RET
 5426 2BEA ~            .wide:
 5427 2BEA ~                JP   M,.big
 5428 2BEA ~                LD   B,D            ; 256..32767: a quotient below 256
 5429 2BEA ~                LD   C,E
 5430 2BEA ~                XOR  A
 5431 2BEA ~                SUB  E
 5432 2BEA ~                LD   E,A
 5433 2BEA ~                LD   A,0
 5434 2BEA ~                SBC  A,D
 5435 2BEA ~                LD   D,A
 5436 2BEA ~                PUSH HL             ; the low byte, for after the pass
 5437 2BEA ~                LD   L,H            ; the high byte, below the divisor
 5438 2BEA ~                LD   H,0
 5439 2BEA ~                ADD  HL,DE          ; as __x80_dpass16 takes a remainder
 5440 2BEA ~                CALL __x80_dpass16
 5441 2BEA ~                POP  DE
 5442 2BEA ~                LD   D,A            ; the quotient
 5443 2BEA ~                LD   A,E            ; the low byte added to the remainder
 5444 2BEA ~                ADD  A,L
 5445 2BEA ~                LD   L,A
 5446 2BEA ~                LD   A,H
 5447 2BEA ~                ADC  A,0
 5448 2BEA ~                LD   H,A
 5449 2BEA ~                JP   C,.up          ; it reached the divisor: one more
 5450 2BEA ~                ADD  HL,BC          ; the remainder as it is
 5451 2BEA ~                EX   DE,HL
 5452 2BEA ~                LD   L,H
 5453 2BEA ~                LD   H,0
 5454 2BEA ~                RET
 5455 2BEA ~            .up:
 5456 2BEA ~                INC  D
 5457 2BEA ~                EX   DE,HL
 5458 2BEA ~                LD   L,H
 5459 2BEA ~                LD   H,0
 5460 2BEA ~                RET
 5461 2BEA ~            .big:
 5462 2BEA ~                LD   A,L            ; 32768 or more: the quotient is 1 if the dividend is not below
 5463 2BEA ~                SUB  E
 5464 2BEA ~                LD   C,A
 5465 2BEA ~                LD   A,H
 5466 2BEA ~                SBC  A,D
 5467 2BEA ~                JP   C,.less
 5468 2BEA ~                LD   D,A
 5469 2BEA ~                LD   E,C
 5470 2BEA ~                LD   HL,1
 5471 2BEA ~                RET
 5472 2BEA ~            .less:
 5473 2BEA ~                EX   DE,HL          ; below the divisor: the dividend is the remainder
 5474 2BEA ~                LD   HL,0
 5475 2BEA ~                RET
 5476 2BEA ~            .by_zero:
