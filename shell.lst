 5429 2BEC ~                LD   C,E
 5430 2BEC ~                XOR  A
 5431 2BEC ~                SUB  E
 5432 2BEC ~                LD   E,A
 5433 2BEC ~                LD   A,0
 5434 2BEC ~                SBC  A,D
