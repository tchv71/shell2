 4981 2BD2 ~
 4982 2BD2 ~            ; ---------------------------------------------------------------------------
 4983 2BD2 ~            ; DE:HL = DE * BC, unsigned, the whole thirty-two-bit product. BC is left alone.
 4984 2BD2 ~            ;
 4985 2BD2 ~            ; Two products of a byte and a word, __x80_mul8w_d's with D zero for them: E * BC, and D * BC a
 4986 2BD2 ~            ; byte further up, added together -- some 700 T-states for two full words, against about 1300 for the loop this replaced,
 4987 2BD2 ~            ; which shifted the multiplier and the product's high half through DE a bit at a time. A multiplier
 4988 2BD2 ~            ; below 256, which is what float's multiplication passes three times out of four, is the one
 4989 2BD2 ~            ; product, some 300 T-states.
 4990 2BD2 ~            ; ---------------------------------------------------------------------------
 4991 2BD2 ~            __x80_mulw:
 4992 2BD2 ~                XOR  A
 4993 2BD2 ~                OR   D
 4994 2BD2 ~                JP   NZ,.full
 4995 2BD2 ~                LD   A,E
 4996 2BD2 ~                CALL __x80_mul8w_d      ; A:HL = E * BC, with the zero D
 4997 2BD2 ~                LD   E,A                ; D is zero still
 4998 2BD2 ~                RET
 4999 2BD2 ~            .full:
 5000 2BD2 ~                LD   A,E
 5001 2BD2 ~                LD   E,D                ; the high byte waits in E,
 5002 2BD2 ~                LD   D,0                ; and D is the zero __x80_mul8w_d wants
 5003 2BD2 ~                CALL __x80_mul8w_d      ; A:HL = low byte * BC; DE is left alone
 5004 2BD2 ~                PUSH HL                 ; the low product's low word
 5005 2BD2 ~                LD   L,A
 5006 2BD2 ~                LD   A,E
 5007 2BD2 ~                LD   E,L                ; its top byte in E, the high byte in A
 5008 2BD2 ~                CALL __x80_mul8w_d      ; A:HL = high byte * BC, to go a byte up
 5009 2BD2 ~                LD   D,A
 5010 2BD2 ~                LD   A,L
 5011 2BD2 ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 2BD2 ~                ADD  A,H
 5013 2BD2 ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 2BD2 ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 2BD2 ~                LD   A,E
 5016 2BD2 ~                ADC  A,H                ; the third: EX and LD leave the carry
 5017 2BD2 ~                LD   E,A
 5018 2BD2 ~                LD   A,D
 5019 2BD2 ~                ADC  A,0                ; the fourth
 5020 2BD2 ~                LD   D,A
 5021 2BD2 ~                POP  HL
 5022 2BD2 ~                RET
 5023 2BD2                  ENDIF
