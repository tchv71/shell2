 4246 2AC4 ~                LD   C,A
 4247 2AC4 ~                LD   A,(__x80_rt_b+3)
 4248 2AC4 ~                XOR  C
 4249 2AC4 ~                CALL __x80_signed_divide
 4250 2AC4 ~                CALL Z,__x80_negate_a
 4251 2AC4 ~                JP   __x80_quotient
 4252 2AC4                  ENDIF
