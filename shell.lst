 1256 2ABB ~                ADD  A,A
 1257 2ABB ~                ADD  A,A                ; its low four, at the top of the byte
 1258 2ABB ~                LD   HL,__x80_qa+6
 1259 2ABB ~                ADD  A,(HL)
 1260 2ABB ~                LD   (HL),A
 1261 2ABB ~                INC  HL
 1262 2ABB ~                LD   A,C
 1263 2ABB ~                ADC  A,0
 1264 2ABB ~                LD   C,A
 1265 2ABB ~                LD   A,(__x80_dsg)
 1266 2ABB ~                OR   C
 1267 2ABB ~                LD   (HL),A
 1268 2ABB ~                LD   HL,__x80_qa
 1269 2ABB ~                JP   __x80_q_give
 1270 2ABB ~            __x80_d_zero:
