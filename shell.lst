 4001 2ADE ~                LD   HL,(__x80_rt_a)
 4002 2ADE ~                EX   DE,HL              ; DE = aL, BC = bL
 4003 2ADE ~                LD   A,E                ; the smaller the multiplier: its leading zeros are the cheap steps
 4004 2ADE ~                SUB  C
 4005 2ADE ~                LD   A,D
 4006 2ADE ~                SBC  A,B
 4007 2ADE ~                JP   C,.low
 4008 2ADE ~                LD   H,B
 4009 2ADE ~                LD   L,C
 4010 2ADE ~                LD   B,D
 4011 2ADE ~                LD   C,E
 4012 2ADE ~                EX   DE,HL
 4013 2ADE ~            .low:
 4014 2ADE ~                CALL __x80_mulw         ; DE:HL = aL * bL
