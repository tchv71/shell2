 4081 2ABB ~                ADD  HL,HL
 4082 2ABB ~                LD   A,E
 4083 2ABB ~                RLA
 4084 2ABB ~                LD   E,A
 4085 2ABB ~                LD   A,D
 4086 2ABB ~                RLA
 4087 2ABB ~                LD   D,A
 4088 2ABB ~                DEC  C
 4089 2ABB ~                JP   NZ,.loop
 4090 2ABB ~                RET
