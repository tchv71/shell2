 6213 2C3E ~                CP   X80_SP_RESERVE + 32
 6214 2C3E ~                JP   NC,__x80_mcpys
 6215 2C3E ~                JP   .near
 6216 2C3E ~            .up:
 6217 2C3E ~                LD   A,E                ; s - d
 6218 2C3E ~                SUB  L
 6219 2C3E ~                LD   A,D
 6220 2C3E ~                SBC  A,H
 6221 2C3E ~                JP   NZ,.up_far
 6222 2C3E ~                LD   A,E
 6223 2C3E ~                SUB  L
 6224 2C3E ~                CP   X80_SP_RESERVE
 6225 2C3E ~                JP   C,__x80_mcpyn_pairs
 6226 2C3E ~            .up_far:
 6227 2C3E ~                LD   A,B
 6228 2C3E ~                OR   A
 6229 2C3E ~                JP   NZ,__x80_mmoves
 6230 2C3E ~                LD   A,C
 6231 2C3E ~                CP   X80_SP_RESERVE + 32
 6232 2C3E ~                JP   NC,__x80_mmoves
 6233 2C3E ~                JP   __x80_mcpyn_pairs
 6234 2C3E ~            .near:
 6235 2C3E ~                ELSE
 6236 2C3E ~                JP   C,__x80_mcpyn_pairs ; below: forwards; the same place, down as well as any
 6237 2C3E ~                ENDIF
