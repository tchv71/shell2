 1688 2ABB ~                ; one to three places down: nothing falls off the zero byte L
 1689 2ABB ~                LD   B,A
 1690 2ABB ~            .down1:
 1691 2ABB ~                XOR  A
 1692 2ABB ~                OR   D
 1693 2ABB ~                RRA
 1694 2ABB ~                LD   D,A
 1695 2ABB ~                LD   A,E
 1696 2ABB ~                RRA
 1697 2ABB ~                LD   E,A
 1698 2ABB ~                LD   A,H
 1699 2ABB ~                RRA
