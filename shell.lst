 6294 2C3E ~                IFUSED __x80_mmoves
 6295 2C3E ~            ; -mstack-copy, memmove upwards: the destination d below the source s by g = s - d, X80_SP_RESERVE
 6296 2C3E ~            ; or more, n at least X80_SP_RESERVE + 32. The first X80_SP_RESERVE to + 15 bytes the ordinary way;
 6297 2C3E ~            ; then SP the source's pointer, up from where they ended, HL the destination's, two bytes a POP --
 6298 2C3E ~            ; 34 T-states a pair, sixteen bytes a trip -- as far as the destination's end, d + n; then the last
 6299 2C3E ~            ; g bytes the ordinary way. Below SP is then always source already read that is destination not
 6300 2C3E ~            ; yet written: what an interrupt pushes lands there and is written over. Past d + n the source is
 6301 2C3E ~            ; the caller's still, and no interrupt may write it (ivagor, zx-pk.ru): there SP does not go. With
 6302 2C3E ~            ; fewer than X80_SP_RESERVE + 32 bytes up to there, all of it the ordinary way; apart, as memcpy.
 6303 2C3E ~            __x80_mmoves:
 6304 2C3E ~                PUSH HL                 ; d, given back
 6305 2C3E ~                ADD  HL,BC
 6306 2C3E ~                LD   A,L
 6307 2C3E ~                SUB  E
 6308 2C3E ~                LD   L,A
 6309 2C3E ~                LD   A,H
 6310 2C3E ~                SBC  A,D
 6311 2C3E ~                LD   H,A                ; d + n - s = n - g, the bytes up to the destination's end
 6312 2C3E ~                JP   C,.apart           ; apart: memcpy's way
 6313 2C3E ~                JP   NZ,.long
 6314 2C3E ~                LD   A,L
 6315 2C3E ~                CP   X80_SP_RESERVE + 32
 6316 2C3E ~                JP   C,.plain
 6317 2C3E ~            .long:
 6318 2C3E ~                LD   B,H
 6319 2C3E ~                LD   C,L                ; n - g
 6320 2C3E ~                POP  HL
 6321 2C3E ~                PUSH HL                 ; d
 6322 2C3E ~                LD   A,E
 6323 2C3E ~                SUB  L
 6324 2C3E ~                LD   L,A
 6325 2C3E ~                LD   A,D
 6326 2C3E ~                SBC  A,H
 6327 2C3E ~                LD   H,A                ; g
 6328 2C3E ~                EX   (SP),HL            ; g kept, HL = d
 6329 2C3E ~                PUSH HL                 ; d on it
 6330 2C3E ~                CALL __x80_sp_trips     ; BC the trips, A the first bytes
 6331 2C3E ~                PUSH BC
 6332 2C3E ~                LD   C,A
 6333 2C3E ~                LD   B,0
 6334 2C3E ~                PUSH BC
 6335 2C3E ~                CALL __x80_mcpyn_pairs  ; the first bytes: HL = d again, DE = s past them
 6336 2C3E ~                POP  BC
 6337 2C3E ~                ADD  HL,BC              ; the destination past them
 6338 2C3E ~                POP  BC
 6339 2C3E ~                EX   DE,HL              ; HL the source, DE the destination
 6340 2C3E ~                PUSH HL
 6341 2C3E ~                LD   HL,2
 6342 2C3E ~                ADD  HL,SP
 6343 2C3E ~                LD   (__x80_sp_save),HL ; SP with d and g on it
 6344 2C3E ~                POP  HL
 6345 2C3E ~                LD   SP,HL
 6346 2C3E ~                EX   DE,HL
 6347 2C3E ~            .up:
 6348 2C3E ~                POP  DE
