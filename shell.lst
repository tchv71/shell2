 5011 2BB0 ~                EX   (SP),HL            ; HL = the low product's low word; the high one's kept
 5012 2BB0 ~                ADD  A,H
 5013 2BB0 ~                LD   H,A                ; the second byte: the low product's and the high one's first
 5014 2BB0 ~                EX   (SP),HL            ; HL = the high product's low word; the result's kept
 5015 2BB0 ~                LD   A,E
