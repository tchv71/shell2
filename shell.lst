 3972 2ABA                  IFUSED __x80_lmul
 3973 2ABA ~
 3974 2ABA ~            ; ---------------------------------------------------------------------------
 3975 2ABA ~            ; DE:HL = DE:HL * [SP+2]:BC, the low thirty-two bits.
 3976 2ABA ~            ;
 3977 2ABA ~            ; By halves, since only the low thirty-two bits of the product are wanted:
 3978 2ABA ~            ;
 3979 2ABA ~            ;     a * b = aL*bL + ((aH*bL + aL*bH) << 16)      modulo 2^32
 3980 2ABA ~            ;
 3981 2ABA ~            ; which is one sixteen-by-sixteen multiplication with a thirty-two-bit result, the smaller low
 3982 2ABA ~            ; half the multiplier, and two with a sixteen-bit one -- a high half that is zero, as it is
 3983 2ABA ~            ; whenever a `long` holds an unsigned int's worth, dropping its term altogether, and one that is
 3984 2ABA ~            ; FFFFh, a negative int's, making it a subtraction. z88dk's runtime does the same (l_long_mult).
 3985 2ABA ~            ; The halves wait in rt_a and rt_b, as division's do.
 3986 2ABA ~            ; ---------------------------------------------------------------------------
 3987 2ABA ~            __x80_lmul:
