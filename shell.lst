 4122 2ABB ~            ; ---------------------------------------------------------------------------
 4123 2ABB ~            ; DE:HL shifted right by C, 1 to 31, with B -- 00h or the sign's FFh -- coming in at the top: both
 4124 2ABB ~            ; right shifts of a long. Eight places at a time by moving the bytes, B the new top one, worked out
 4125 2ABB ~            ; once rather than at each byte. What is left, 1 to 7 places: 1 to 3 a bit a step, the top bit
 4126 2ABB ~            ; from B's; 4 to 7 as 8 - n steps to the left with B as a fifth byte above D, and the bytes moved
 4127 2ABB ~            ; down by one -- 67 T-states a step against 107 to the right (ivagor's way for a word,
 4128 2ABB ~            ; zx-pk.ru #77, and his two ways in for the sign, #92: here one way in, the sign held in B).
 4129 2ABB ~            ; ---------------------------------------------------------------------------
 4130 2ABB ~            __x80_shr32:
 4131 2ABB ~            .bytes:
 4132 2ABB ~                LD   A,C
 4133 2ABB ~                SUB  8
 4134 2ABB ~                JP   C,.bits
 4135 2ABB ~                LD   C,A
 4136 2ABB ~            .move:
 4137 2ABB ~                LD   L,H
 4138 2ABB ~                LD   H,E
 4139 2ABB ~                LD   E,D
 4140 2ABB ~                LD   D,B
 4141 2ABB ~                JP   NZ,.bytes          ; the flags of the SUB, or of .left's last DEC C
 4142 2ABB ~                RET
 4143 2ABB ~            .bits:
 4144 2ABB ~                CP   0FCh               ; A is the count less 8: 4 to 7 places are FCh to FFh
 4145 2ABB ~                JP   NC,.left
 4146 2ABB ~            .right:
 4147 2ABB ~                LD   A,B
 4148 2ABB ~                RLA                     ; B's bit into the carry, to come in at the top
 4149 2ABB ~                LD   A,D
 4150 2ABB ~                RRA
 4151 2ABB ~                LD   D,A
 4152 2ABB ~                CALL __x80_rr3
 4153 2ABB ~                DEC  C
 4154 2ABB ~                JP   NZ,.right
 4155 2ABB ~                RET
