 3586 2ABA ~                LD   A,(__x80_qa+7)     ; the remainder takes the sign of the dividend
 3587 2ABA ~                CALL __x80_q_signed
 3588 2ABA ~                LD   HL,__x80_qr
 3589 2ABA ~                CALL Z,__x80_q_negate
 3590 2ABA ~                LD   HL,__x80_qr
 3591 2ABA ~                JP   __x80_q_give
 3592 2ABA                  ENDIF
