 8355 2C46              ;@shared
 8356 2C46                  IFNDEF X80_EXIT_DEFINED
 8357 2C46                  IFUSED __x80_exit
 8358 2C46 ~            ; ---------------------------------------------------------------------------
 8359 2C46 ~            ; How a program ends when it calls exit, _Exit or abort, the status in HL. On
 8360 2C46 ~            ; the machine there is nobody to tell, so it halts; a test platform defines
 8361 2C46 ~            ; __x80_exit itself, before this file, with DEFINE X80_EXIT_DEFINED -- IFNDEF
 8362 2C46 ~            ; tests DEFINEs, not labels -- and reports the status instead
 8363 2C46 ~            ; (lib/crt/test_start.asm).
 8364 2C46 ~            ; ---------------------------------------------------------------------------
 8365 2C46 ~            __x80_exit:
 8366 2C46 ~                JP   __x80_halt
 8367 2C46                  ENDIF
 8368 2C46                  ENDIF
