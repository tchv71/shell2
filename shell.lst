 2093 2ABB ~            .exact:
 2094 2ABB ~                LD   A,C
 2095 2ABB ~                SUB  126
 2096 2ABB ~                LD   C,A
 2097 2ABB ~                JP   NC,__x80_fp_rpack
 2098 2ABB ~                DEC  B
 2099 2ABB ~                JP   __x80_fp_rpack
 2100 2ABB ~                ELSE
 2101 2ABB ~                LD   A,C
 2102 2ABB ~                SUB  126
