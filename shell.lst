 5450 2BEC ~                ADD  HL,BC          ; the remainder as it is
 5451 2BEC ~                EX   DE,HL
 5452 2BEC ~                LD   L,H
 5453 2BEC ~                LD   H,0
 5454 2BEC ~                RET
 5455 2BEC ~            .up:
 5456 2BEC ~                INC  D
 5457 2BEC ~                EX   DE,HL
 5458 2BEC ~                LD   L,H
 5459 2BEC ~                LD   H,0
