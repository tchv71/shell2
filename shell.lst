 8561 2C44              ; The Вектор-06Ц's frame hook, vc_on_frame, which its board support package's interrupt handler
 8562 2C44              ; calls (lib/bsp/vector06c.c): nothing, unless the program defines its own. The compiler marks
 8563 2C44              ; every definition it writes with DEFINE __X80_DEF_name -- the way the C library gives way to the
 8564 2C44              ; program -- and this file is assembled after the program, so the mark has been seen. Here and not
 8565 2C44              ; in the Вектор's startup code because that is assembled first, before the mark.
 8566 2C44              ;@shared
 8567 2C44                  IFUSED _vc_on_frame
 8568 2C44 ~                IFNDEF __X80_DEF_vc_on_frame
 8569 2C44 ~            _vc_on_frame:
 8570 2C44 ~                RET
 8571 2C44 ~                ENDIF
 8572 2C44                  ENDIF
 8573 2C44              ;@end
 8574 2C44
 8575 2C44              ; A call through a pointer in an interrupt's code: a pointer is always the
 8576 2C44              ; program's function, and the copy of __x80_call_hl, __x80_call_bc or __x80_call_mem turns it into the
 8577 2C44              ; function's copy for interrupts before it calls. Each module that has functions whose address is
 8578 2C44              ; taken, and copies of them, writes a segment of pairs -- DEFW the function, its copy -- ended by
 8579 2C44              ; a zero word and preceded by the segment before it, __x80_xlat_head as it was; the last one is
 8580 2C44              ; __x80_xlat_last. Kept only when something calls through a pointer in an interrupt, and so
 8581 2C44              ; names __x80_xlat. HL the address, and the copy's back in it, or the address as it was -- a
 8582 2C44              ; function written in assembly, which has none; every other register kept.
 8583 2C44              ;@shared
 8584 2C44                  IFUSED __x80_xlat
 8585 2C44 ~            __x80_xlat:
 8586 2C44 ~                PUSH AF
 8587 2C44 ~                PUSH BC
 8588 2C44 ~                PUSH DE
 8589 2C44 ~                EX   DE,HL              ; DE the address
 8590 2C44 ~                LD   HL,__x80_xlat_last
 8591 2C44 ~            .segment:
 8592 2C44 ~                LD   A,H
 8593 2C44 ~                OR   L
 8594 2C44 ~                JP   Z,.done
 8595 2C44 ~                LD   C,(HL)
 8596 2C44 ~                INC  HL
 8597 2C44 ~                LD   B,(HL)             ; BC the segment before
 8598 2C44 ~                INC  HL
 8599 2C44 ~            .entry:
 8600 2C44 ~                LD   A,(HL)
 8601 2C44 ~                INC  HL
 8602 2C44 ~                OR   (HL)
 8603 2C44 ~                JP   Z,.end             ; the zero word
 8604 2C44 ~                DEC  HL
 8605 2C44 ~                LD   A,(HL)
 8606 2C44 ~                CP   E
 8607 2C44 ~                INC  HL
 8608 2C44 ~                JP   NZ,.skip
 8609 2C44 ~                LD   A,(HL)
 8610 2C44 ~                CP   D
 8611 2C44 ~                JP   Z,.found
 8612 2C44 ~            .skip:
 8613 2C44 ~                INC  HL
 8614 2C44 ~                INC  HL
 8615 2C44 ~                INC  HL
 8616 2C44 ~                JP   .entry
 8617 2C44 ~            .found:
 8618 2C44 ~                INC  HL
 8619 2C44 ~                LD   E,(HL)
 8620 2C44 ~                INC  HL
 8621 2C44 ~                LD   D,(HL)             ; DE the copy
 8622 2C44 ~                JP   .done
 8623 2C44 ~            .end:
 8624 2C44 ~                LD   H,B
 8625 2C44 ~                LD   L,C
 8626 2C44 ~                JP   .segment
 8627 2C44 ~            .done:
 8628 2C44 ~                EX   DE,HL
 8629 2C44 ~                POP  DE
 8630 2C44 ~                POP  BC
 8631 2C44 ~                POP  AF
 8632 2C44 ~                RET
 8633 2C44                  ENDIF
 8634 2C44              ;@end
 8635 2C44
 8636 2C44              ; The library's critical sections (lib/libc/critical.h), in a program whose interrupt handlers call
 8637 2C44              ; the library: __x80_busy counts the sections the program is in, and an interrupt's entry that
 8638 2C44              ; finds it set leaves its address in __x80_pending and returns at once. The end of the outermost
 8639 2C44              ; section calls __x80_run_deferred, which runs that entry as the interrupt would have: interrupts
 8640 2C44              ; off, and on again after -- they were on, or it would not have come, and the program has been in
 8641 2C44              ; the library since. Every register kept.
 8642 2C44              ;@shared
 8643 2C44                  IFUSED __x80_busy
 8644 2C44 ~            __x80_bss_off = __x80_bss_off + 1
 8645 2C44 ~            __x80_busy EQU __x80_bss_top - __x80_bss_off
 8646 2C44                  ENDIF
 8647 2C44                  IFUSED __x80_pending
 8648 2C44 ~            __x80_bss_off = __x80_bss_off + 2
 8649 2C44 ~            __x80_pending EQU __x80_bss_top - __x80_bss_off
 8650 2C44                  ENDIF
 8651 2C44                  IFUSED __x80_run_deferred
 8652 2C44 ~            __x80_run_deferred:
 8653 2C44 ~                PUSH AF
 8654 2C44 ~                PUSH HL
 8655 2C44 ~                LD   HL,(__x80_pending)
 8656 2C44 ~                LD   A,H
 8657 2C44 ~                OR   L
 8658 2C44 ~                JP   Z,.done
 8659 2C44 ~                PUSH BC
 8660 2C44 ~                PUSH DE
 8661 2C44 ~                PUSH HL
 8662 2C44 ~                LD   HL,0
 8663 2C44 ~                LD   (__x80_pending),HL
 8664 2C44 ~                POP  HL
 8665 2C44 ~                DI
 8666 2C44 ~                CALL .go
 8667 2C44 ~                EI
 8668 2C44 ~                POP  DE
 8669 2C44 ~                POP  BC
 8670 2C44 ~            .done:
 8671 2C44 ~                POP  HL
 8672 2C44 ~                POP  AF
 8673 2C44 ~                RET
 8674 2C44 ~            .go:
 8675 2C44 ~                JP   (HL)
 8676 2C44                  ENDIF
 8677 2C44              ;@end
 8678 2C44
 8679 2C44              ; The end of everything assembled, and so of the image: the C library's heap starts here. And
 8680 2C44              ; how much the objects the program starts with zeroed take: they are not in the image but at the
 8681 2C44              ; top of memory, each file handing out addresses down from __x80_bss_top as it defines them
 8682 2C44              ; and the startup code clears them and puts the stack below them. Last in the
 8683 2C44              ; file, and this file last on the assembler's command line.
 8684 2C44              ;@shared
 8685 2C44                  IFUSED __x80_xlat
 8686 2C44 ~            __x80_xlat_last EQU __x80_xlat_head
 8687 2C44                  ENDIF
 8688 2C44              __x80_bss_size EQU __x80_bss_off
 8689 2C44                  ; --target=bin --no-startup (lib/crt/bin_start.asm): no startup to clear them, so they are
 8690 2C44                  ; zeros in the image, here at its end, and __x80_bss_top is the end of these.
 8691 2C44                  IFDEF X80_BSS_IN_IMAGE
 8692 2C44              __x80_bss_image:
 8693 2C44                  IF __x80_bss_size
 8694 2C44 00 00 00...      DEFS __x80_bss_size
 8695 2FAE                  ENDIF
 8696 2FAE                  ENDIF
 8697 2FAE                  IFUSED __x80_heap
 8698 2FAE ~            __x80_heap:
 8699 2FAE                  ENDIF
 8700 2FAE              ;@end
 8701 2FAE
# file closed: runtime.asm
# file opened: runtime32.asm
    1 2FAE              ; runtime32.asm -- empty. The thirty-two-bit routines are in runtime.asm, with the sixteen-bit
    2 2FAE              ; ones they call, so that the assembler can leave out whatever a program does not use; see the
    3 2FAE              ; comment at the top of that file. Kept so that command lines naming it still work.
    4 2FAE
# file closed: runtime32.asm
