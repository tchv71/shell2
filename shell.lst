 1681 2ABB ~                LD   A,D
 1682 2ABB ~                RLA
 1683 2ABB ~                LD   D,A
 1684 2ABB ~                DEC  B
 1685 2ABB ~                JP   NZ,.up
 1686 2ABB ~                JP   .together
