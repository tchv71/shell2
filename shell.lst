 8459 2C68 ~            __x80_fpx EQU __x80_bss_top - __x80_bss_off      ; a flip of b's sign, a subtraction, a quotient byte
 8460 2C68                  ENDIF
 8461 2C68
 8462 2C68                  IFUSED __x80_fpe
 8463 2C68 ~            __x80_bss_off = __x80_bss_off + 1
