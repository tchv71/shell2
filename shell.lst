 6120 2C1C ~                LD   A,H
 6121 2C1C ~                RLA
 6122 2C1C ~                SBC  A,A
 6123 2C1C ~                LD   H,A                ; the sign's byte above
 6124 2C1C ~                LD   A,B
 6125 2C1C ~                SUB  8
 6126 2C1C ~                RET  Z
 6127 2C1C ~                CP   8
 6128 2C1C ~                JP   NC,.all
 6129 2C1C ~                LD   B,A
 6130 2C1C ~                LD   A,L
 6131 2C1C ~            .byte:
 6132 2C1C ~                RLCA                    ; the byte's sign into the carry,
 6133 2C1C ~                RRCA                    ; the byte as it was,
 6134 2C1C ~                RRA                     ; and shifted with the sign: the byte stays in A, 27 T-states a step
 6135 2C1C ~                DEC  B
 6136 2C1C ~                JP   NZ,.byte
 6137 2C1C ~                LD   L,A
 6138 2C1C ~                RET
 6139 2C1C ~            .all:
 6140 2C1C ~                LD   L,H
 6141 2C1C ~                RET
