 4157 2ABB ~                LD   A,8
 4158 2ABB ~                SUB  C
 4159 2ABB ~                LD   C,A                ; 1 to 4 steps
 4160 2ABB ~            .left_loop:
 4161 2ABB ~                ADD  HL,HL
 4162 2ABB ~                LD   A,E
 4163 2ABB ~                RLA
 4164 2ABB ~                LD   E,A
 4165 2ABB ~                LD   A,D
 4166 2ABB ~                RLA
 4167 2ABB ~                LD   D,A
 4168 2ABB ~                LD   A,B
 4169 2ABB ~                RLA
 4170 2ABB ~                LD   B,A
 4171 2ABB ~                DEC  C
 4172 2ABB ~                JP   NZ,.left_loop
