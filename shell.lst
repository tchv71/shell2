 4265 2AC5                  IFUSED __x80_div_args
 4266 2AC5
 4267 2AC5              ; rt_a = DE:HL, rt_b = [SP+4]:BC -- the stack argument is two return addresses up.
 4268 2AC5              __x80_div_args:
 4269 2AC5 22 4E 2C         LD   (__x80_rt_a),HL
 4270 2AC8 EB               EX   DE,HL
 4271 2AC9 22 50 2C         LD   (__x80_rt_a+2),HL
 4272 2ACC 60               LD   H,B
 4273 2ACD 69               LD   L,C
 4274 2ACE 22 4A 2C         LD   (__x80_rt_b),HL
 4275 2AD1 21 04 00         LD   HL,4
 4276 2AD4 39               ADD  HL,SP
 4277 2AD5 7E               LD   A,(HL)
 4278 2AD6 23               INC  HL
 4279 2AD7 66               LD   H,(HL)
 4280 2AD8 6F               LD   L,A
 4281 2AD9 22 4C 2C         LD   (__x80_rt_b+2),HL
 4282 2ADC C9               RET
 4283 2ADD                  ENDIF
 4284 2ADD
 4285 2ADD                  IFUSED __x80_signed_divide
 4286 2ADD ~
 4287 2ADD ~            ; Divides the magnitudes, with the sign the result should have in bit 7 of A on entry; returns
 4288 2ADD ~            ; with Z clear when the result is to stay as it is and Z set when it is to be negated.
 4289 2ADD ~            __x80_signed_divide:
 4290 2ADD ~                AND  80H
 4291 2ADD ~                LD   (__x80_rt_sign),A
 4292 2ADD ~                LD   HL,__x80_rt_a
 4293 2ADD ~                CALL __x80_abs32
 4294 2ADD ~                LD   HL,__x80_rt_b
 4295 2ADD ~                CALL __x80_abs32
 4296 2ADD ~                CALL __x80_divide
 4297 2ADD ~                LD   A,(__x80_rt_sign)
 4298 2ADD ~                CP   80H
 4299 2ADD ~                RET
 4300 2ADD                  ENDIF
