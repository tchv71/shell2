 5309 2BAE              ; ---------------------------------------------------------------------------
 5310 2BAE              ; HL = HL % DE, unsigned.
 5311 2BAE              ; ---------------------------------------------------------------------------
 5312 2BAE              __x80_urem16:
 5313 2BAE CD B4 2B         CALL __x80_udiv16
 5314 2BB1 62               LD   H,D
 5315 2BB2 6B               LD   L,E
 5316 2BB3 C9               RET
 5317 2BB4                  ENDIF
