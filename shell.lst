 6080 2C1C ~            ; As the logical shift, the sign coming in at the top: a whole byte of it for eight or more, and
 6081 2C1C ~            ; for four to seven the shift left starts with the sign's byte in A.
 6082 2C1C ~            __x80_ashr16:
 6083 2C1C ~                XOR  A
 6084 2C1C ~                OR   E
 6085 2C1C ~                RET  Z
 6086 2C1C ~                LD   B,A
