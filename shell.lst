 8503 2C44              ;@shared
 8504 2C44              ; main's argv: no arguments, so argv[0], which is argv[argc], is the null pointer.
 8505 2C44                  IFUSED __x80_argv
 8506 2C44 ~            __x80_argv: DEFW 0
 8507 2C44                  ENDIF
