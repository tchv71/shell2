 1513 2ABC ~                JP   NZ,.fast_a
 1514 2ABC ~                PUSH HL
 1515 2ABC ~                LD   HL,__x80_fpb+1
 1516 2ABC ~                LD   A,(__x80_fpa+1)
 1517 2ABC ~                CP   (HL)
 1518 2ABC ~                JP   NZ,.fast_cmp
 1519 2ABC ~                DEC  HL
 1520 2ABC ~                LD   A,(__x80_fpa)
 1521 2ABC ~                CP   (HL)
