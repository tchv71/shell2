 2691 2ABB                  IFUSED __x80_fp_expn
 2692 2ABB ~            ; A = the exponent of the float whose top byte is at HL; carry set if it is 0 or 255 -- a zero or a
 2693 2ABB ~            ; subnormal, an infinity or a NaN -- and clear for a normal number. HL is left as it was.
 2694 2ABB ~            __x80_fp_expn:
 2695 2ABB ~                DEC  HL
 2696 2ABB ~                LD   A,(HL)
 2697 2ABB ~                RLA                     ; the exponent's last bit
 2698 2ABB ~                INC  HL
 2699 2ABB ~                LD   A,(HL)
 2700 2ABB ~                RLA
 2701 2ABB ~                INC  A
 2702 2ABB ~                CP   2
 2703 2ABB ~                DEC  A                  ; DEC leaves the carry
 2704 2ABB ~                RET
 2705 2ABB                  ENDIF
 2706 2ABB
 2707 2ABB                  IFUSED __x80_fp_fast2
 2708 2ABB ~            ; ---------------------------------------------------------------------------
 2709 2ABB ~            ; A product's or a quotient's operands, when both are normal numbers -- the common case, for
 2710 2ABB ~            ; which the general path's tests for NaNs, infinities, zeros and subnormals and its normalisation
 2711 2ABB ~            ; are all for nothing. Carry set if fpa or fpb is not one (an exponent field of 0 or 255), and
 2712 2ABB ~            ; then nothing is changed but fps, which the general path sets again. Otherwise, as that path
 2713 2ABB ~            ; would leave them: fps = the result's sign; the leading ones put into the significands, the low
 2714 2ABB ~            ; three bytes of fpa and fpb (__x80_fp_unpack); HL = a's exponent, BC = b's; D = b's top byte.
 2715 2ABB ~            ; ---------------------------------------------------------------------------
 2716 2ABB ~            __x80_fp_fast2:
 2717 2ABB ~                LD   HL,__x80_fpb+3
 2718 2ABB ~                LD   E,(HL)             ; b's sign and exponent but its last bit
 2719 2ABB ~                DEC  HL
 2720 2ABB ~                LD   D,(HL)             ; that bit and the significand's top seven
 2721 2ABB ~                LD   A,D
 2722 2ABB ~                RLA
 2723 2ABB ~                LD   A,E
 2724 2ABB ~                RLA                     ; b's exponent
 2725 2ABB ~                INC  A
 2726 2ABB ~                CP   2                  ; 0 or 255: the carry
 2727 2ABB ~                RET  C
 2728 2ABB ~                DEC  A
 2729 2ABB ~                LD   C,A
 2730 2ABB ~                LD   HL,__x80_fpa+3
 2731 2ABB ~                LD   A,(HL)
 2732 2ABB ~                XOR  E
 2733 2ABB ~                AND  80H
 2734 2ABB ~                LD   (__x80_fps),A      ; the signs'
 2735 2ABB ~                LD   E,(HL)
 2736 2ABB ~                DEC  HL
 2737 2ABB ~                LD   A,(HL)
 2738 2ABB ~                RLA
 2739 2ABB ~                LD   A,E
 2740 2ABB ~                RLA                     ; a's exponent
 2741 2ABB ~                INC  A
 2742 2ABB ~                CP   2
 2743 2ABB ~                RET  C
 2744 2ABB ~                DEC  A
 2745 2ABB ~                LD   E,A
 2746 2ABB ~                LD   A,(HL)
 2747 2ABB ~                OR   80H
 2748 2ABB ~                LD   (HL),A             ; a's leading one
 2749 2ABB ~                LD   A,D
 2750 2ABB ~                OR   80H
 2751 2ABB ~                LD   D,A
 2752 2ABB ~                LD   (__x80_fpb+2),A    ; b's
 2753 2ABB ~                LD   L,E
 2754 2ABB ~                XOR  A                  ; and the carry clear
 2755 2ABB ~                LD   H,A
 2756 2ABB ~                LD   B,A
 2757 2ABB ~                RET
 2758 2ABB                  ENDIF
