 1895 2ABB                  IFUSED __x80_fmul
 1896 2ABB ~            ; ---------------------------------------------------------------------------
 1897 2ABB ~            ; DE:HL = a * b. The product of the twenty-four-bit significands, a2 a1 a0 by b2 b1 b0, forty-eight
 1898 2ABB ~            ; bits, bytes 5 to 0, is made of five of __x80_mul8w's, a byte by a word: a0, a1 and a2 by b's low
 1899 2ABB ~            ; word, b2 by a's, and a2 by b2, each added in where it belongs as it comes, in registers. Its top
 1900 2ABB ~            ; thirty-two bits are the result's significand, bytes 1 and 0 only its sticky bit -- after a shift
 1901 2ABB ~            ; by one when the leading one is at bit 46 rather than 47. A product with a zero byte or word is
 1902 2ABB ~            ; zero and not made: a number with a short significand -- 4.0, 10.0, 0.5, most constants -- needs
 1903 2ABB ~            ; two of the five or three.
 1904 2ABB ~            ; ---------------------------------------------------------------------------
 1905 2ABB ~            __x80_fmul:
 1906 2ABB ~                IFDEF X80_OPT_SIZE
 1907 2ABB ~                CALL __x80_fp_load2
 1908 2ABB ~                CALL __x80_fp_fast2     ; two normal numbers: straight to the product
 1909 2ABB ~                JP   NC,.normal
 1910 2ABB ~                ELSE
 1911 2ABB ~                ; Two normal numbers, as __x80_fadd takes them: the low words to fpa and fpb, the high words
 1912 2ABB ~                ; read where they come, the leading ones put in and the exponents' sum made in registers.
 1913 2ABB ~                ; Anything else goes the general way, everything stored as __x80_fp_load2 would have.
 1914 2ABB ~                LD   (__x80_fpa),HL
 1915 2ABB ~                LD   H,B
 1916 2ABB ~                LD   L,C
 1917 2ABB ~                LD   (__x80_fpb),HL
 1918 2ABB ~                LD   HL,2
 1919 2ABB ~                ADD  HL,SP
 1920 2ABB ~                LD   A,(HL)
 1921 2ABB ~                INC  HL
 1922 2ABB ~                LD   H,(HL)
 1923 2ABB ~                LD   L,A                ; b's high word
 1924 2ABB ~                LD   A,E
 1925 2ABB ~                ADD  A,A
 1926 2ABB ~                LD   A,D
 1927 2ABB ~                ADC  A,A
 1928 2ABB ~                LD   C,A                ; a's exponent field
 1929 2ABB ~                INC  A
 1930 2ABB ~                CP   2
 1931 2ABB ~                JP   C,.slow            ; 0 or 255
 1932 2ABB ~                LD   A,L
 1933 2ABB ~                ADD  A,A
 1934 2ABB ~                LD   A,H
 1935 2ABB ~                ADC  A,A
 1936 2ABB ~                LD   B,A                ; b's
 1937 2ABB ~                INC  A
 1938 2ABB ~                CP   2
 1939 2ABB ~                JP   C,.slow
 1940 2ABB ~                LD   A,D
 1941 2ABB ~                XOR  H
 1942 2ABB ~                AND  80H
 1943 2ABB ~                LD   (__x80_fps),A      ; the signs'
 1944 2ABB ~                LD   A,E
 1945 2ABB ~                OR   80H
 1946 2ABB ~                LD   (__x80_fpa+2),A
 1947 2ABB ~                LD   A,L
 1948 2ABB ~                OR   80H
 1949 2ABB ~                LD   (__x80_fpb+2),A
 1950 2ABB ~                LD   L,C
 1951 2ABB ~                LD   C,B
 1952 2ABB ~                XOR  A
 1953 2ABB ~                LD   H,A
 1954 2ABB ~                LD   B,A
 1955 2ABB ~                JP   .normal
 1956 2ABB ~            .slow:
 1957 2ABB ~                LD   (__x80_fpb+2),HL   ; as __x80_fp_load2 leaves them
 1958 2ABB ~                EX   DE,HL
 1959 2ABB ~                LD   (__x80_fpa+2),HL
 1960 2ABB ~                ENDIF
