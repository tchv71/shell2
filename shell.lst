 5964 2C1B                  IFUSED __x80_shl16
 5965 2C1B ~
 5966 2C1B ~            ; ---------------------------------------------------------------------------
 5967 2C1B ~            ; HL = HL shifted by E, the three shifts. A count of sixteen or more is undefined
 5968 2C1B ~            ; in C (6.5.7p3), and what happens here for one from 16 to 255 is that the value
 5969 2C1B ~            ; ends up zero (or all sign bits), which is the same answer the constant case
 5970 2C1B ~            ; gives. D, the count's high byte, is not read: a count that needs it is one of
 5971 2C1B ~            ; those, and testing it would cost every call (ivagor, zx-pk.ru). The count is tested with
 5972 2C1B ~            ; XOR A / OR E rather than LD A,E / OR A: a T-state less on the 8080, four on the
 5973 2C1B ~            ; Vector, which rounds every instruction up to four.
 5974 2C1B ~            ;
 5975 2C1B ~            ; Called only when the count is not known at translation time -- the optimising
 5976 2C1B ~            ; selector expands a constant shift inline, which for the one and two the
 5977 2C1B ~            ; language's own idioms produce is a single instruction. So the cost that matters
 5978 2C1B ~            ; here is the per-bit cost, not the call overhead.
 5979 2C1B ~            ; ---------------------------------------------------------------------------
 5980 2C1B ~            __x80_shl16:
 5981 2C1B ~                XOR  A
 5982 2C1B ~                OR   E
 5983 2C1B ~                RET  Z
 5984 2C1B ~                CP   8
 5985 2C1B ~                JP   NC,.bytes
 5986 2C1B ~            .loop:
 5987 2C1B ~                ADD  HL,HL
 5988 2C1B ~                DEC  A
 5989 2C1B ~                JP   NZ,.loop
 5990 2C1B ~                RET
 5991 2C1B ~            ; Eight or more: the low byte up a whole byte, then the rest of the count on it alone.
 5992 2C1B ~            .bytes:
 5993 2C1B ~                LD   H,L
 5994 2C1B ~                LD   L,0
 5995 2C1B ~                SUB  8
 5996 2C1B ~                RET  Z
 5997 2C1B ~                CP   8
 5998 2C1B ~                JP   NC,.zero
 5999 2C1B ~                LD   B,A
 6000 2C1B ~                LD   A,H
 6001 2C1B ~            .byte:
 6002 2C1B ~                ADD  A,A
 6003 2C1B ~                DEC  B
 6004 2C1B ~                JP   NZ,.byte
 6005 2C1B ~                LD   H,A
 6006 2C1B ~                RET
 6007 2C1B ~            .zero:
 6008 2C1B ~                LD   H,L
 6009 2C1B ~                RET
 6010 2C1B                  ENDIF
 6011 2C1B
 6012 2C1B                  IFUSED __x80_lshr16
 6013 2C1B ~
 6014 2C1B ~            ; The right shifts take the shortest of three ways: a byte at once for a
 6015 2C1B ~            ; count of eight or more, and then the one byte that is left; the low byte alone when the high one
 6016 2C1B ~            ; is zero; and for a count of four to seven, a shift left by eight less the count through A, whose
 6017 2C1B ~            ; top two bytes are the answer -- ADD HL,HL / RLA, 29 T-states a step against 46 to the right.
 6018 2C1B ~            ; The long counts are tested first: they are what a decoder's bit reader shifts by, and where
 6019 2C1B ~            ; the time goes.
 6020 2C1B ~            __x80_lshr16:
 6021 2C1B ~                XOR  A
 6022 2C1B ~                OR   E
 6023 2C1B ~                RET  Z
 6024 2C1B ~                CP   8
 6025 2C1B ~                JP   NC,.bytes
 6026 2C1B ~                LD   B,A
 6027 2C1B ~                INC  H                  ; the high byte zero: A kept (ivagor, zx-pk.ru)
 6028 2C1B ~                DEC  H
 6029 2C1B ~                JP   Z,.low
 6030 2C1B ~                CP   4
 6031 2C1B ~                JP   NC,.left
 6032 2C1B ~            .loop:
 6033 2C1B ~                XOR  A
 6034 2C1B ~                OR   H                  ; and the carry clear, so a zero comes in at the top
 6035 2C1B ~                RRA
 6036 2C1B ~                LD   H,A
 6037 2C1B ~                LD   A,L
 6038 2C1B ~                RRA
 6039 2C1B ~                LD   L,A
 6040 2C1B ~                DEC  B
 6041 2C1B ~                JP   NZ,.loop
 6042 2C1B ~                RET
 6043 2C1B ~            .left:
 6044 2C1B ~                LD   A,8
 6045 2C1B ~                SUB  B
 6046 2C1B ~                LD   B,A
 6047 2C1B ~                XOR  A
 6048 2C1B ~            .left_loop:
 6049 2C1B ~                ADD  HL,HL
 6050 2C1B ~                RLA
 6051 2C1B ~                DEC  B
 6052 2C1B ~                JP   NZ,.left_loop
 6053 2C1B ~                LD   L,H
 6054 2C1B ~                LD   H,A
 6055 2C1B ~                RET
 6056 2C1B ~            .bytes:
 6057 2C1B ~                LD   L,H
 6058 2C1B ~                LD   H,0
 6059 2C1B ~                SUB  8
 6060 2C1B ~                RET  Z
 6061 2C1B ~                CP   8
 6062 2C1B ~                JP   NC,.zero
 6063 2C1B ~                LD   B,A
 6064 2C1B ~            .low:
 6065 2C1B ~                LD   A,L
 6066 2C1B ~            .byte:
 6067 2C1B ~                OR   A
 6068 2C1B ~                RRA
 6069 2C1B ~                DEC  B
 6070 2C1B ~                JP   NZ,.byte
 6071 2C1B ~                LD   L,A
 6072 2C1B ~                RET
 6073 2C1B ~            .zero:
 6074 2C1B ~                LD   L,H
 6075 2C1B ~                RET
 6076 2C1B                  ENDIF
 6077 2C1B
 6078 2C1B                  IFUSED __x80_ashr16
 6079 2C1B ~
 6080 2C1B ~            ; As the logical shift, the sign coming in at the top: a whole byte of it for eight or more, and
 6081 2C1B ~            ; for four to seven the shift left starts with the sign's byte in A.
 6082 2C1B ~            __x80_ashr16:
 6083 2C1B ~                XOR  A
 6084 2C1B ~                OR   E
 6085 2C1B ~                RET  Z
 6086 2C1B ~                LD   B,A
 6087 2C1B ~                CP   8
 6088 2C1B ~                JP   NC,.bytes
 6089 2C1B ~                CP   4
 6090 2C1B ~                JP   NC,.left
 6091 2C1B ~            .loop:
 6092 2C1B ~                LD   A,H
 6093 2C1B ~                RLCA                    ; the sign into the carry
 6094 2C1B ~                RRCA                    ; H as it was, a T-state less than LD A,H again
 6095 2C1B ~                RRA                     ; and the sign back into the top bit, so it replaces itself
 6096 2C1B ~                LD   H,A
 6097 2C1B ~                LD   A,L
 6098 2C1B ~                RRA
 6099 2C1B ~                LD   L,A
 6100 2C1B ~                DEC  B
 6101 2C1B ~                JP   NZ,.loop
 6102 2C1B ~                RET
 6103 2C1B ~            .left:
 6104 2C1B ~                LD   A,8
 6105 2C1B ~                SUB  B
 6106 2C1B ~                LD   B,A
 6107 2C1B ~                LD   A,H
 6108 2C1B ~                RLA
 6109 2C1B ~                SBC  A,A                ; the sign's byte, 00h or FFh
 6110 2C1B ~            .left_loop:
 6111 2C1B ~                ADD  HL,HL
 6112 2C1B ~                RLA
 6113 2C1B ~                DEC  B
 6114 2C1B ~                JP   NZ,.left_loop
 6115 2C1B ~                LD   L,H
 6116 2C1B ~                LD   H,A
 6117 2C1B ~                RET
 6118 2C1B ~            .bytes:
 6119 2C1B ~                LD   L,H
 6120 2C1B ~                LD   A,H
 6121 2C1B ~                RLA
 6122 2C1B ~                SBC  A,A
 6123 2C1B ~                LD   H,A                ; the sign's byte above
 6124 2C1B ~                LD   A,B
 6125 2C1B ~                SUB  8
 6126 2C1B ~                RET  Z
 6127 2C1B ~                CP   8
 6128 2C1B ~                JP   NC,.all
 6129 2C1B ~                LD   B,A
 6130 2C1B ~                LD   A,L
 6131 2C1B ~            .byte:
 6132 2C1B ~                RLCA                    ; the byte's sign into the carry,
 6133 2C1B ~                RRCA                    ; the byte as it was,
 6134 2C1B ~                RRA                     ; and shifted with the sign: the byte stays in A, 27 T-states a step
 6135 2C1B ~                DEC  B
 6136 2C1B ~                JP   NZ,.byte
 6137 2C1B ~                LD   L,A
 6138 2C1B ~                RET
 6139 2C1B ~            .all:
 6140 2C1B ~                LD   L,H
 6141 2C1B ~                RET
 6142 2C1B                  ENDIF
