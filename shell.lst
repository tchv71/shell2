 5483 2C0E                  IFUSED __x80_dpass16
 5484 2C0E ~
 5485 2C0E ~            ; ---------------------------------------------------------------------------
 5486 2C0E ~            ; A byte of a quotient: blackmirror's division (zx-pk.ru, "Vychislenie chisla Pi na
 5487 2C0E ~            ; assemblere", 2016), as ivagor made it the 8080's.
 5488 2C0E ~            ;
 5489 2C0E ~            ; Non-restoring, and unrolled: the remainder doubled each step and the divisor added to it or
 5490 2C0E ~            ; taken from it -- added while the remainder is below zero, taken while it is not -- so that it
 5491 2C0E ~            ; stays within one divisor of zero, and the step's carry is the quotient's bit. The two cases are
 5492 2C0E ~            ; two chains of code, and a step goes from one to the other on its carry: no test of a sign, no
 5493 2C0E ~            ; restoring of a remainder that went below zero. Each step is ADC A,A / ADD HL,HL / ADD HL,rp / JP
 5494 2C0E ~            ; -- 34 T-states a bit, where a restoring step with the remainder in memory or on the stack was
 5495 2C0E ~            ; three or four times that. The carry, not the sign, tells which way the remainder went, which is
 5496 2C0E ~            ; what lets the divisor be anything below 32768: the doubled remainder may need seventeen bits,
 5497 2C0E ~            ; but the carry is the seventeenth.
 5498 2C0E ~            ;
 5499 2C0E ~            ; __x80_dpass16: a divisor B of 256..32767 in BC, -B in DE, and in HL a remainder R below B as
 5500 2C0E ~            ; the passes keep it, R - B. Returns the byte of R * 256 / B in A, and in HL (R * 256 % B) - B,
 5501 2C0E ~            ; to which the caller adds the next byte of the dividend: when that carries, the remainder has
 5502 2C0E ~            ; reached B again -- one more in the quotient, and B taken off once more.
 5503 2C0E ~            ; ---------------------------------------------------------------------------
 5504 2C0E ~            __x80_dpass16:
 5505 2C0E ~                ADD  HL,HL          ; bit 7, the remainder below zero
 5506 2C0E ~                ADD  HL,BC
 5507 2C0E ~                JP   C,.s6
 5508 2C0E ~            .a6:
 5509 2C0E ~                ADC  A,A
 5510 2C0E ~                ADD  HL,HL
 5511 2C0E ~                ADD  HL,BC
 5512 2C0E ~                JP   C,.s5
 5513 2C0E ~            .a5:
 5514 2C0E ~                ADC  A,A
 5515 2C0E ~                ADD  HL,HL
 5516 2C0E ~                ADD  HL,BC
 5517 2C0E ~                JP   C,.s4
 5518 2C0E ~            .a4:
 5519 2C0E ~                ADC  A,A
 5520 2C0E ~                ADD  HL,HL
 5521 2C0E ~                ADD  HL,BC
 5522 2C0E ~                JP   C,.s3
 5523 2C0E ~            .a3:
 5524 2C0E ~                ADC  A,A
 5525 2C0E ~                ADD  HL,HL
 5526 2C0E ~                ADD  HL,BC
 5527 2C0E ~                JP   C,.s2
 5528 2C0E ~            .a2:
 5529 2C0E ~                ADC  A,A
 5530 2C0E ~                ADD  HL,HL
 5531 2C0E ~                ADD  HL,BC
 5532 2C0E ~                JP   C,.s1
 5533 2C0E ~            .a1:
 5534 2C0E ~                ADC  A,A
 5535 2C0E ~                ADD  HL,HL
 5536 2C0E ~                ADD  HL,BC
 5537 2C0E ~                JP   C,.s0
 5538 2C0E ~            .a0:
 5539 2C0E ~                ADC  A,A
 5540 2C0E ~                ADD  HL,HL
 5541 2C0E ~                ADD  HL,BC
 5542 2C0E ~                JP   C,.se
 5543 2C0E ~            .ae:
 5544 2C0E ~                ADC  A,A            ; the last bit; the remainder already below zero
 5545 2C0E ~                RET
 5546 2C0E ~            .s6:
 5547 2C0E ~                ADC  A,A
 5548 2C0E ~                ADD  HL,HL
 5549 2C0E ~                ADD  HL,DE
 5550 2C0E ~                JP   NC,.a5
 5551 2C0E ~            .s5:
 5552 2C0E ~                ADC  A,A
 5553 2C0E ~                ADD  HL,HL
 5554 2C0E ~                ADD  HL,DE
 5555 2C0E ~                JP   NC,.a4
 5556 2C0E ~            .s4:
 5557 2C0E ~                ADC  A,A
 5558 2C0E ~                ADD  HL,HL
 5559 2C0E ~                ADD  HL,DE
 5560 2C0E ~                JP   NC,.a3
 5561 2C0E ~            .s3:
 5562 2C0E ~                ADC  A,A
 5563 2C0E ~                ADD  HL,HL
 5564 2C0E ~                ADD  HL,DE
 5565 2C0E ~                JP   NC,.a2
 5566 2C0E ~            .s2:
 5567 2C0E ~                ADC  A,A
 5568 2C0E ~                ADD  HL,HL
 5569 2C0E ~                ADD  HL,DE
 5570 2C0E ~                JP   NC,.a1
 5571 2C0E ~            .s1:
 5572 2C0E ~                ADC  A,A
 5573 2C0E ~                ADD  HL,HL
 5574 2C0E ~                ADD  HL,DE
 5575 2C0E ~                JP   NC,.a0
 5576 2C0E ~            .s0:
 5577 2C0E ~                ADC  A,A
 5578 2C0E ~                ADD  HL,HL
 5579 2C0E ~                ADD  HL,DE
 5580 2C0E ~                JP   NC,.ae
 5581 2C0E ~            .se:
 5582 2C0E ~                ADC  A,A            ; the last bit; the remainder made R - B, as the passes keep it
 5583 2C0E ~                ADD  HL,DE
 5584 2C0E ~                RET
 5585 2C0E                  ENDIF
