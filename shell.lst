 6144 2C1A                  IFUSED __x80_memcpy
 6145 2C1A ~
 6146 2C1A ~            ; ---------------------------------------------------------------------------
 6147 2C1A ~            ; HL = destination, DE = source, BC = count. The same direction and the same
 6148 2C1A ~            ; register convention as the reference generator's inline expansion, so that the
 6149 2C1A ~            ; two back ends agree about what a struct assignment does.
 6150 2C1A ~            ;
 6151 2C1A ~            ; A count of zero copies nothing: the test is at the top, unlike the inline
 6152 2C1A ~            ; version, because here the count can come from anywhere.
 6153 2C1A ~            ; ---------------------------------------------------------------------------
 6154 2C1A ~            __x80_memcpy:
 6155 2C1A ~                LD   A,B
 6156 2C1A ~                OR   C
 6157 2C1A ~                RET  Z
 6158 2C1A ~            __x80_memcpy_loop:
 6159 2C1A ~                LD   A,(DE)
 6160 2C1A ~                LD   (HL),A
 6161 2C1A ~                INC  DE
 6162 2C1A ~                INC  HL
 6163 2C1A ~                DEC  BC
 6164 2C1A ~                LD   A,B
 6165 2C1A ~                OR   C
 6166 2C1A ~                JP   NZ,__x80_memcpy_loop
 6167 2C1A ~                RET
 6168 2C1A                  ENDIF
