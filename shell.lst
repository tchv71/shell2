 4029 2ABB ~            ; an unsigned int's worth; a subtraction for FFFFh, one that holds a negative int's.
 4030 2ABB ~            .cross:
 4031 2ABB ~                LD   A,H
 4032 2ABB ~                OR   L
 4033 2ABB ~                RET  Z
 4034 2ABB ~                LD   A,H
 4035 2ABB ~                AND  L
 4036 2ABB ~                INC  A
 4037 2ABB ~                JP   Z,.minus
