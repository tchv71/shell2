 3519 2ABC              ; ---------------------------------------------------------------------------
 3520 2ABC              ; Sixty-four bits: [HL] = [HL] op [DE], or [HL] shifted by the count in DE.
 3521 2ABC              ;
 3522 2ABC              ; The operands are eight bytes each, which no set of registers on this machine can hold, so these
 3523 2ABC              ; take them by address -- the legaliser writes them into the caller's frame -- and work on copies
 3524 2ABC              ; in static memory, a byte at a time. Simple and slow: the point for now is that long long works.
 3525 2ABC              ; Multiplication is shift-and-add over sixty-four bits, division a restoring loop, sixty-four
 3526 2ABC              ; times.
 3527 2ABC              ; ---------------------------------------------------------------------------
 3528 2ABC                  IFUSED __x80_qmul
 3529 2ABC ~            __x80_qmul:
 3530 2ABC ~                CALL __x80_q_take2
 3531 2ABC ~                LD   HL,__x80_qr
 3532 2ABC ~                CALL __x80_q_zero
 3533 2ABC ~                LD   A,64
 3534 2ABC ~                LD   (__x80_qn),A
 3535 2ABC ~            .loop:
 3536 2ABC ~                LD   HL,__x80_qb+7      ; the multiplier's low bit out
 3537 2ABC ~                CALL __x80_q_shr
 3538 2ABC ~                JP   NC,.skip
 3539 2ABC ~                LD   HL,__x80_qr        ; and the multiplicand added where it was set
 3540 2ABC ~                LD   DE,__x80_qa
 3541 2ABC ~                CALL __x80_q_add
 3542 2ABC ~            .skip:
 3543 2ABC ~                LD   HL,__x80_qa
 3544 2ABC ~                CALL __x80_q_shl
 3545 2ABC ~                LD   A,(__x80_qn)
 3546 2ABC ~                DEC  A
 3547 2ABC ~                LD   (__x80_qn),A
 3548 2ABC ~                JP   NZ,.loop
 3549 2ABC ~                LD   HL,__x80_qr
 3550 2ABC ~                JP   __x80_q_give
 3551 2ABC                  ENDIF
