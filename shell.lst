 2044 2ABB ~                LD   A,(__x80_fpb+2)
 2045 2ABB ~                CALL __x80_mul8w        ; b2 * a1a0: bytes 4 to 2
 2046 2ABB ~                ADD  HL,DE
 2047 2ABB ~                EX   DE,HL              ; bytes 3 and 2, all of them; EX and LD leave the carry
 2048 2ABB ~                LD   L,A
 2049 2ABB ~                LD   A,(__x80_fpp+4)
 2050 2ABB ~                ADC  A,L
 2051 2ABB ~                LD   L,A                ; byte 4
 2052 2ABB ~                LD   A,0
 2053 2ABB ~                ADC  A,A
 2054 2ABB ~                LD   H,A                ; byte 5 so far
 2055 2ABB ~            .top_bytes:
 2056 2ABB ~                PUSH HL
 2057 2ABB ~                LD   A,(__x80_fpb+2)
 2058 2ABB ~                LD   C,A
 2059 2ABB ~                LD   B,0
 2060 2ABB ~                LD   A,(__x80_fpa+2)
 2061 2ABB ~                CALL __x80_mul8w        ; a2 * b2: bytes 5 and 4, A zero
 2062 2ABB ~                POP  BC
 2063 2ABB ~                ADD  HL,BC              ; bytes 5 and 4
 2064 2ABB ~                EX   DE,HL              ; DEHL: bytes 5 to 2
 2065 2ABB ~                POP  BC
 2066 2ABB ~                XOR  A
 2067 2ABB ~                OR   D
 2068 2ABB ~                JP   M,.top
 2069 2ABB ~                DEC  BC                 ; the leading one at bit 46: one place up
 2070 2ABB ~                ADD  HL,HL
 2071 2ABB ~                LD   A,E
 2072 2ABB ~                RLA
 2073 2ABB ~                LD   E,A
 2074 2ABB ~                LD   A,D
 2075 2ABB ~                RLA
 2076 2ABB ~                LD   D,A
 2077 2ABB ~                LD   A,(__x80_fpp+1)
