 5567 2BEC ~                ADC  A,A
 5568 2BEC ~                ADD  HL,HL
 5569 2BEC ~                ADD  HL,DE
 5570 2BEC ~                JP   NC,.a1
 5571 2BEC ~            .s1:
 5572 2BEC ~                ADC  A,A
 5573 2BEC ~                ADD  HL,HL
 5574 2BEC ~                ADD  HL,DE
