 3613 2ABB ~                DEC  B
 3614 2ABB ~                JP   NZ,.move
 3615 2ABB ~                XOR  A
 3616 2ABB ~                LD   (DE),A             ; a zero at the bottom
 3617 2ABB ~                POP  AF
 3618 2ABB ~                JP   .bytes
 3619 2ABB ~            .bits:
 3620 2ABB ~                OR   A
 3621 2ABB ~                JP   Z,__x80_q_give_a
 3622 2ABB ~            .loop:
 3623 2ABB ~                PUSH AF
 3624 2ABB ~                LD   HL,__x80_qa
 3625 2ABB ~                CALL __x80_q_shl
 3626 2ABB ~                POP  AF
 3627 2ABB ~                DEC  A
 3628 2ABB ~                JP   NZ,.loop
 3629 2ABB ~                JP   __x80_q_give_a
